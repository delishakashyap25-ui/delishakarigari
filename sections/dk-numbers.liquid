      "default": 5000
    },
    {
      "type": "text",
      "id": "stat_3_suffix",
      "label": "Stat 3 Suffix",
      "default": "+"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "Pieces Made With Care"
    },
    {
      "type": "header",
      "content": "Stat 4"
    },
    {
      "type": "number",
      "id": "stat_4_num",
      "label": "Stat 4 Number",
      "default": 100
    },
    {
      "type": "text",
      "id": "stat_4_suffix",
      "label": "Stat 4 Suffix",
      "default": "%"
    },
    {
      "type": "text",
      "id": "stat_4_label",
      "label": "Stat 4 Label",
      "default": "Made For Meaningful Moments"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
