<div class="password-main" style="width: 100%; max-width: 600px; margin: 40px auto; padding: 40px 24px; text-align: center; background: #ffffff; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.06); border: 1px solid #EAE0D5;">
  
  <!-- LOGO -->
  <div class="password-logo" style="margin-bottom: 24px;">
    <a href="{{ routes.root_url }}">
      <img
        src="{{ 'dk-logo.png' | asset_url }}"
        alt="{{ shop.name | default: 'DELISHA KARIGARI' | escape }}"
        style="max-width: 220px; height: auto;"
        width="220"
        height="60"
        loading="eager"
      >
    </a>
  </div>

  <!-- HEADLINE -->
  <h1 class="password-title" style="font-family: var(--font-heading, 'Playfair Display', serif); font-size: 32px; color: #6E1F2A; margin: 0 0 12px 0;">
    {{ section.settings.heading | default: "We're Launching Soon" }}
  </h1>
  
  <p class="password-subtitle" style="font-family: var(--font-body, 'Poppins', sans-serif); font-size: 15px; color: #555555; line-height: 1.6; margin-bottom: 30px;">
    {{ section.settings.subtext | default: "Delisha Karigari brings you exquisite handcrafted Rakhis, Lumbas, and festive keepsakes. Stay tuned for our grand opening!" }}
  </p>

  <!-- PASSWORD LOGIN FORM -->
  <div class="password-form-wrapper" style="margin-bottom: 30px; padding: 20px; background: #F9F5EE; border-radius: 8px;">
    <p style="font-size: 14px; font-weight: 600; color: #111111; margin-bottom: 12px;">Store Access</p>
    {% form 'storefront_password', class: 'password-login-form' %}
      {% if form.errors %}
        <div style="color: #b91c1c; font-size: 13px; margin-bottom: 10px;">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
      <div style="display: flex; gap: 8px; max-width: 380px; margin: 0 auto;">
        <input
          type="password"
          name="password"
          id="password"
          placeholder="Enter store password"
          autocomplete="current-password"
          style="flex: 1; padding: 12px 14px; border: 1px solid #D5C7B8; border-radius: 6px; font-size: 14px;"
          required
        >
        <button
          type="submit"
          style="padding: 12px 20px; background: #6E1F2A; color: #ffffff; border: none; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer;"
        >
          Enter
        </button>
      </div>
    {% endform %}
  </div>

  <!-- OWNER ADMIN LINK -->
  <div class="password-admin-link" style="font-size: 13px; color: #777777;">
    Are you the store owner? <a href="/admin" style="color: #6E1F2A; font-weight: 600; text-decoration: underline;">Log in here</a>
  </div>
</div>

{% schema %}
{
  "name": "Password Main",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We're Launching Soon"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Delisha Karigari brings you exquisite handcrafted Rakhis, Lumbas, and festive keepsakes. Stay tuned for our grand opening!"
    }
  ]
}
{% endschema %}
