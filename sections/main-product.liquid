    max-width: 100%;
    position: static;
  }
}
</style>

<script>
/* ==========================================================================
   DYNAMIC CURSOR ZOOM ON PRODUCT GALLERY (TIFFANY & CO. STANDARD)
   ========================================================================== */
function initProductImageZoom() {
  const wrap = document.getElementById('MainImageWrap');
  const img = document.getElementById('MainProductImage');
  if (!wrap || !img) return;

  // Mousemove dynamic zoom
  wrap.addEventListener('mousemove', function(e) {
    const rect = wrap.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;

    img.style.transformOrigin = `${x}% ${y}%`;
    img.style.transform = 'scale(2.35)';
    wrap.classList.add('is-zoomed');
  });

  // Mouseleave smooth reset
  wrap.addEventListener('mouseleave', function() {
    img.style.transform = 'scale(1)';
    img.style.transformOrigin = 'center center';
    wrap.classList.remove('is-zoomed');
  });

  // Touch move for mobile
  wrap.addEventListener('touchmove', function(e) {
    if (e.touches && e.touches[0]) {
      const touch = e.touches[0];
      const rect = wrap.getBoundingClientRect();
      const x = ((touch.clientX - rect.left) / rect.width) * 100;
      const y = ((touch.clientY - rect.top) / rect.height) * 100;
      img.style.transformOrigin = `${x}% ${y}%`;
      img.style.transform = 'scale(2.2)';
      wrap.classList.add('is-zoomed');
    }
  }, { passive: true });

  wrap.addEventListener('touchend', function() {
    img.style.transform = 'scale(1)';
    img.style.transformOrigin = 'center center';
    wrap.classList.remove('is-zoomed');
  });
}

function updateProductImage(el, url) {
  const img = document.getElementById('MainProductImage');
  if (!img) return;
  img.src = url;
  img.style.transform = 'scale(1)';
  img.style.transformOrigin = 'center center';

  document.querySelectorAll('.prod-thumb-item').forEach(item => item.classList.remove('active'));
  el.classList.add('active');
}

function updateVariantLabel(input) {
  const val = input.value;
  const parent = input.closest('.variant-group');
  if (parent) {
    const label = parent.querySelector('.selected-val');
    if (label) label.innerText = val;
  }
}

function changeQty(amt) {
  const input = document.getElementById('Quantity');
  if (!input) return;
  let val = parseInt(input.value) + amt;
  if (val < 1) val = 1;
  input.value = val;
}

function toggleAccordion(el) {
  const wrapper = el.closest('.info-box-wrapper');
  const content = el.nextElementSibling;
  const icon = el.querySelector('.acc-icon');
  if (!content) return;

  const isHidden = (content.style.display === 'none' || !content.style.display);
  if (isHidden) {
    content.style.display = 'block';
    if (icon) icon.innerHTML = '&minus;';
    if (wrapper) wrapper.classList.add('is-open');
  } else {
    content.style.display = 'none';
    if (icon) icon.innerHTML = '&plus;';
    if (wrapper) wrapper.classList.remove('is-open');
  }
}

document.addEventListener('DOMContentLoaded', function() {
  initProductImageZoom();
});

// Re-init on Shopify theme section events
document.addEventListener('shopify:section:load', function() {
  initProductImageZoom();
});
</script>

