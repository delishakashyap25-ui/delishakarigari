<footer class="delisha-footer">

  <!-- Subtle Heritage Background -->
  <div class="delisha-footer-pattern" aria-hidden="true">
    <span>✦</span>
    <span>◇</span>
    <span>✦</span>
    <span>◇</span>
    <span>✦</span>
    <span>◇</span>
    <span>✦</span>
    <span>◇</span>
  </div>

  <div class="delisha-footer-container">

    <div class="delisha-footer-main">

      <!-- BRAND -->
      <div class="delisha-footer-brand">

        <div class="delisha-footer-logo">
          <a href="{{ routes.root_url }}">
            <img
              src="{{ 'dk-logo.png' | asset_url }}"
              alt="DELISHA KARIGARI"
              style="max-width: 200px; height: auto;"
              loading="lazy"
              width="200"
              height="60"
            >
          </a>
        </div>

        <p class="delisha-footer-tagline">
          Handmade Celebrations. Thoughtful Gifting. Beautifully Yours.
        </p>

        <p class="delisha-footer-description">
          Delisha Karigari is a handmade and personalised gifting brand built around the simple idea that every celebration deserves something made with love.
        </p>

        <!-- NEWSLETTER -->
        <div class="delisha-newsletter">

          <p class="delisha-newsletter-title">
            Stay connected with Delisha Karigari
          </p>

          {% form 'customer', class: 'delisha-newsletter-form' %}

          <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >

          <div class="delisha-newsletter-input">

            <input
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="Enter your email"
                autocomplete="email"
                required
              >

            <button
                type="submit"
                aria-label="Subscribe"
              >
                →
              </button>

          </div>

          {% if form.posted_successfully? %}
          <p class="delisha-newsletter-success">
            Thank you for joining us.
          </p>
          {% endif %}

          {% endform %}        <!-- SOCIAL ICONS: INSTAGRAM, MAIL, FACEBOOK -->
        <div class="delisha-social">

          <!-- INSTAGRAM -->
          <a href="{{ section.settings.social_instagram_link | default: 'https://www.instagram.com/delishakarigari/' }}" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Instagram" class="delisha-social-icon" title="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>

          <!-- MAIL -->
          <a href="mailto:delishakarigari@gmail.com" aria-label="Email us" class="delisha-social-icon" title="Mail">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </a>

          <!-- FACEBOOK -->
          <a href="{{ section.settings.social_facebook_link | default: 'https://www.facebook.com/profile.php?id=61578229348792' }}" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Facebook" class="delisha-social-icon" title="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>

        </div>

      </div>


      <!-- SHOP -->
      <div class="delisha-footer-column">

        <h3>SHOP</h3>

        <a href="{{ routes.all_products_collection_url }}">
          All Collections
        </a>

        <a href="{{ routes.collections_url }}/navratri-decor">
          The Navratri Edit
        </a>

        <a href="{{ routes.collections_url }}/karwa-chauth-special">
          Karwa Chauth Specials
