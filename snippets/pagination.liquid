{%- comment -%}
Custom Surgical Pagination Snippet
Usage: {% render 'pagination', paginate: paginate %}
{%- endcomment -%}

{%- if paginate.pages > 1 -%}
<style>
  .pagination-wrapper,
  div.pagination-wrapper,
  .elinor-pagination-nav {
    margin-top: 50px !important;
    margin-bottom: 30px !important;
    text-align: center !important;
    border-top: 1px solid #eee !important;
    padding-top: 30px !important;
    width: 100% !important;
    clear: both !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
  }

  .pagination-wrapper .pagination,
  .pagination-wrapper ul,
  ul.pagination,
  .elinor-pagination-list,
  .elinor-pagination-flex {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    flex-wrap: wrap !important;
    gap: 8px !important;
    list-style: none !important;
    list-style-type: none !important;
    padding: 0 !important;
    margin: 0 auto !important;
  }

  .pagination-wrapper .pagination li,
  .pagination-wrapper ul li,
  ul.pagination li,
  .elinor-pagination-item {
    list-style: none !important;
    list-style-type: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 !important;
    padding: 0 !important;
    float: none !important;
  }

  .pagination-wrapper .pagination li::before,
  .pagination-wrapper .pagination li::after,
  .pagination-wrapper ul li::before,
  .pagination-wrapper ul li::after,
  ul.pagination li::before,
  ul.pagination li::after,
  .elinor-pagination-item::before,
  .elinor-pagination-item::after {
    content: "" !important;
    display: none !important;
  }

  .pagination-wrapper a,
  .pagination-wrapper span,
  .pagination-wrapper li a,
  .pagination-wrapper li span,
  ul.pagination li a,
  ul.pagination li span,
  .elinor-pagination-link {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-width: 38px !important;
    height: 38px !important;
    padding: 0 10px !important;
    border-radius: 4px !important;
    font-family: var(--font-body, 'Poppins', sans-serif) !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    text-decoration: none !important;
    color: #333333 !important;
    background-color: #ffffff !important;
    border: 1px solid #e0e0e0 !important;
    transition: all 0.2s ease !important;
    box-sizing: border-box !important;
  }

  .pagination-wrapper a:hover,
  .pagination-wrapper li a:hover,
  ul.pagination li a:hover,
  .elinor-pagination-link:hover {
    background-color: #f5f5f5 !important;
    color: #111111 !important;
    border-color: #cccccc !important;
  }

  .pagination-wrapper .current,
  .pagination-wrapper span.current,
  .pagination-wrapper li.current span,
  .pagination-wrapper li.current a,
  ul.pagination li.current a,
  ul.pagination li.current span,
  .elinor-pagination-link.is-active {
    background-color: #333333 !important;
    color: #ffffff !important;
    border-color: #333333 !important;
    font-weight: 600 !important;
  }

  .pagination-wrapper .prev a,
  .pagination-wrapper .next a,
  .pagination-wrapper li.prev a,
  .pagination-wrapper li.next a,
  ul.pagination li.prev a,
  ul.pagination li.next a {
    padding: 0 12px !important;
  }
</style>

<div class="pagination-wrapper style-numbers">
  <ul class="pagination" role="list">
    {%- if paginate.previous -%}
    <li class="prev">
      <a href="{{ paginate.previous.url }}" aria-label="Previous page">‹</a>
    </li>
    {%- endif -%}

    {%- for part in paginate.parts -%}
    {%- if part.is_link -%}
    <li>
      <a href="{{ part.url }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>
    </li>
    {%- else -%}
    {%- if part.title == paginate.current_page -%}
    <li class="current">
      <span class="current" aria-current="page">{{ part.title }}</span>
    </li>
    {%- else -%}
    <li class="deco">
      <span>{{ part.title }}</span>
    </li>
    {%- endif -%}
    {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
    <li class="next">
      <a href="{{ paginate.next.url }}" aria-label="Next page">»</a>
    </li>
    {%- endif -%}
  </ul>
</div>
{%- endif -%}