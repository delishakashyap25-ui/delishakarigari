<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#6E1F2A">
  <link rel="icon" type="image/png" href="{{ 'dk-favicon.png' | asset_url }}">
  <link rel="canonical" href="{{ canonical_url }}">

  <title>{{ shop.name }} &ndash; Opening Soon</title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {{ content_for_header }}

  {% # theme-check-disable RemoteAsset %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
  {% # theme-check-enable RemoteAsset %}

  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>

<body class="password-template" style="background-color: #F9F5EE; color: #111111; min-height: 100vh; display: flex; flex-direction: column;">
  <main role="main" id="MainContent" style="flex: 1; display: flex; align-items: center; justify-content: center; width: 100%;">
    {{ content_for_layout }}
  </main>
</body>
</html>
