<section
  id="dk-trust-{{ section.id }}"
  class="dk-trust-sec"
  style="background-color: {{ section.settings.bg_color | default: '#F9F5EE' }}; padding: {{ section.settings.padding_top | default: 50 }}px 0 {{ section.settings.padding_bottom | default: 50 }}px 0;"
>
  <div class="container">
    <div class="dk-trust-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="dk-trust-item" {{ block.shopify_attributes }}>
            <div class="dk-trust-icon-wrap">
              {%- if block.settings.icon_svg != blank -%}
                {{ block.settings.icon_svg }}
              {%- else -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              {%- endif -%}
            </div>
            <div class="dk-trust-text-wrap">
              <h4 class="dk-trust-title">{{ block.settings.title | escape }}</h4>
              {%- if block.settings.text != blank -%}
                <p class="dk-trust-sub">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- FALLBACK DEFAULT TRUST POINTS -->
        <div class="dk-trust-item">
          <div class="dk-trust-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <div class="dk-trust-text-wrap">
            <h4 class="dk-trust-title">Handcrafted with Care</h4>
            <p class="dk-trust-sub">Artisanal Indian precision</p>
          </div>
        </div>

        <div class="dk-trust-item">
          <div class="dk-trust-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          </div>
          <div class="dk-trust-text-wrap">
            <h4 class="dk-trust-title">Premium Finish</h4>
            <p class="dk-trust-sub">Highest quality materials</p>
          </div>
        </div>

        <div class="dk-trust-item">
          <div class="dk-trust-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6"></path><path d="M18 12V7a5 5 0 0 0-10 0v5"></path></svg>
          </div>
          <div class="dk-trust-text-wrap">
            <h4 class="dk-trust-title">Made for Gifting</h4>
            <p class="dk-trust-sub">Luxury gift packaging ready</p>
          </div>
        </div>

        <div class="dk-trust-item">
          <div class="dk-trust-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          </div>
          <div class="dk-trust-text-wrap">
            <h4 class="dk-trust-title">Pan-India Delivery</h4>
            <p class="dk-trust-sub">Safe & fast dispatch</p>
          </div>
        </div>

        <div class="dk-trust-item">
          <div class="dk-trust-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          </div>
          <div class="dk-trust-text-wrap">
            <h4 class="dk-trust-title">Secure Checkout</h4>
            <p class="dk-trust-sub">100% protected payments</p>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .dk-trust-sec {
    border-top: 1px solid var(--dk-color-border, rgba(110,31,42,0.1));
    border-bottom: 1px solid var(--dk-color-border, rgba(110,31,42,0.1));
  }
  .dk-trust-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--dk-space-md, 1rem);
    align-items: center;
  }
  .dk-trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
  }
  .dk-trust-icon-wrap {
    color: var(--dk-color-primary, #6E1F2A);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dk-trust-title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--dk-color-text, #252525);
    margin: 0;
    line-height: 1.2;
  }
  .dk-trust-sub {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.725rem;
    color: rgba(37,37,37,0.7);
    margin: 2px 0 0 0;
  }

  @media (max-width: 1024px) {
    .dk-trust-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--dk-space-md, 1rem);
    }
  }

  @media (max-width: 600px) {
    .dk-trust-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--dk-space-sm, 0.5rem);
    }
  }
</style>

{% schema %}
{
  "name": "DELISHA Trust Points",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F5EE"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Handcrafted with Care"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Subtitle",
          "default": "Artisanal Indian precision"
        },
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "Custom SVG Icon HTML"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DELISHA Trust Points",
      "blocks": [
        { "type": "trust_item", "settings": { "title": "Handcrafted with Care", "text": "Artisanal Indian precision" } },
        { "type": "trust_item", "settings": { "title": "Premium Finish", "text": "Highest quality materials" } },
        { "type": "trust_item", "settings": { "title": "Made for Gifting", "text": "Luxury gift packaging ready" } },
        { "type": "trust_item", "settings": { "title": "Pan-India Delivery", "text": "Safe & fast dispatch" } },
        { "type": "trust_item", "settings": { "title": "Secure Checkout", "text": "100% protected payments" } }
      ]
    }
  ]
}
{% endschema %}
