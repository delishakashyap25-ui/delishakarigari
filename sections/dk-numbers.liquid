{%- liquid
  assign eyebrow = section.settings.eyebrow | default: '✦ OUR HANDCRAFTED JOURNEY ✦'
  assign heading = section.settings.heading | default: 'Little Things We’ve Made.<br> <em>Big Moments We’ve Been Part Of.</em>'
  assign subheading = section.settings.subheading | default: 'Every piece is handmade with devotion in our Delhi workshop, adding artisanal warmth to festive homes across India.'
  assign stat_1_val = section.settings.stat_1_num | default: 10
  if stat_1_val == 1000
    assign stat_1_val = 10
  endif
  assign stat_1_suf = section.settings.stat_1_suffix | default: 'k+'
  if stat_1_suf == '+'
    assign stat_1_suf = 'k+'
  endif
-%}

<section
  id="dk-numbers-{{ section.id }}"
  class="dk-numbers-sec"
  style="background-color: {{ section.settings.bg_color | default: '#F9F5EE' }}; padding-top: {{ section.settings.padding_top | default: 60 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 65 }}px;"
>
  <div class="dk-numbers-container">
    
    <!-- SECTION HEADER -->
    <div class="dk-numbers-header">
      {%- if eyebrow != blank -%}
        <span class="dk-numbers-eyebrow">{{ eyebrow }}</span>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2 class="dk-numbers-title">{{ heading }}</h2>
      {%- endif -%}

      {%- if subheading != blank -%}
        <p class="dk-numbers-subtitle">{{ subheading }}</p>
      {%- endif -%}
    </div>

    <!-- 4 CIRCULAR STAT MODULES -->
    <div class="dk-numbers-grid" id="dkNumbersGrid-{{ section.id }}">
      
      <!-- ITEM 1 -->
      <div class="dk-number-card">
        <div class="dk-number-circle">
          <div class="dk-number-circle__inner">
            <span
              class="dk-number-value"
              data-target="{{ stat_1_val }}"
              data-suffix="{{ stat_1_suf }}"
            >{{ stat_1_val }}{{ stat_1_suf }}</span>
          </div>
        </div>
        <h3 class="dk-number-label">{{ section.settings.stat_1_label | default: 'Celebrations Gifted' }}</h3>
      </div>

      <!-- ITEM 2 -->
      <div class="dk-number-card">
        <div class="dk-number-circle">
          <div class="dk-number-circle__inner">
            <span
              class="dk-number-value"
              data-target="{{ section.settings.stat_2_num | default: 200 }}"
              data-suffix="{{ section.settings.stat_2_suffix | default: '+' }}"
            >0{{ section.settings.stat_2_suffix | default: '+' }}</span>
          </div>
        </div>
        <h3 class="dk-number-label">{{ section.settings.stat_2_label | default: 'Handcrafted Designs' }}</h3>
      </div>

      <!-- ITEM 3 -->
      <div class="dk-number-card">
        <div class="dk-number-circle">
          <div class="dk-number-circle__inner">
            <span
              class="dk-number-value"
              data-target="{{ section.settings.stat_3_num | default: 5000 }}"
              data-suffix="{{ section.settings.stat_3_suffix | default: '+' }}"
            >0{{ section.settings.stat_3_suffix | default: '+' }}</span>
          </div>
        </div>
        <h3 class="dk-number-label">{{ section.settings.stat_3_label | default: 'Pieces Made With Care' }}</h3>
      </div>

      <!-- ITEM 4 -->
      <div class="dk-number-card">
        <div class="dk-number-circle">
          <div class="dk-number-circle__inner">
            <span
              class="dk-number-value"
              data-target="{{ section.settings.stat_4_num | default: 100 }}"
              data-suffix="{{ section.settings.stat_4_suffix | default: '%' }}"
            >0{{ section.settings.stat_4_suffix | default: '%' }}</span>
          </div>
        </div>
        <h3 class="dk-number-label">{{ section.settings.stat_4_label | default: 'Made For Meaningful Moments' }}</h3>
      </div>

    </div>

  </div>
</section>

<style>
  .dk-numbers-sec {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-top: 1px solid #ECE4D8;
    border-bottom: 1px solid #ECE4D8;
  }
  .dk-numbers-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3.2vw, 36px);
    box-sizing: border-box;
  }
  .dk-numbers-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto clamp(36px, 4vw, 54px);
  }
  .dk-numbers-eyebrow {
    display: inline-block;
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    color: #8C2234;
    margin-bottom: 0.75rem;
  }
  .dk-numbers-title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    font-weight: 600;
    line-height: 1.22;
    color: #211216;
    margin: 0 0 0.85rem;
    letter-spacing: -0.3px;
  }
  .dk-numbers-title em {
    font-style: italic;
    font-weight: 400;
    color: #641A28;
  }
  .dk-numbers-subtitle {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.92rem;
    line-height: 1.6;
    color: #6A5B55;
    margin: 0 auto;
    max-width: 580px;
  }

  /* 4 CIRCULAR STAT MODULES */
  .dk-numbers-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 3vw, 36px);
    align-items: start;
    justify-items: center;
  }
  .dk-number-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 250px;
    transition: transform 0.3s ease;
  }
  .dk-number-card:hover {
    transform: translateY(-4px);
  }
  .dk-number-circle {
    position: relative;
    width: clamp(140px, 13vw, 175px);
    height: clamp(140px, 13vw, 175px);
    border-radius: 50%;
    background: #FFFFFF;
    border: 1.5px solid #E6D8CA;
    box-shadow: 0 8px 24px rgba(100, 26, 40, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.15rem;
    padding: 6px;
    box-sizing: border-box;
    transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  .dk-number-circle::before {
    content: '';
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    border: 1px dashed rgba(184, 154, 98, 0.4);
    pointer-events: none;
    transition: border-color 0.3s ease;
  }
  .dk-number-card:hover .dk-number-circle {
    border-color: #641A28;
    box-shadow: 0 12px 30px rgba(100, 26, 40, 0.12);
  }
  .dk-number-card:hover .dk-number-circle::before {
    border-color: rgba(184, 154, 98, 0.85);
  }
  .dk-number-circle__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .dk-number-value {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(1.85rem, 2.5vw, 2.5rem);
    font-weight: 700;
    color: #641A28;
    line-height: 1;
    letter-spacing: -0.5px;
    display: inline-block;
  }
  .dk-number-label {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: clamp(0.78rem, 0.9vw, 0.86rem);
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #382A25;
    margin: 0;
    line-height: 1.4;
    max-width: 200px;
  }

  @media (max-width: 991px) {
    .dk-numbers-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 20px;
    }
    .dk-number-circle {
      width: 150px;
      height: 150px;
    }
  }

  @media (max-width: 576px) {
    .dk-numbers-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 26px 14px;
    }
    .dk-number-circle {
      width: 130px;
      height: 130px;
      margin-bottom: 0.85rem;
    }
    .dk-number-value {
      font-size: 1.65rem;
    }
    .dk-number-label {
      font-size: 0.72rem;
      letter-spacing: 0.8px;
    }
  }
</style>

<script>
  (function() {
    const grid = document.getElementById('dkNumbersGrid-{{ section.id }}');
    if (!grid) return;

    let animated = false;

    function animateCounters() {
      if (animated) return;
      animated = true;

      const counters = grid.querySelectorAll('.dk-number-value');
      counters.forEach(counter => {
        const target = parseInt(counter.getAttribute('data-target'), 10) || 0;
        const suffix = counter.getAttribute('data-suffix') || '';
        const duration = 1800; // ms
        const startTime = performance.now();

        function update(currentTime) {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          // Ease out cubic
          const easeProgress = 1 - Math.pow(1 - progress, 3);
          const currentVal = Math.floor(easeProgress * target);

          counter.textContent = currentVal.toLocaleString('en-IN') + suffix;

          if (progress < 1) {
            requestAnimationFrame(update);
          } else {
            counter.textContent = target.toLocaleString('en-IN') + suffix;
          }
        }

        requestAnimationFrame(update);
      });
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            animateCounters();
            observer.disconnect();
          }
        });
      }, { threshold: 0.25 });

      observer.observe(grid);
    } else {
      animateCounters();
    }
  })();
</script>

