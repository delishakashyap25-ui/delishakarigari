    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Handcrafted Designs"
    },
    {
      "type": "header",
      "content": "Stat 3"
    },
    {
      "type": "number",
      "id": "stat_3_num",
