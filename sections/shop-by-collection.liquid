<section class="shop-by-collection-section"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color | default: '#ffffff' }};">
  <div class="sbc-container">

    <!-- HEADER -->
    <div class="sbc-header">
      <div class="sbc-header-left">
        {%- if section.settings.subheading != blank -%}
        <span class="sbc-subheading">— {{ section.settings.subheading }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
        <h2 class="sbc-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.show_view_all -%}
      <div class="sbc-header-right desktop-only">
        <a href="{{ section.settings.view_all_link | default: routes.collections_url | default: '/collections' }}"
          class="sbc-view-all">
          {{ section.settings.view_all_text | default: 'View All Collections' }}
        </a>
      </div>
      {%- endif -%}
    </div>

    <!-- BENTO GRID -->
    <div class="sbc-grid">
      {%- for block in section.blocks -%}
      {%- assign collection = collections[block.settings.collection] -%}
      {%- assign card_url = block.settings.custom_link | default: collection.url | default: '#' -%}
      {%- assign card_title = block.settings.title | default: collection.title | default: 'Collection' -%}

      <a href="{{ card_url }}" class="sbc-card sbc-card--{{ forloop.index }}" {{ block.shopify_attributes }}>
        <div class="sbc-image-wrapper">
          {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ card_title | escape }}" loading="lazy" class="sbc-img" width="1200" height="800">
            {%- elsif collection.image != blank -%}
          <img src="{{ collection.image | image_url: width: 1200 }}" alt="{{ card_title | escape }}" loading="lazy" class="sbc-img" width="1200" height="800">
            {%- else -%}
              {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg sbc-img' }}
            {%- endif -%}

          <div class="sbc-overlay"></div>
        </div>

        <div class="sbc-card-content">
          <h3 class="sbc-card-title">{{ card_title }}</h3>
          <span class="sbc-arrow" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
        </div>
      </a>
      {%- endfor -%}
    </div>

    <!-- BOTTOM VIEW ALL LINK (MOBILE ONLY) -->
    {%- if section.settings.show_view_all -%}
    <div class="sbc-footer mobile-only">
      <a href="{{ section.settings.view_all_link | default: routes.collections_url | default: '/collections' }}"
        class="sbc-view-all">
        {{ section.settings.view_all_text | default: 'View All Collections' }}
      </a>
    </div>
    {%- endif -%}

  </div>
</section>

<style>
  .shop-by-collection-section {
    width: 100%;
    box-sizing: border-box;
  }

  .sbc-container {
    max-width: 1400px;
    width: 92%;
    margin: 0 auto;
  }

  /* HEADER */
  .sbc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 30px;
  }

  .sbc-subheading {
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: #7a4b53;
    letter-spacing: 2px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 8px;
  }

  .sbc-title {
    font-family: 'Playfair Display', serif;
    font-size: 40px;
    font-weight: 500;
    color: #111111;
    margin: 0;
    line-height: 1.1;
  }

  .sbc-view-all {
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    color: #333333;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease;
    font-weight: 500;
  }

  .sbc-view-all:hover {
    color: #000000;
  }

  .mobile-only {
    display: none;
  }

  .desktop-only {
    display: block;
  }

  /* DESKTOP BENTO GRID LAYOUT (min-width: 769px) */
  @media (min-width: 769px) {
    .sbc-grid {
      display: grid;
      grid-template-columns: 2.2fr 1fr 1fr;
      grid-template-rows: repeat(2, 220px);
      gap: 16px;
    }

    .sbc-card {
      position: relative;
      overflow: hidden;
      border-radius: 4px;
      text-decoration: none;
      display: block;
      background-color: #f5f5f5;
    }

    /* Original Desktop Bento Layout Mapping */
    .sbc-card:nth-child(1) {
      grid-column: 1 / 2;
      grid-row: 1 / 3;
      height: 100%;
    }

    .sbc-card:nth-child(2) {
      grid-column: 2 / 3;
      grid-row: 1 / 2;
      height: 100%;
    }

    .sbc-card:nth-child(3) {
      grid-column: 2 / 3;
      grid-row: 2 / 3;
      height: 100%;
    }

    .sbc-card:nth-child(4) {
      grid-column: 3 / 4;
      grid-row: 1 / 2;
      height: 100%;
    }

    .sbc-card:nth-child(5) {
      grid-column: 3 / 4;
      grid-row: 2 / 3;
      height: 100%;
    }

    .sbc-card-title {
      font-size: 24px;
    }

    .sbc-card:nth-child(1) .sbc-card-title {
      font-size: 28px;
    }
  }

  /* COMMON IMAGE & HOVER STYLES */
  .sbc-image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .sbc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .sbc-card:hover .sbc-img {
    transform: scale(1.05);
  }

  .sbc-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0.1) 45%, transparent 100%);
    z-index: 2;
    pointer-events: none;
  }

  .sbc-card-content {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }

  .sbc-card-title {
    font-family: 'Playfair Display', serif;
    font-weight: 500;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .sbc-arrow {
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .sbc-card:hover .sbc-arrow {
    transform: translateX(4px);
  }

  /* MOBILE LAYOUT (max-width: 768px) */
  @media (max-width: 768px) {
    .desktop-only {
      display: none !important;
    }

    .mobile-only {
      display: block !important;
    }

    .sbc-header {
      margin-bottom: 20px;
    }

    .sbc-title {
      font-size: 28px;
    }

    .sbc-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .sbc-card {
      position: relative;
      overflow: hidden;
      border-radius: 4px;
      text-decoration: none;
      display: block;
      background-color: #f5f5f5;
    }

    /* Card 1 spans full width on mobile */
    .sbc-card:nth-child(1) {
      grid-column: 1 / -1;
      height: 200px;
    }

    /* Cards 2-5 span 1 column each on mobile */
    .sbc-card:nth-child(n+2) {
      grid-column: span 1;
      height: 140px;
    }

    .sbc-card-content {
      bottom: 14px;
      left: 14px;
      right: 14px;
    }

    .sbc-card-title {
      font-size: 16px;
    }

    .sbc-card:nth-child(1) .sbc-card-title {
      font-size: 20px;
    }

    .sbc-arrow svg {
      width: 16px;
      height: 16px;
    }

    .sbc-footer {
      text-align: center;
      margin-top: 20px;
    }
  }

  @media (max-width: 480px) {
    .sbc-card:nth-child(1) {
      height: 180px;
    }

    .sbc-card:nth-child(n+2) {
      height: 125px;
    }

    .sbc-card-title {
      font-size: 14px;
    }

    .sbc-card:nth-child(1) .sbc-card-title {
      font-size: 18px;
    }
  }
</style>

{% schema %}
{
"name": "Shop by Collection",
"max_blocks": 12,
"settings": [
{
"type": "text",
"id": "subheading",
"label": "Subheading / Tagline",
"default": "CURATED FOR YOU"
},
{
"type": "text",
"id": "heading",
"label": "Heading",
"default": "Shop by Collection"
},
{
"type": "checkbox",
"id": "show_view_all",
"label": "Show View All Link",
"default": true
},
{
"type": "text",
"id": "view_all_text",
"label": "View All Text",
"default": "View All Collections"
},
{
"type": "url",
"id": "view_all_link",
"label": "View All Link"
},
{
"type": "color",
"id": "bg_color",
"label": "Background Color",
"default": "#ffffff"
},
{
"type": "range",
"id": "padding_top",
"min": 0,
"max": 100,
"step": 5,
"unit": "px",
"label": "Padding Top",
"default": 40
},
{
"type": "range",
"id": "padding_bottom",
"min": 0,
"max": 100,
"step": 5,
"unit": "px",
"label": "Padding Bottom",
"default": 40
}
],
"blocks": [
{
"type": "collection_card",
"name": "Collection Card",
"settings": [
{
"type": "collection",
"id": "collection",
"label": "Select Collection"
},
{
"type": "text",
"id": "title",
"label": "Card Custom Title",
"info": "Leave blank to use Collection Title"
},
{
"type": "image_picker",
"id": "image",
"label": "Card Custom Image",
"info": "Leave blank to use Collection Featured Image"
},
{
"type": "url",
"id": "custom_link",
"label": "Card Custom Link"
}
]
}
],
"presets": [
{
"name": "Shop by Collection",
"blocks": [
{
"type": "collection_card",
"settings": {
"title": "Stackable Pieces"
}
},
{
"type": "collection_card",
"settings": {
"title": "Office Edit"
}
},
{
"type": "collection_card",
"settings": {
"title": "Minimal Collection"
}
},
{
"type": "collection_card",
"settings": {
"title": "Trending Now"
}
},
{
"type": "collection_card",
"settings": {
"title": "Pinterest Picks"
}
}
]
}
]
}
{% endschema %}