{%- liquid
  assign eyebrow = section.settings.eyebrow | default: '✦ THE FESTIVE COLLECTION ✦'
  assign heading = section.settings.heading | default: 'A Little More Colour.<br class="dk-ne__br"> <em>A Little More Celebration.</em>'
  assign subheading = section.settings.subheading
  assign btn_text = section.settings.btn_text | default: 'EXPLORE FESTIVE COLLECTION →'
  assign btn_link = section.settings.btn_link
  if btn_link == blank
    assign btn_link = routes.all_products_collection_url
  endif
-%}

<section
  id="dk-navratri-edit-{{ section.id }}"
  class="dk-navratri-edit-sec"
  style="background-color: {{ section.settings.bg_color | default: '#F9F5EE' }}; padding-top: {{ section.settings.padding_top | default: 30 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 30 }}px;"
>
  <div class="dk-navratri-edit-wrapper {% if section.settings.full_width %}dk-navratri-edit-wrapper--full{% endif %}">
    <div class="dk-navratri-edit-card" id="navratri-edit">
      
      <!-- BACKGROUND MEDIA -->
      <div class="dk-navratri-edit__media">
        <picture class="dk-navratri-edit__picture">
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">
          {%- else -%}
            <source media="(max-width: 767px)" srcset="{{ 'dk-hero-diwali-mobile.jpg' | asset_url }}">
          {%- endif -%}

          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 2000 }}"
              alt="{{ section.settings.image.alt | default: 'Delisha Karigari Navratri Collection' | escape }}"
              class="dk-navratri-edit__img"
              loading="lazy"
              width="1920"
              height="720"
            >
          {%- else -%}
            <img
              src="{{ 'dk-hero-diwali.jpg' | asset_url }}"
              alt="The Navratri Edit — Delisha Karigari"
              class="dk-navratri-edit__img"
              loading="lazy"
              width="1920"
              height="720"
            >
          {%- endif -%}
        </picture>
        <div class="dk-navratri-edit__overlay"></div>
      </div>

      <!-- EDITORIAL CONTENT (LEFT-ALIGNED) -->
      <div class="dk-navratri-edit__content-box">
        <div class="dk-navratri-edit__content">
          {%- if eyebrow != blank -%}
            <span class="dk-navratri-edit__eyebrow">{{ eyebrow }}</span>
          {%- endif -%}

          {%- if heading != blank -%}
            <h2 class="dk-navratri-edit__title">
              {{ heading }}
            </h2>
          {%- endif -%}

          {%- if subheading != blank -%}
            <p class="dk-navratri-edit__subtitle">{{ subheading }}</p>
          {%- endif -%}

          <div class="dk-navratri-edit__actions">
            {%- if btn_text != blank and btn_link != blank -%}
              <a href="{{ btn_link }}" class="dk-navratri-edit__btn-primary">
                {{ btn_text }}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .dk-navratri-edit-sec {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .dk-navratri-edit-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3.2vw, 36px);
    box-sizing: border-box;
  }
  .dk-navratri-edit-wrapper--full {
    max-width: 100%;
    padding: 0;
  }
  .dk-navratri-edit-card {
    position: relative;
    width: 100%;
    min-height: 480px;
    height: clamp(480px, 42vw, 560px);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    box-shadow: 0 10px 32px rgba(33, 18, 22, 0.08);
  }
  .dk-navratri-edit__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .dk-navratri-edit__picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .dk-navratri-edit__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% 35%;
    display: block;
    transition: transform 6s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .dk-navratri-edit-card:hover .dk-navratri-edit__img {
    transform: scale(1.03);
  }
  .dk-navratri-edit__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: linear-gradient(
      90deg,
      rgba(24, 8, 14, 0.90) 0%,
      rgba(24, 8, 14, 0.74) 34%,
      rgba(24, 8, 14, 0.28) 58%,
      rgba(24, 8, 14, 0.0) 76%
    );
  }
  .dk-navratri-edit__content-box {
    position: relative;
    z-index: 3;
    width: 100%;
    padding: clamp(2rem, 4vw, 4rem) clamp(1.5rem, 5vw, 4.5rem);
    box-sizing: border-box;
    display: flex;
    justify-content: flex-start;
  }
  .dk-navratri-edit__content {
    max-width: 520px;
    text-align: left;
    color: #FAF6F0;
  }
  .dk-navratri-edit__eyebrow {
    display: inline-block;
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: #E9D8C5;
    margin-bottom: 0.85rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }
  .dk-navratri-edit__title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(2.1rem, 3.4vw, 3.2rem);
    font-weight: 600;
    line-height: 1.18;
    color: #FFFFFF;
    margin: 0 0 1rem;
    letter-spacing: -0.3px;
    text-shadow: 0 3px 18px rgba(0, 0, 0, 0.5);
  }
  .dk-navratri-edit__title em {
    font-style: italic;
    font-weight: 400;
    color: #F8EAD4;
  }
  .dk-ne__br {
    display: block;
  }
  .dk-navratri-edit__subtitle {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: clamp(0.92rem, 1.15vw, 1.05rem);
    line-height: 1.65;
    color: rgba(250, 246, 240, 0.95);
    margin: 0 0 1.85rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }
  .dk-navratri-edit__actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .dk-navratri-edit__btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #641A28 0%, #4A111C 100%);
    color: #FFFFFF !important;
    border: 1.5px solid #B89A62;
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    padding: 13px 32px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 2px 8px rgba(100, 26, 40, 0.5);
    transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
    position: relative;
    overflow: hidden;
  }
  .dk-navratri-edit__btn-primary:hover {
    background: linear-gradient(135deg, #7A2232 0%, #5E1624 100%);
    border-color: #D4AF37;
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5), 0 4px 14px rgba(184, 154, 98, 0.5);
  }

  @media (max-width: 768px) {
    .dk-navratri-edit-card {
      min-height: 440px;
      height: 480px;
      align-items: flex-end;
      border-radius: 8px;
    }
    .dk-navratri-edit__img {
      object-position: center 20% !important;
    }
    .dk-navratri-edit__overlay {
      background: linear-gradient(
        180deg,
        rgba(20, 8, 12, 0.05) 0%,
        rgba(20, 8, 12, 0.32) 32%,
        rgba(20, 8, 12, 0.78) 60%,
        rgba(20, 8, 12, 0.96) 90%
      ) !important;
    }
    .dk-navratri-edit__content-box {
      padding: 0 1.25rem 2.2rem;
    }
    .dk-navratri-edit__content {
      max-width: 100%;
      text-align: center;
    }
    .dk-navratri-edit__eyebrow {
      font-size: 0.65rem;
      letter-spacing: 1.4px;
      margin-bottom: 0.5rem;
    }
    .dk-navratri-edit__title {
      font-size: clamp(1.4rem, 5.4vw, 1.85rem);
      margin-bottom: 0.65rem;
    }
    .dk-ne__br {
      display: none;
    }
    .dk-navratri-edit__subtitle {
      font-size: 0.82rem;
      line-height: 1.45;
      margin-bottom: 1.35rem;
    }
    .dk-navratri-edit__actions {
      justify-content: center;
    }
    .dk-navratri-edit__btn-primary {
      width: 100%;
      max-width: 290px;
      padding: 11px 20px;
      font-size: 0.76rem;
      letter-spacing: 1.5px;
    }
  }
</style>

{% schema %}
{
  "name": "DK Festive Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "✦ THE FESTIVE COLLECTION ✦"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Little More Colour.<br class=\"dk-ne__br\"> <em>A Little More Celebration.</em>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": ""
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Label",
      "default": "EXPLORE FESTIVE COLLECTION →"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Navratri Collection"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F9F5EE"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "DK The Navratri Edit"
    }
  ]
}
{% endschema %}
