{%- liquid
  assign eyebrow = section.settings.eyebrow | default: '✦ THE DELISHA PROMISE ✦'
  assign heading = section.settings.heading | default: 'Not Just Made. <em>Made Meaningful.</em>'
-%}

<section
  id="dk-why-delisha-{{ section.id }}"
  class="dk-why-sec"
  style="padding-top: {{ section.settings.padding_top | default: 36 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 42 }}px;"
>
  <div class="dk-why-container">
    
    <!-- COMPACT GLOSSY LUXURY STRIP -->
    <div class="dk-why-glossy-card">
      
      <!-- MINIMAL HEADER -->
      <div class="dk-why-header-minimal">
        <span class="dk-why-eyebrow">{{ eyebrow }}</span>
        <h2 class="dk-why-title-compact">{{ heading }}</h2>
      </div>

      <!-- 3 GLOSSY PILLARS -->
      <div class="dk-why-pillars-grid">
        
        <!-- PILLAR 1 -->
        <div class="dk-why-pillar-card">
          <div class="dk-pillar-icon-badge">
            <span class="dk-pillar-num">01</span>
          </div>
          <div class="dk-pillar-body">
            <h3 class="dk-why-pillar-title">{{ section.settings.p1_title | default: 'Thoughtfully Designed' }}</h3>
            <p class="dk-why-pillar-text">{{ section.settings.p1_text | default: 'Created around Indian celebrations, traditions and loved ones.' }}</p>
          </div>
        </div>

        <!-- PILLAR 2 -->
        <div class="dk-why-pillar-card">
          <div class="dk-pillar-icon-badge">
            <span class="dk-pillar-num">02</span>
          </div>
          <div class="dk-pillar-body">
            <h3 class="dk-why-pillar-title">{{ section.settings.p2_title | default: 'Artisanal Devotion' }}</h3>
            <p class="dk-why-pillar-text">{{ section.settings.p2_text | default: 'Individually handcrafted by master Indian artisans with pure gota & Kundan.' }}</p>
          </div>
        </div>

        <!-- PILLAR 3 -->
        <div class="dk-why-pillar-card">
          <div class="dk-pillar-icon-badge">
            <span class="dk-pillar-num">03</span>
          </div>
          <div class="dk-pillar-body">
            <h3 class="dk-why-pillar-title">{{ section.settings.p3_title | default: 'Celebration Ready' }}</h3>
            <p class="dk-why-pillar-text">{{ section.settings.p3_text | default: 'Protected in keepsake festive gift packaging with express Pan-India dispatch.' }}</p>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  .dk-why-sec {
    position: relative;
    width: 100%;
    background: linear-gradient(180deg, #FBF8F3 0%, #F8F3EC 100%);
    overflow: hidden;
  }
  .dk-why-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 32px);
    box-sizing: border-box;
  }

  /* PREMIUM GLOSSY CARD CONTAINER */
  .dk-why-glossy-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(254, 250, 245, 0.82) 100%);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(184, 154, 98, 0.28);
    border-radius: 14px;
    padding: clamp(24px, 3.2vw, 36px) clamp(20px, 3.6vw, 44px);
    box-shadow: 0 12px 32px -8px rgba(100, 26, 40, 0.07), inset 0 1px 0 rgba(255, 255, 255, 0.95);
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .dk-why-glossy-card:hover {
    border-color: rgba(184, 154, 98, 0.45);
    box-shadow: 0 18px 40px -10px rgba(100, 26, 40, 0.12), inset 0 1px 0 rgba(255, 255, 255, 1);
  }

  .dk-why-header-minimal {
    text-align: center;
    margin-bottom: clamp(20px, 2.5vw, 30px);
  }
  .dk-why-eyebrow {
    display: inline-block;
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--dk-color-primary, #641A28);
    margin-bottom: 4px;
  }
  .dk-why-title-compact {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(1.5rem, 2.3vw, 2rem);
    font-weight: 600;
    line-height: 1.25;
    color: #211216;
    margin: 0;
    letter-spacing: -0.2px;
  }
  .dk-why-title-compact em {
    font-style: italic;
    font-weight: 400;
    color: var(--dk-color-primary, #641A28);
  }

  /* 3 PILLARS IN A BALANCED ROW */
  .dk-why-pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2.4vw, 32px);
  }

  .dk-why-pillar-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(184, 154, 98, 0.15);
    transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease;
  }
  .dk-why-pillar-card:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(184, 154, 98, 0.35);
  }

  .dk-pillar-icon-badge {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(184, 154, 98, 0.15) 0%, rgba(100, 26, 40, 0.08) 100%);
    border: 1px solid rgba(184, 154, 98, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dk-pillar-num {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: 0.95rem;
    font-weight: 600;
    font-style: italic;
    color: #8C6A2E;
  }

  .dk-pillar-body {
    flex: 1;
  }
  .dk-why-pillar-title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: #211216;
    margin: 0 0 4px;
    line-height: 1.25;
  }
  .dk-why-pillar-text {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.8rem;
    line-height: 1.5;
    color: #6A5B55;
    margin: 0;
  }

  @media (max-width: 860px) {
    .dk-why-pillars-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .dk-why-glossy-card {
      padding: 20px 16px;
    }
    .dk-why-pillar-card {
      padding: 12px 14px;
    }
  }
</style>

{% schema %}
{
  "name": "DK Why Delisha",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "✦ THE DELISHA PROMISE ✦"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not Just Made.<br> <em>Made Meaningful.</em>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every Delisha Karigari piece begins with a celebration in mind — a doorway waiting to be adorned, a gift waiting to be opened, or a moment waiting to be remembered."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Pillar 1"
    },
    {
      "type": "text",
      "id": "p1_title",
      "label": "Pillar 1 Title",
      "default": "Thoughtfully Designed"
    },
    {
      "type": "textarea",
      "id": "p1_text",
      "label": "Pillar 1 Text",
      "default": "Created around Indian celebrations, traditions and the people we celebrate with."
    },
    {
      "type": "header",
      "content": "Pillar 2"
    },
    {
      "type": "text",
      "id": "p2_title",
      "label": "Pillar 2 Title",
      "default": "Made With Care"
    },
    {
      "type": "textarea",
      "id": "p2_text",
      "label": "Pillar 2 Text",
      "default": "From intricate décor to personalised gifting, every detail is chosen with intention."
    },
    {
      "type": "header",
      "content": "Pillar 3"
    },
    {
      "type": "text",
      "id": "p3_title",
      "label": "Pillar 3 Title",
      "default": "Celebration Ready"
    },
    {
      "type": "textarea",
      "id": "p3_text",
      "label": "Pillar 3 Text",
      "default": "Beautifully curated pieces made to bring warmth, colour and character to your special moments."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 75
    }
  ],
  "presets": [
    {
      "name": "DK Why Delisha"
    }
  ]
}
{% endschema %}
