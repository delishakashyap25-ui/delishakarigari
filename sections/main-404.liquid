{%- liquid
  assign is_collection_route = false
  if request.path contains '/collections/'
    assign is_collection_route = true
    assign raw_handle = request.path | split: '/collections/' | last | split: '?' | first | split: '/' | first
    
    case raw_handle
      when 'latkan', 'door-latkan'
        assign page_title = 'Door Latkans'
      when 'gifting', 'gifts', 'gifts-for-her', 'for-her-accessories'
        assign page_title = 'Gifts For Her'
      when 'under-199'
        assign page_title = 'Curations Under ₹199'
      when 'bandhanwar', 'bandhanwars'
        assign page_title = 'Handcrafted Bandhanwars & Torans'
      when 'diwali-decor', 'diwali'
        assign page_title = 'Festive Diwali Décor'
      when 'karwa-chauth-special', 'karwa-chauth'
        assign page_title = 'Karwa Chauth Specials'
      when 'navratri-decor', 'navratri'
        assign page_title = 'Navratri Décor'
      when 'handmade-potli', 'potli', 'potlis'
        assign page_title = 'Handmade Festive Potlis'
      else
        assign page_title = raw_handle | replace: '-', ' ' | capitalize
    endcase
  endif
-%}

{%- if is_collection_route -%}
  <!-- ELEVATED COLLECTION VIEW FOR CURATED COLLECTIONS -->
  <section class="dk-collection-section" style="background-color: #FAF6F0; min-height: 80vh; padding: 24px 0 70px 0;">
    <div class="dk-collection-container" style="width: 92%; max-width: 1360px; margin: 0 auto;">
      
      <!-- BREADCRUMB -->
      <nav class="dk-collection-hero__breadcrumb" aria-label="Breadcrumb" style="display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 16px; font-size: 0.78rem; color: #8C7B75;">
        <a href="{{ routes.root_url }}" style="color: #6A5B55; text-decoration: none;">Home</a>
        <span class="sep" style="color: #B5A8A3;">/</span>
        <a href="{{ routes.all_products_collection_url }}" style="color: #6A5B55; text-decoration: none;">Collections</a>
        <span class="sep" style="color: #B5A8A3;">/</span>
        <span class="current" style="color: var(--dk-color-primary, #641A28); font-weight: 600;">{{ page_title }}</span>
      </nav>

      <!-- TITLE -->
      <div style="text-align: center; margin-bottom: 24px;">
        <h1 style="font-family: var(--dk-font-heading, 'Playfair Display', serif); font-size: clamp(2rem, 3.2vw, 2.75rem); font-weight: 600; color: #211216; margin: 0 0 10px;">
          {{ page_title }}
        </h1>
        <div style="display: inline-block; padding: 6px 18px; background: rgba(184, 154, 98, 0.12); border: 1px solid rgba(184, 154, 98, 0.3); border-radius: 20px; font-size: 0.8rem; color: #7A5B28; font-weight: 500;">
          ✦ Handcrafted in Delhi • Pan-India express delivery • Thoughtfully curated ✦
        </div>
      </div>

      <!-- HORIZONTAL NAVIGATION -->
      <nav class="dk-category-nav" aria-label="Collections" style="width: 100%; margin-bottom: 30px; border-bottom: 1px solid #ECE3D6; overflow-x: auto;">
        <div class="dk-category-nav__track" style="display: flex; align-items: center; justify-content: center; gap: clamp(8px, 1.8vw, 24px); white-space: nowrap; padding-bottom: 12px; overflow-x: auto;">
          <a href="{{ routes.all_products_collection_url }}" class="dk-category-nav__item" style="color: #555; text-decoration: none; font-size: 0.82rem; font-weight: 600; text-transform: uppercase;">
            All Collections
          </a>
          <a href="{{ routes.collections_url }}/bandhanwar" class="dk-category-nav__item" style="color: #555; text-decoration: none; font-size: 0.82rem; font-weight: 600; text-transform: uppercase;">
            Bandhanwars
          </a>
          <a href="{{ routes.collections_url }}/latkan" class="dk-category-nav__item" style="color: #555; text-decoration: none; font-size: 0.82rem; font-weight: 600; text-transform: uppercase;">
            Door Latkans
          </a>
          <a href="{{ routes.collections_url }}/karwa-chauth-special" class="dk-category-nav__item" style="color: #555; text-decoration: none; font-size: 0.82rem; font-weight: 600; text-transform: uppercase;">
            Karwa Chauth
          </a>
          <a href="{{ routes.collections_url }}/diwali-decor" class="dk-category-nav__item" style="color: #555; text-decoration: none; font-size: 0.82rem; font-weight: 600; text-transform: uppercase;">
            Diwali Décor
          </a>
          <a href="{{ routes.collections_url }}/for-her-accessories" class="dk-category-nav__item" style="color: #555; text-decoration: none; font-size: 0.82rem; font-weight: 600; text-transform: uppercase;">
            Gifts for Her
          </a>
          <a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=199" class="dk-category-nav__item" style="color: #555; text-decoration: none; font-size: 0.82rem; font-weight: 600; text-transform: uppercase;">
            Under ₹199
          </a>
          <a href="{{ routes.collections_url }}/navratri-decor" class="dk-category-nav__item" style="color: #555; text-decoration: none; font-size: 0.82rem; font-weight: 600; text-transform: uppercase;">
            Navratri Décor
          </a>
          <a href="{{ routes.collections_url }}/handmade-potli" class="dk-category-nav__item" style="color: #555; text-decoration: none; font-size: 0.82rem; font-weight: 600; text-transform: uppercase;">
            Handmade Potli
          </a>
        </div>
      </nav>

      <!-- SHOWCASE STORE PRODUCTS -->
      <div class="dk-collection-content">
        <div class="dk-product-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px;">
          {%- assign showcase_collection = collections['all'] | default: collections.first -%}
          {%- for product in collections.all.products limit: 12 -%}
            <div class="dk-grid-cell">
              {% render 'product-card', product: product %}
            </div>
          {%- endfor -%}
        </div>
        <div style="text-align: center; margin-top: 40px;">
          <a href="{{ routes.all_products_collection_url }}" class="dk-btn dk-btn-primary" style="padding: 14px 38px; font-size: 0.85rem; letter-spacing: 1.5px; border-radius: 4px; background: var(--dk-color-primary, #6E1F2A); color: #FFF; text-decoration: none; display: inline-block;">
            VIEW COMPLETE CATALOGUE &rarr;
          </a>
        </div>
      </div>

    </div>
  </section>
{%- else -%}
  <!-- STANDARD 404 FOR NON-COLLECTION URLS -->
  <section class="dk-404-sec" style="background-color: var(--dk-color-background, #F9F5EE); padding: 90px 0 110px 0;">
    <div class="container text-center">
      <span class="dk-subtitle" style="color: var(--dk-color-gold, #B89552); letter-spacing: 3px; font-weight: 600; text-transform: uppercase; font-size: 0.9rem; display: block; margin-bottom: 8px;">
        ERROR 404
      </span>
      <h1 class="dk-heading" style="font-family: var(--dk-font-heading, 'Playfair Display', serif); font-size: clamp(2.4rem, 4.5vw, 3.5rem); font-weight: 700; color: var(--dk-color-primary, #6E1F2A); margin: 0 0 16px 0;">
        Page Not Found
      </h1>
      <p style="font-family: var(--dk-font-body, 'Poppins', sans-serif); font-size: 1.05rem; color: var(--dk-color-text-muted, #555555); max-width: 540px; margin: 0 auto 32px auto; line-height: 1.6;">
        The page you are looking for might have been moved or renamed. Discover our handcrafted treasures below.
      </p>

      <!-- SEARCH BAR -->
      <div style="max-width: 480px; margin: 0 auto 36px auto;">
        <form action="{{ routes.search_url }}" method="get" role="search" style="display: flex; gap: 8px;">
          <input
            type="search"
            name="q"
            placeholder="Search for Rakhis, Lumbas, Gifts..."
            style="flex: 1; padding: 12px 18px; border: 1.5px solid rgba(110,31,42,0.2); border-radius: 4px; font-family: var(--dk-font-body, 'Poppins', sans-serif); font-size: 0.9rem; outline: none; background: #FFFFFF;"
          >
          <button
            type="submit"
            class="dk-btn dk-btn-primary"
            style="padding: 12px 24px; font-size: 0.85rem; font-weight: 600; letter-spacing: 1px; background: var(--dk-color-primary, #6E1F2A); color: #fff; border: none; border-radius: 4px;"
          >
            SEARCH
          </button>
        </form>
      </div>

      <!-- ACTION BUTTONS -->
      <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
        <a href="{{ routes.root_url }}" class="dk-btn dk-btn-primary" style="padding: 14px 36px; font-size: 0.85rem; letter-spacing: 1.8px; background: var(--dk-color-primary, #6E1F2A); color: #fff; text-decoration: none; border-radius: 4px;">
          RETURN TO HOME
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="dk-btn dk-btn-outline" style="padding: 14px 36px; font-size: 0.85rem; letter-spacing: 1.8px; border: 1px solid var(--dk-color-primary, #6E1F2A); color: var(--dk-color-primary, #6E1F2A); text-decoration: none; border-radius: 4px;">
          EXPLORE ALL PRODUCTS
        </a>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
