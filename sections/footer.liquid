        </a>

        <a href="{{ routes.collections_url }}/for-her-accessories">
          Gifts for Her
        </a>

        <a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=199">
          Under ₹199
        </a>

      </div>


      <!-- SUPPORT -->
      <div class="delisha-footer-column">

        <h3>SUPPORT</h3>

        <a href="/pages/contact">
          Contact Us
        </a>

        <a href="/pages/faqs">
          FAQs
        </a>

        <a href="/policies/refund-policy">
          Returns & Refunds
        </a>

        <a href="/pages/shipping-policy">
          Track Your Order
        </a>

      </div>


      <!-- CONNECT WITH US -->
      <div class="delisha-footer-column delisha-contact-column">

        <h3>CONNECT WITH US</h3>

        <p>
          Handcrafted with devotion in Delhi.<br>
          Sent with love to celebrations across India.
        </p>

        <a
          href="https://wa.me/919211549097?text=Hi%20Delisha%20Karigari,%20I'd%20like%20to%20inquire%20about%20your%20handcrafted%20decor%20and%20customisations."
          target="_blank"
          rel="noopener noreferrer"
          class="delisha-footer-whatsapp"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.04 3.67C14.24 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.04 20.16C10.61 20.16 9.21 19.78 7.99 19.06L7.7 18.89L4.58 19.71L5.41 16.67L5.22 16.37C4.42 15.1 4 13.52 4 11.91C4 7.48 7.6 3.67 12.04 3.67ZM8.84 7.37C8.65 7.37 8.34 7.44 8.08 7.72C7.82 8 7.08 8.69 7.08 10.09C7.08 11.49 8.1 12.84 8.24 13.03C8.38 13.22 10.21 16.18 13.08 17.3C15.46 18.23 15.95 18.04 16.46 17.99C16.97 17.94 18.1 17.32 18.33 16.67C18.56 16.02 18.56 15.46 18.49 15.34C18.42 15.22 18.23 15.15 17.95 15.01C17.67 14.87 16.29 14.19 16.03 14.1C15.77 14.01 15.58 13.96 15.39 14.24C15.2 14.52 14.66 15.15 14.5 15.34C14.34 15.53 14.18 15.55 13.9 15.41C13.62 15.27 12.72 14.98 11.66 14.03C10.83 13.29 10.27 12.38 10.11 12.1C9.95 11.82 10.09 11.67 10.23 11.53C10.36 11.4 10.51 11.2 10.65 11.04C10.79 10.88 10.84 10.76 10.93 10.57C11.02 10.38 10.98 10.22 10.91 10.08C10.84 9.94 10.28 8.57 10.05 8.01C9.82 7.47 9.59 7.54 9.42 7.53C9.26 7.52 9.07 7.37 8.84 7.37Z"/>
          </svg>
          <span>Chat on WhatsApp</span>
        </a>

        <div class="delisha-footer-contact-details">
          <a href="mailto:delishakarigari@gmail.com" class="delisha-footer-contact-line">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>delishakarigari@gmail.com</span>
          </a>
          <a href="tel:+919211549097" class="delisha-footer-contact-line">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>+91 92115 49097</span>
          </a>
        </div>

      </div>

    </div>


    <!-- FOOTER BOTTOM -->

    <div class="delisha-footer-bottom">

      <p>
        © 2026 DELISHA KARIGARI. HANDCRAFTED WITH LOVE IN INDIA.
      </p>

      <div class="delisha-legal">

        <a href="/policies/privacy-policy">
          Privacy Policy
        </a>

        <span>·</span>

        <a href="/policies/terms-of-service">
