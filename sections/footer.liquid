  </div>

</footer>


<style>
  /* =========================================================
   DELISHA KARIGARI FOOTER
   ========================================================= */

  .delisha-footer {

    position: relative;

    width: 100%;

    background: #F7F1EA;

    color: #35151F;

    overflow: hidden;

    border-top: 1px solid #E7DCD4;

  }


  /* =========================================================
   BACKGROUND HERITAGE PATTERN
   ========================================================= */

  .delisha-footer-pattern {

    position: absolute;

    inset: 0;

    pointer-events: none;

    overflow: hidden;

    opacity: 0.055;

  }

  .delisha-footer-pattern span {

    position: absolute;

    font-family: serif;

    font-size: 150px;

    color: #64142D;

    font-weight: 400;

  }

  .delisha-footer-pattern span:nth-child(1) {
    top: -50px;
    left: 4%;
  }

  .delisha-footer-pattern span:nth-child(2) {
    top: 20%;
    left: 28%;
    font-size: 90px;
  }

  .delisha-footer-pattern span:nth-child(3) {
    bottom: -60px;
    left: 48%;
  }

  .delisha-footer-pattern span:nth-child(4) {
    top: 10%;
    right: 28%;
    font-size: 100px;
  }

  .delisha-footer-pattern span:nth-child(5) {
    bottom: -70px;
    right: 5%;
  }

  .delisha-footer-pattern span:nth-child(6) {
    top: 45%;
    right: 15%;
    font-size: 70px;
  }

  .delisha-footer-pattern span:nth-child(7) {
    top: 60%;
    left: 12%;
    font-size: 80px;
  }

  .delisha-footer-pattern span:nth-child(8) {
    bottom: 5%;
    left: 35%;
    font-size: 65px;
  }


  /* =========================================================
   CONTAINER
   ========================================================= */

  .delisha-footer-container {

    position: relative;

    z-index: 2;

    max-width: 1320px;

    margin: 0 auto;

    padding: 65px 50px 0;

  }


  /* =========================================================
   MAIN FOOTER
   ========================================================= */

  .delisha-footer-main {

    display: grid;

    grid-template-columns:
      2.2fr 1fr 1fr 1.25fr;

    gap: 60px;

    padding-bottom: 55px;

  }


  /* =========================================================
   BRAND
   ========================================================= */

  .delisha-footer-brand {

    max-width: 440px;

  }

  .delisha-footer-logo {

    font-family: Georgia, serif;

    font-size: 35px;

    font-weight: 700;

    letter-spacing: -1px;

    color: #35151F;

    margin-bottom: 10px;

  }

  .delisha-footer-logo span {

    font-size: 18px;

    margin: 0 4px;

    color: #64142D;

  }

  .delisha-footer-tagline {

    font-size: 14px;

    font-weight: 600;

    letter-spacing: 0.3px;

    color: #64142D;

    margin: 0 0 12px;

  }

  .delisha-footer-description {

    max-width: 390px;

    font-size: 14px;

    line-height: 1.7;

    color: #75656A;

    margin: 0 0 25px;

  }


  /* =========================================================
   NEWSLETTER
   ========================================================= */

  .delisha-newsletter-title {

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 1.3px;

    text-transform: uppercase;

    margin: 0 0 10px;

    color: #35151F;

  }

  .delisha-newsletter-input {

    width: 100%;

    max-width: 390px;

    height: 48px;

    display: flex;

    align-items: center;

    border: 1px solid #D8C9C0;

    border-radius: 4px;

    background: rgba(255, 255, 255, 0.55);

  }

  .delisha-newsletter-input input {

    flex: 1;

    min-width: 0;

    border: none;

    outline: none;

    background: transparent;

    padding: 0 15px;

    font-size: 13px;

    color: #35151F;

  }

  .delisha-newsletter-input input::placeholder {

    color: #9B8B8F;

  }

  .delisha-newsletter-input button {

    width: 48px;

    height: 48px;

    border: none;

    background: #64142D;

    color: #ffffff;

    font-size: 20px;

    cursor: pointer;

    transition: 0.3s ease;

  }

  .delisha-newsletter-input button:hover {

    background: #35151F;

  }

  .delisha-newsletter-success {

    font-size: 12px;

    color: #64142D;

    margin-top: 8px;

  }


  /* =========================================================
   SOCIAL ICONS
   ========================================================= */

  .delisha-social {
    display: flex;
    gap: 14px;
    margin-top: 22px;
  }

  .delisha-social-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid #D8C9C0;
    color: #35151F;
    text-decoration: none;
    transition: all 0.3s ease;
    background: rgba(255, 255, 255, 0.4);
  }

  .delisha-social-icon:hover {
    background: #64142D;
    color: #ffffff;
    border-color: #64142D;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(100, 20, 45, 0.2);
  }

  .delisha-social-icon svg {
    display: block;
  }

  /* =========================================================
   CONTACT DETAILS
   ========================================================= */

  .delisha-footer-contact-details {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .delisha-footer-contact-line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #75656A !important;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .delisha-footer-contact-line:hover {
    color: #64142D !important;
    transform: none;
  }

  .delisha-footer-contact-line svg {
    flex-shrink: 0;
    color: #B89A62;
  }


  /* =========================================================
   FOOTER COLUMNS
   ========================================================= */

  .delisha-footer-column {

    display: flex;

    flex-direction: column;

    align-items: flex-start;

  }

  .delisha-footer-column h3 {

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 1.5px;

    color: #64142D;

    margin: 4px 0 20px;

  }

  .delisha-footer-column a {

    font-size: 14px;

    line-height: 1.5;

    color: #75656A;

    text-decoration: none;

    margin-bottom: 11px;

    transition: 0.3s ease;

  }

  .delisha-footer-column a:hover {

    color: #64142D;

    transform: translateX(2px);

  }

  /* =========================================================
   CONTACT COLUMN
   ========================================================= */

  .delisha-contact-column p {
    max-width: 270px;
    color: #75656A;
    font-size: 13px;
    line-height: 1.65;
    margin: 0 0 12px;
  }

  .delisha-footer-whatsapp {
    display: inline-flex !important;
    align-items: center;
    gap: 9px;
    background: #64142D;
    color: #ffffff !important;
    padding: 11px 17px;
    border-radius: 4px;
    font-size: 12px !important;
    font-weight: 600;
    margin-bottom: 14px !important;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .delisha-footer-whatsapp:hover {
    background: #35151F;
    color: #ffffff !important;
    transform: translateY(-1px) !important;
    box-shadow: 0 4px 12px rgba(100, 20, 45, 0.2);
  }

  .delisha-footer-whatsapp span {
    font-size: 11px;
  }


  /* =========================================================
   BOTTOM
   ========================================================= */

  .delisha-footer-bottom {

    min-height: 65px;

    border-top: 1px solid #E1D4CC;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    position: relative;

  }

  .delisha-footer-bottom p {

    margin: 0;

    font-size: 10px;

    letter-spacing: 1px;

    color: #75656A;

  }

  .delisha-legal {

    display: flex;

    align-items: center;

    gap: 10px;

  }

  .delisha-legal a {

    font-size: 10px;

    letter-spacing: 0.5px;

    color: #75656A;

    text-decoration: none;

  }

  .delisha-legal a:hover {

    color: #64142D;

  }

  .delisha-back-top {

    width: 34px;

    height: 34px;

    display: flex;

    align-items: center;

    justify-content: center;

    border: 1px solid #D8C9C0;

    border-radius: 50%;

    color: #64142D;

    text-decoration: none;

    font-size: 16px;

    transition: 0.3s ease;

  }

  .delisha-back-top:hover {

    background: #64142D;

    color: #ffffff;

    border-color: #64142D;

  }


  /* =========================================================
   TABLET
   ========================================================= */

  @media screen and (max-width: 1000px) {

    .delisha-footer-main {

      grid-template-columns: 1.5fr 1fr 1fr;

      gap: 40px;

    }

    .delisha-footer-brand {

      grid-column: 1 / -1;

      max-width: 600px;

    }

  }


  /* =========================================================
   MOBILE
   ========================================================= */

  @media screen and (max-width: 700px) {

    .delisha-footer-container {

      padding: 45px 22px 0;

    }

    .delisha-footer-main {

      grid-template-columns: 1fr 1fr;

      gap: 35px 25px;

      padding-bottom: 35px;

    }

    .delisha-footer-brand {

      grid-column: 1 / -1;

    }

    .delisha-contact-column {

      grid-column: 1 / -1;

      width: 100%;

      margin-top: 5px;

      padding-top: 18px;

      border-top: 1px dashed #E2D4CB;

    }

    .delisha-contact-column p {

      max-width: 100%;

    }

    .delisha-footer-logo {

      font-size: 28px;

    }

    .delisha-footer-description {

      font-size: 13px;

    }

    .delisha-newsletter-input {

      max-width: 100%;

    }

    .delisha-footer-bottom {

      min-height: auto;

      padding: 18px 0;

      flex-wrap: wrap;

    }

    .delisha-footer-bottom p {

      width: 100%;

      line-height: 1.6;

    }

    .delisha-legal {

      order: 3;

      width: 100%;

    }

    .delisha-back-top {

      margin-left: auto;

    }

  }
</style>


<script>
  document.addEventListener('DOMContentLoaded', function() {

  var backTop = document.getElementById('delishaBackTop');

  if (backTop) {

    backTop.addEventListener('click', function(e) {

      e.preventDefault();

      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });

    });

  }

});

</script>


