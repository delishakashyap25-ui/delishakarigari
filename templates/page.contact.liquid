<div class="contact-page-container">
  
  <!-- HERO BANNER -->
  <div class="contact-hero">
    <div class="contact-hero-content">
      <span class="contact-subtitle">We are here to help</span>
      <h1 class="contact-title">Contact Us</h1>
      <p class="contact-lead">Have a question, feedback, or custom request? Reach out to us and we'll get back to you as soon as possible.</p>
    </div>
  </div>

  <!-- CONTACT CONTENT SECTION -->
  <div class="contact-section">
    <div class="contact-grid">
      
      <!-- Left Column: Info -->
      <div class="contact-info-col">
        <div class="info-card">
          <h2 class="info-title">Get In Touch</h2>
          <p class="info-desc">Feel free to contact us for support, wholesale inquiries, bulk orders, or custom design collaborations.</p>
          
          <div class="info-list">
            <div class="info-item">
              <span class="info-icon">✉️</span>
              <div class="info-text">
                <span class="info-label">Email Us</span>
                <a href="mailto:support@delishakarigari.com" class="info-link">support@delishakarigari.com</a>
              </div>
            </div>
            
            <div class="info-item">
              <span class="info-icon">📞</span>
              <div class="info-text">
                <span class="info-label">Call or WhatsApp</span>
                <a href="tel:+919876543210" class="info-link">+91 98765 43210</a>
              </div>
            </div>

            <div class="info-item">
              <span class="info-icon">📍</span>
              <div class="info-text">
                <span class="info-label">Our Showroom / Workshop</span>
                <span class="info-value">Delisha Karigari, Pink City, Jaipur, Rajasthan, India</span>
              </div>
            </div>

            <div class="info-item">
              <span class="info-icon">🕒</span>
              <div class="info-text">
                <span class="info-label">Operating Hours</span>
                <span class="info-value">Monday – Saturday: 10:00 AM – 7:00 PM IST</span>
              </div>
            </div>
          </div>

          <!-- Social Links -->
          <div class="contact-social-links">
            <span class="social-label">Follow our journey:</span>
            <div class="social-icons-wrapper">
              <a href="{{ settings.social_instagram_link | default: '#' }}" class="social-circle" aria-label="Instagram">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </a>
              <a href="{{ settings.social_pinterest_link | default: '#' }}" class="social-circle" aria-label="Pinterest">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.64 7.86 6.4 9.33-.08-.79-.16-2.01.03-2.88.18-.78 1.15-4.88 1.15-4.88s-.29-.58-.29-1.45c0-1.36.79-2.38 1.77-2.38.84 0 1.24.63 1.24 1.38 0 .84-.54 2.1-.81 3.27-.23.97.49 1.76 1.45 1.76 1.74 0 3.08-1.84 3.08-4.49 0-2.35-1.69-3.99-4.1-3.99-2.79 0-4.43 2.1-4.43 4.26 0 .84.32 1.75.73 2.25.08.1.09.18.06.29l-.27 1.09c-.04.17-.15.21-.34.12-1.24-.58-2.02-2.39-2.02-3.85 0-3.13 2.28-6.01 6.56-6.01 3.45 0 6.12 2.45 6.12 5.73 0 3.42-2.16 6.18-5.15 6.18-1.01 0-1.95-.52-2.27-1.14l-.62 2.35c-.22.86-.83 1.93-1.24 2.59 1.12.33 2.3.51 3.52.51 5.52 0 10-4.48 10-10S17.52 2 12 2z"></path></svg>
              </a>
              <a href="{{ settings.social_facebook_link | default: '#' }}" class="social-circle" aria-label="Facebook">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Form -->
      <div class="contact-form-col">
        <div class="form-card">
          <h2 class="form-card-title">Send Us a Message</h2>
          
          {% form 'contact', class: 'contact-form' %}
            {% if form.posted_successfully? %}
              <div class="success-message">
                ✨ Thank you for reaching out! We have received your message and will contact you shortly.
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="errors">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="input-row">
              <div class="input-group flex-1">
                <label for="ContactFormName" class="input-label">Your Name</label>
                <input
                  type="text"
                  name="contact[name]"
                  id="ContactFormName"
                  class="input-field"
                  placeholder="Enter your name"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  required
                >
              </div>

              <div class="input-group flex-1">
                <label for="ContactFormEmail" class="input-label">Email Address</label>
                <input
                  type="email"
                  name="contact[email]"
                  id="ContactFormEmail"
                  class="input-field"
                  placeholder="Enter your email"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                >
              </div>
            </div>

            <div class="input-group">
              <label for="ContactFormPhone" class="input-label">Phone Number</label>
              <input
                type="tel"
                name="contact[phone]"
                id="ContactFormPhone"
                class="input-field"
                placeholder="Enter your phone number (optional)"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              >
            </div>

            <div class="input-group">
              <label for="ContactFormMessage" class="input-label">Your Message</label>
              <textarea
                rows="6"
                name="contact[body]"
                id="ContactFormMessage"
                class="input-field text-area"
                placeholder="How can we help you?"
                required
              >{% if form.body %}{{ form.body }}{% endif %}</textarea>
            </div>

            <button type="submit" class="submit-btn">Send Message</button>
          {% endform %}
        </div>
      </div>

    </div>
  </div>

</div>

<style>
.contact-page-container {
  font-family: 'Poppins', sans-serif;
  color: #222222;
  background-color: #f8f3ea;
  box-sizing: border-box;
}

/* Hero Banner */
.contact-hero {
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.75) 100%), 
              url('https://images.unsplash.com/photo-1596492784531-6e6eb5ea9993?auto=format&fit=crop&q=80&w=1600') no-repeat center center;
  background-size: cover;
  padding: 150px 20px 110px 20px;
  text-align: center;
  color: #ffffff;
}
.contact-hero-content {
  max-width: 800px;
  margin: 0 auto;
}
.contact-subtitle {
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2.5px;
  color: #caa25d;
  margin-bottom: 15px;
  display: block;
}
.contact-title {
  font-family: 'Playfair Display', serif;
  font-size: 50px;
  font-weight: 700;
  margin: 0 0 20px 0;
  letter-spacing: -0.5px;
  line-height: 1.2;
}
.contact-lead {
  font-size: 18px;
  opacity: 0.9;
  font-weight: 300;
  margin: 0;
  line-height: 1.6;
}

/* Content Section */
.contact-section {
  padding: 95px 40px;
  max-width: 1300px;
  margin: 0 auto;
  box-sizing: border-box;
}
.contact-grid {
  display: flex;
  gap: 50px;
  align-items: stretch;
}
.contact-info-col, .contact-form-col {
  flex: 1;
}

/* Cards styling */
.info-card, .form-card {
  background: #ffffff;
  border: 1px solid rgba(202, 162, 93, 0.15);
  box-shadow: 0 15px 45px rgba(0, 0, 0, 0.03);
  border-radius: 24px;
  padding: 55px 45px;
  box-sizing: border-box;
  height: 100%;
}

.info-title, .form-card-title {
  font-family: 'Playfair Display', serif;
  font-size: 32px;
  font-weight: 700;
  color: #222222;
  margin: 0 0 15px 0;
  position: relative;
}
.info-title::after, .form-card-title::after {
  content: '';
  display: block;
  width: 50px;
  height: 3px;
  background: #caa25d;
  margin-top: 12px;
}
.info-desc {
  font-size: 15px;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 35px;
}

/* Info List */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 25px;
  margin-bottom: 40px;
}
.info-item {
  display: flex;
  gap: 20px;
  align-items: flex-start;
}
.info-icon {
  font-size: 24px;
  background: #fbfbf9;
  border: 1px solid rgba(202, 162, 93, 0.2);
  width: 45px;
  height: 45px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.info-text {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.info-label {
  font-size: 11px;
  font-weight: 600;
  color: #999999;
  text-transform: uppercase;
  letter-spacing: 1px;
}
.info-link {
  font-size: 16px;
  color: #caa25d;
  font-weight: 600;
  text-decoration: none;
  transition: color 0.3s ease;
}
.info-link:hover {
  color: #8e6c38;
  text-decoration: underline;
}
.info-value {
  font-size: 15px;
  color: #444444;
  line-height: 1.5;
}

/* Social Links */
.contact-social-links {
  border-top: 1px solid #eeeeee;
  padding-top: 30px;
  display: flex;
  flex-direction: column;
  gap: 15px;
}
.social-label {
  font-size: 13px;
  font-weight: 600;
  color: #222222;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.social-icons-wrapper {
  display: flex;
  gap: 12px;
}
.social-circle {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid #e2e0da;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #222222;
  transition: all 0.3s ease;
  text-decoration: none;
}
.social-circle:hover {
  background: #caa25d;
  color: #ffffff;
  border-color: #caa25d;
  transform: translateY(-3px);
}

/* Form Styles */
.contact-form {
  display: flex;
  flex-direction: column;
  gap: 22px;
}
.input-row {
  display: flex;
  gap: 20px;
}
.flex-1 {
  flex: 1;
}
.input-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.input-label {
  font-size: 12px;
  font-weight: 600;
  color: #222222;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.input-field {
  background: #fbfbf9;
  border: 1px solid #e2e0da;
  border-radius: 12px;
  padding: 14px 18px;
  font-size: 15px;
  font-family: 'Poppins', sans-serif;
  color: #222222;
  outline: none;
  transition: all 0.3s ease;
  width: 100%;
  box-sizing: border-box;
}
.input-field::placeholder {
  color: #a4a29c;
  opacity: 0.8;
}
.input-field:focus {
  border-color: #caa25d;
  background: #ffffff;
  box-shadow: 0 0 0 4px rgba(202, 162, 93, 0.12);
}
.text-area {
  resize: vertical;
}
.submit-btn {
  background: #222222;
  color: #ffffff;
  border: 1px solid #222222;
  border-radius: 50px;
  padding: 16px;
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  width: 100%;
  margin-top: 10px;
}
.submit-btn:hover {
  background: #caa25d;
  border-color: #caa25d;
  box-shadow: 0 5px 15px rgba(202, 162, 93, 0.3);
  transform: translateY(-2px);
}

.success-message {
  background: #f3faf7;
  border: 1px solid #def7ec;
  color: #03543f;
  border-radius: 12px;
  padding: 14px 18px;
  font-size: 14px;
  line-height: 1.5;
  margin-bottom: 15px;
}
.errors {
  background: #fdf2f2;
  border: 1px solid #f8b4b4;
  color: #9b1c1c;
  border-radius: 12px;
  padding: 14px 18px;
  font-size: 13px;
  line-height: 1.5;
  margin-bottom: 15px;
}

/* Responsive adjustments */
@media (max-width: 992px) {
  .contact-grid {
    flex-direction: column;
    gap: 40px;
  }
}
@media (max-width: 768px) {
  .contact-hero {
    padding: 110px 20px 80px 20px;
  }
  .contact-title {
    font-size: 36px;
  }
  .contact-lead {
    font-size: 16px;
  }
  .contact-section {
    padding: 60px 20px;
  }
  .info-card, .form-card {
    padding: 35px 25px;
    border-radius: 20px;
  }
  .info-title, .form-card-title {
    font-size: 26px;
  }
  .input-row {
    flex-direction: column;
    gap: 22px;
  }
}
</style>
