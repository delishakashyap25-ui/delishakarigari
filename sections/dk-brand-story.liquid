<section
  id="dk-brand-story-{{ section.id }}"
  class="dk-brand-story-sec"
  style="background-color: {{ section.settings.bg_color | default: '#F2E5DD' }}; padding: {{ section.settings.padding_top | default: 80 }}px 0 {{ section.settings.padding_bottom | default: 80 }}px 0;"
>
  <div class="container">
    <div class="dk-brand-story-grid">
      <!-- Content Side -->
      <div class="dk-brand-story-content">
        {%- if section.settings.subheading != blank -%}
          <span class="dk-subtitle">{{ section.settings.subheading | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="dk-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="dk-brand-story-body">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.signature != blank -%}
          <div class="dk-brand-story-signature">
            <span>{{ section.settings.signature | escape }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div style="margin-top: var(--dk-space-xl, 2rem);">
            <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="dk-btn dk-btn-secondary">
              {{ section.settings.button_label | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>

      <!-- Image Side -->
      <div class="dk-brand-story-media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1000 }}"
            alt="{{ section.settings.heading | escape }}"
            class="dk-brand-story-img"
            loading="lazy"
            width="1000"
            height="1200"
          >
        {%- else -%}
          <img
            src="{{ 'dk-hero-banner-1.jpg' | asset_url }}"
            alt="{{ section.settings.heading | default: 'The Art of DELISHA KARIGARI' | escape }}"
            class="dk-brand-story-img"
            loading="lazy"
            width="1000"
            height="1200"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .dk-brand-story-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--dk-space-2xl, 4rem);
    align-items: center;
  }
  .dk-brand-story-body {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--dk-color-text, #252525);
    margin-top: var(--dk-space-md, 1rem);
    font-weight: 300;
  }
  .dk-brand-story-signature {
    margin-top: var(--dk-space-lg, 1.5rem);
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--dk-color-primary, #6E1F2A);
  }
  .dk-brand-story-media {
    position: relative;
    border-radius: var(--dk-radius-lg, 12px);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background-color: var(--dk-color-background, #F9F5EE);
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
  }
  .dk-brand-story-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dk-brand-story-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dk-brand-story-placeholder-svg {
    width: 100%;
    height: 100%;
    opacity: 0.35;
  }

  @media (max-width: 900px) {
    .dk-brand-story-grid {
      grid-template-columns: 1fr;
      gap: var(--dk-space-xl, 2rem);
    }
    .dk-brand-story-media {
      order: -1;
    }
  }
</style>

{% schema %}
{
  "name": "DELISHA Brand Story",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "OUR HERITAGE & PASSION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Art of DELISHA KARIGARI"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Story Content",
      "default": "<p>Rooted in Indian artistry, DELISHA KARIGARI brings together traditional craftsmanship and contemporary design to create pieces made for meaningful celebrations.</p><p>Every creation is handcrafted with patience, reverence for detail, and a deep love for Indian heritage.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature / Tagline",
      "default": "— Handcrafted with love in India"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "READ OUR FULL STORY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Artisan / Story Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F2E5DD"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "DELISHA Brand Story"
    }
  ]
}
{% endschema %}
