{%- liquid
  assign eyebrow = section.settings.eyebrow | default: '✦ THOUGHTFUL CELEBRATIONS • BESPOKE GIFTING ✦'
  assign heading = section.settings.heading | default: 'The Art of Gifting, Handcrafted with Heart.'
  assign subheading = section.settings.subheading | default: 'From royal festive hampers and embellished potlis to sacred keepsakes — discover gifts designed to make every bond feel treasured.'
  assign primary_btn_text = section.settings.primary_btn_text | default: 'EXPLORE GIFTING COLLECTION →'
  assign primary_url = section.settings.primary_btn_link
  if primary_url == blank
    assign primary_url = routes.collections_url | append: '/for-her-accessories'
  endif
  assign secondary_btn_text = section.settings.secondary_btn_text | default: 'EXPLORE HAMPERS & POTLIS'
  assign secondary_url = section.settings.secondary_btn_link
  if secondary_url == blank
    assign secondary_url = routes.collections_url | append: '/for-her-accessories'
  endif
-%}

<section
  id="dk-gifting-banner-{{ section.id }}"
  class="dk-gifting-banner-sec"
  style="background-color: {{ section.settings.bg_color | default: '#F9F5EE' }}; padding-top: {{ section.settings.padding_top | default: 24 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 24 }}px;"
>
  <div class="dk-gifting-banner-wrapper {% if section.settings.full_width %}dk-gifting-banner-wrapper--full{% endif %}">
    <div class="dk-gifting-banner-card" id="gifting">
      
      <!-- BACKGROUND MEDIA -->
      <div class="dk-gifting-banner__media">
        <picture class="dk-gifting-banner__picture">
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }}">
          {%- else -%}
            <source media="(max-width: 767px)" srcset="{{ 'dk-banner-gifting-mobile.jpg' | asset_url }}">
          {%- endif -%}

          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 2000 }}"
              alt="{{ section.settings.image.alt | default: 'Delisha Karigari Bespoke Festive Gifting' | escape }}"
              class="dk-gifting-banner__img"
              loading="lazy"
              width="1920"
              height="720"
            >
          {%- else -%}
            <img
              src="{{ 'dk-banner-gifting.jpg' | asset_url }}"
              alt="Bespoke Festive Gifting & Luxury Hampers — Delisha Karigari"
              class="dk-gifting-banner__img"
              loading="lazy"
              width="1920"
              height="720"
            >
          {%- endif -%}
        </picture>
        <div class="dk-gifting-banner__overlay"></div>
      </div>

      <!-- EDITORIAL CONTENT (LEFT-ALIGNED) -->
      <div class="dk-gifting-banner__content-box">
        <div class="dk-gifting-banner__content">
          {%- if eyebrow != blank -%}
            <span class="dk-gifting-banner__eyebrow">{{ eyebrow }}</span>
          {%- endif -%}

          {%- if heading != blank -%}
            <h2 class="dk-gifting-banner__title">
              {{ heading | replace: 'The Art of Gifting, Handcrafted with Heart.', 'The Art of Gifting,<br class="dk-gb__br"> <em>Handcrafted with Heart.</em>' }}
            </h2>
          {%- endif -%}

          {%- if subheading != blank -%}
            <p class="dk-gifting-banner__subtitle">{{ subheading }}</p>
          {%- endif -%}

          <div class="dk-gifting-banner__actions">
            {%- if primary_btn_text != blank and primary_url != blank -%}
              <a href="{{ primary_url }}" class="dk-gifting-banner__btn-primary">
                {{ primary_btn_text }}
              </a>
            {%- endif -%}

            {%- if secondary_btn_text != blank and secondary_url != blank -%}
              <a href="{{ secondary_url }}" class="dk-gifting-banner__btn-secondary">
                {{ secondary_btn_text }}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .dk-gifting-banner-sec {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .dk-gifting-banner-wrapper {
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 2.5vw, 2.5rem);
    box-sizing: border-box;
  }
  .dk-gifting-banner-wrapper--full {
    max-width: 100%;
    padding: 0;
  }
  .dk-gifting-banner-card {
    position: relative;
    width: 100%;
    height: clamp(380px, 34vw, 460px);
    min-height: 380px;
    max-height: 480px;
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    box-shadow: 0 12px 36px rgba(45, 20, 15, 0.08);
    background-color: #211216;
  }
  .dk-gifting-banner-wrapper--full .dk-gifting-banner-card {
    border-radius: 0;
  }
  .dk-gifting-banner__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .dk-gifting-banner__picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .dk-gifting-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right 45%;
    display: block;
  }
  .dk-gifting-banner__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: linear-gradient(
      90deg,
      rgba(26, 10, 15, 0.88) 0%,
      rgba(26, 10, 15, 0.72) 34%,
      rgba(26, 10, 15, 0.25) 54%,
      rgba(26, 10, 15, 0.0) 68%
    );
  }
  .dk-gifting-banner__content-box {
    position: relative;
    z-index: 3;
    width: 100%;
    padding: clamp(2rem, 3.8vw, 3.5rem) clamp(1.75rem, 4.5vw, 4rem);
    box-sizing: border-box;
    display: flex;
    justify-content: flex-start;
  }
  .dk-gifting-banner__content {
    max-width: 530px;
    text-align: left;
    margin: 0;
  }
  .dk-gifting-banner__eyebrow {
    display: inline-block;
    color: #E9D8C5;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 2.2px;
    margin-bottom: 0.75rem;
    text-align: left;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }
  .dk-gifting-banner__title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(2rem, 3.2vw, 2.9rem);
    font-weight: 600;
    line-height: 1.18;
    color: #FFFFFF;
    margin: 0 0 0.85rem;
    text-align: left;
    letter-spacing: -0.2px;
    text-shadow: 0 3px 16px rgba(0, 0, 0, 0.5);
  }
  .dk-gifting-banner__title em {
    font-style: italic;
    font-weight: 400;
    color: #F8EAD4;
  }
  .dk-gb__br {
    display: block;
  }
  .dk-gifting-banner__subtitle {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: clamp(0.9rem, 1.08vw, 1rem);
    line-height: 1.6;
    color: rgba(248, 243, 235, 0.94);
    max-width: 470px;
    margin: 0 0 1.6rem;
    text-align: left;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }
  .dk-gifting-banner__actions {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    flex-wrap: wrap;
  }
  .dk-gifting-banner__btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #641A28;
    color: #FFFFFF;
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 1.6px;
    padding: 13px 26px;
    border-radius: 4px;
    text-decoration: none;
    border: 1px solid rgba(184, 154, 98, 0.6);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
    transition: all 0.3s ease;
  }
  .dk-gifting-banner__btn-primary:hover {
    background-color: #4A121D;
    border-color: #D4AF37;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(100, 26, 40, 0.5);
  }
  .dk-gifting-banner__btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(30, 12, 16, 0.65);
    color: #F8F3EB;
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 1.6px;
    padding: 13px 24px;
    border-radius: 4px;
    text-decoration: none;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.3s ease;
  }
  .dk-gifting-banner__btn-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: #FFFFFF;
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .dk-gifting-banner-card {
      height: clamp(440px, 75vh, 520px);
      min-height: 440px;
      max-height: 520px;
      align-items: flex-end;
      border-radius: 14px;
    }
    .dk-gifting-banner__img {
      object-position: center 25%;
    }
    .dk-gifting-banner__overlay {
      background: linear-gradient(
        180deg,
        rgba(20, 8, 12, 0.05) 0%,
        rgba(20, 8, 12, 0.32) 35%,
        rgba(20, 8, 12, 0.76) 62%,
        rgba(20, 8, 12, 0.96) 92%
      );
    }
    .dk-gifting-banner__content-box {
      justify-content: center;
      padding: 0 1.25rem 2.25rem;
    }
    .dk-gifting-banner__content {
      max-width: 100%;
      text-align: center;
      margin: 0 auto;
    }
    .dk-gifting-banner__eyebrow {
      font-size: 0.62rem;
      letter-spacing: 1.2px;
      text-align: center;
      margin-bottom: 0.5rem;
    }
    .dk-gifting-banner__title {
      font-size: clamp(1.4rem, 5.2vw, 1.85rem);
      line-height: 1.2;
      margin-bottom: 0.65rem;
      text-align: center;
    }
    .dk-gifting-banner__subtitle {
      font-size: 0.8rem;
      line-height: 1.45;
      margin-bottom: 1.25rem;
      max-width: 100%;
      text-align: center;
      padding: 0 8px;
    }
    .dk-gifting-banner__actions {
      justify-content: center;
      flex-direction: column;
      width: 100%;
      gap: 8px;
    }
    .dk-gifting-banner__btn-primary,
    .dk-gifting-banner__btn-secondary {
      width: 100%;
      max-width: 300px;
      padding: 11px 18px;
      font-size: 0.74rem;
      letter-spacing: 1.2px;
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "DK Gifting Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Banner Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Banner Image"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Banner",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "✦ THOUGHTFUL CELEBRATIONS • BESPOKE GIFTING ✦"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Art of Gifting, Handcrafted with Heart."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "From royal festive hampers and embellished potlis to sacred keepsakes — discover gifts designed to make every bond feel treasured."
    },
    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary Button Text",
      "default": "EXPLORE GIFTING COLLECTION →"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "EXPLORE HAMPERS & POTLIS"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F9F5EE"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "DK Gifting Banner"
    }
  ]
}
{% endschema %}
