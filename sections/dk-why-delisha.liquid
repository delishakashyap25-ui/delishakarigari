{%- liquid
  assign eyebrow = section.settings.eyebrow | default: '✦ THE DELISHA PROMISE ✦'
  assign heading = section.settings.heading | default: 'Not Just Made.<br> <em>Made Meaningful.</em>'
  assign description = section.settings.description | default: 'Every Delisha Karigari piece begins with a celebration in mind — a doorway waiting to be adorned, a gift waiting to be opened, or a moment waiting to be remembered.'
-%}

<section
  id="dk-why-delisha-{{ section.id }}"
  class="dk-why-sec"
  style="background-color: {{ section.settings.bg_color | default: '#FFFFFF' }}; padding-top: {{ section.settings.padding_top | default: 70 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 75 }}px;"
>
  <div class="dk-why-container">
    
    <!-- EDITORIAL HEADER -->
    <div class="dk-why-header">
      {%- if eyebrow != blank -%}
        <span class="dk-why-eyebrow">{{ eyebrow }}</span>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2 class="dk-why-title">{{ heading }}</h2>
      {%- endif -%}

      {%- if description != blank -%}
        <p class="dk-why-desc">{{ description }}</p>
      {%- endif -%}
    </div>

    <!-- 3 EDITORIAL PILLARS (NO GENERIC ICON CARDS) -->
    <div class="dk-why-pillars">
      
      <!-- PILLAR 1 -->
      <div class="dk-why-pillar">
        <span class="dk-why-num">01</span>
        <div class="dk-why-pillar-content">
          <h3 class="dk-why-pillar-title">{{ section.settings.p1_title | default: 'Thoughtfully Designed' }}</h3>
          <p class="dk-why-pillar-text">{{ section.settings.p1_text | default: 'Created around Indian celebrations, traditions and the people we celebrate with.' }}</p>
        </div>
      </div>

      <div class="dk-why-separator" aria-hidden="true"></div>

      <!-- PILLAR 2 -->
      <div class="dk-why-pillar">
        <span class="dk-why-num">02</span>
        <div class="dk-why-pillar-content">
          <h3 class="dk-why-pillar-title">{{ section.settings.p2_title | default: 'Made With Care' }}</h3>
          <p class="dk-why-pillar-text">{{ section.settings.p2_text | default: 'From intricate décor to personalised gifting, every detail is chosen with intention.' }}</p>
        </div>
      </div>

      <div class="dk-why-separator" aria-hidden="true"></div>

      <!-- PILLAR 3 -->
      <div class="dk-why-pillar">
        <span class="dk-why-num">03</span>
        <div class="dk-why-pillar-content">
          <h3 class="dk-why-pillar-title">{{ section.settings.p3_title | default: 'Celebration Ready' }}</h3>
          <p class="dk-why-pillar-text">{{ section.settings.p3_text | default: 'Beautifully curated pieces made to bring warmth, colour and character to your special moments.' }}</p>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .dk-why-sec {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .dk-why-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3.2vw, 36px);
    box-sizing: border-box;
  }
  .dk-why-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto clamp(40px, 4.5vw, 60px);
  }
  .dk-why-eyebrow {
    display: inline-block;
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: #8C2234;
    margin-bottom: 0.85rem;
  }
  .dk-why-title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(2.2rem, 3.4vw, 3rem);
    font-weight: 600;
    line-height: 1.2;
    color: #211216;
    margin: 0 0 1rem;
    letter-spacing: -0.3px;
  }
  .dk-why-title em {
    font-style: italic;
    font-weight: 400;
    color: #641A28;
  }
  .dk-why-desc {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: clamp(0.94rem, 1.1vw, 1.05rem);
    line-height: 1.7;
    color: #6A5B55;
    margin: 0 auto;
    max-width: 660px;
  }

  /* 3 EDITORIAL PILLARS */
  .dk-why-pillars {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(24px, 3vw, 48px);
  }
  .dk-why-pillar {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    position: relative;
    padding-top: 10px;
  }
  .dk-why-num {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: 1.75rem;
    font-weight: 400;
    font-style: italic;
    color: #B89A62;
    margin-bottom: 0.85rem;
    display: block;
    line-height: 1;
  }
  .dk-why-pillar-title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    font-weight: 600;
    color: #211216;
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }
  .dk-why-pillar-text {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.9rem;
    line-height: 1.65;
    color: #6A5B55;
    margin: 0;
  }
  .dk-why-separator {
    width: 1px;
    height: 120px;
    background: linear-gradient(180deg, transparent, #E6D8CA 25%, #E6D8CA 75%, transparent);
    flex-shrink: 0;
    margin-top: 25px;
  }

  @media (max-width: 900px) {
    .dk-why-pillars {
      flex-direction: column;
      gap: 36px;
    }
    .dk-why-separator {
      display: none;
    }
    .dk-why-pillar {
      width: 100%;
      border-bottom: 1px solid #ECE4D8;
      padding-bottom: 28px;
    }
    .dk-why-pillar:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
  }
</style>

{% schema %}
{
  "name": "DK Why Delisha",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "✦ THE DELISHA PROMISE ✦"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not Just Made.<br> <em>Made Meaningful.</em>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every Delisha Karigari piece begins with a celebration in mind — a doorway waiting to be adorned, a gift waiting to be opened, or a moment waiting to be remembered."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Pillar 1"
    },
    {
      "type": "text",
      "id": "p1_title",
      "label": "Pillar 1 Title",
      "default": "Thoughtfully Designed"
    },
    {
      "type": "textarea",
      "id": "p1_text",
      "label": "Pillar 1 Text",
      "default": "Created around Indian celebrations, traditions and the people we celebrate with."
    },
    {
      "type": "header",
      "content": "Pillar 2"
    },
    {
      "type": "text",
      "id": "p2_title",
      "label": "Pillar 2 Title",
      "default": "Made With Care"
    },
    {
      "type": "textarea",
      "id": "p2_text",
      "label": "Pillar 2 Text",
      "default": "From intricate décor to personalised gifting, every detail is chosen with intention."
    },
    {
      "type": "header",
      "content": "Pillar 3"
    },
    {
      "type": "text",
      "id": "p3_title",
      "label": "Pillar 3 Title",
      "default": "Celebration Ready"
    },
    {
      "type": "textarea",
      "id": "p3_text",
      "label": "Pillar 3 Text",
      "default": "Beautifully curated pieces made to bring warmth, colour and character to your special moments."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 75
    }
  ],
  "presets": [
    {
      "name": "DK Why Delisha"
    }
  ]
}
{% endschema %}
