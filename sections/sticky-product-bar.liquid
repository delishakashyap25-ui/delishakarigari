<!-- Sticky Bar -->
<div class="sticky-product-bar" id="StickyBar">
  <div class="prod-container sticky-inner">
    <div class="sticky-info">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 100 }}" alt="{{ product.title | escape }}" width="100" height="100">
      {% endif %}
      <div class="sticky-text">
        <span class="s-title">{{ product.title }}</span>
        <span class="s-price">{{ product.price | money }}</span>
      </div>
    </div>
    <div class="sticky-actions">
      <select class="sticky-select" {% if product.has_only_default_variant %}style="display: none;"{% endif %}>
        {% for variant in product.variants %}
          <option value="{{ variant.id }}">{{ variant.title }}</option>
        {% endfor %}
      </select>
      <button class="sticky-add-btn" onclick="ShopifyCart.addItem(this.closest('.sticky-actions'))">ADD TO CART</button>
    </div>
  </div>
</div>

<style>
.sticky-product-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fff;
  box-shadow: 0 -5px 20px rgba(0,0,0,0.1);
  padding: 15px 0;
  z-index: 999;
  transform: translateY(100%);
  transition: transform 0.3s;
}
.sticky-product-bar.visible { transform: translateY(0); }
.sticky-inner { display: flex; justify-content: space-between; align-items: center; }
.sticky-info { display: flex; align-items: center; gap: 15px; }
.sticky-info img { width: 50px; height: 50px; border-radius: 8px; object-fit: cover; }
.sticky-text { display: flex; flex-direction: column; }
.s-title { font-weight: 600; font-size: 14px; }
.s-price { color: #caa25d; font-size: 14px; }
.sticky-actions { display: flex; gap: 15px; }
.sticky-select { padding: 8px 15px; border-radius: 8px; border: 1px solid #ddd; }
.sticky-add-btn { background: #333; color: #fff; border: none; padding: 10px 25px; border-radius: 30px; cursor: pointer; font-weight: 600; }

.prod-container {
  width: 90%;
  max-width: 1300px;
  margin: 0 auto;
  padding: 0 20px;
}

@media(max-width: 768px) {
  .sticky-product-bar {
    padding: 10px 0;
  }
  .sticky-inner {
    padding: 0 15px;
    width: 100%;
    box-sizing: border-box;
  }
  .sticky-info {
    display: none !important;
  }
  .sticky-actions {
    width: 100%;
    display: flex;
    gap: 10px;
  }
  .sticky-select {
    flex: 1;
    min-width: 0;
    height: 48px;
    padding: 0 10px;
    font-size: 14px;
    box-sizing: border-box;
  }
  .sticky-add-btn {
    flex: 1.5;
    width: 100%;
    min-width: 0;
    height: 48px;
    padding: 0 15px;
    font-size: 14px;
    white-space: nowrap;
    text-align: center;
    border-radius: 24px;
    box-sizing: border-box;
  }
}
</style>

<script>
window.addEventListener('scroll', function() {
  const bar = document.getElementById('StickyBar');
  if (bar) {
    if (window.pageYOffset > 800) {
      bar.classList.add('visible');
    } else {
      bar.classList.remove('visible');
    }
  }
});
</script>

{% schema %}
{
  "name": "Sticky Product Bar",
  "settings": [],
  "presets": [
    {
      "name": "Sticky Product Bar"
    }
  ]
}
{% endschema %}
