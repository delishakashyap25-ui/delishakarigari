<section
  id="dk-occasion-grid-{{ section.id }}"
  class="dk-occasion-sec"
  style="background-color: {{ section.settings.bg_color | default: '#F2E5DD' }}; padding: {{ section.settings.padding_top | default: 40 }}px 0 {{ section.settings.padding_bottom | default: 45 }}px 0;"
>
  <div class="dk-occasion-container">
    <div class="dk-section-header text-center">
      {%- if section.settings.subheading != blank -%}
        <span class="dk-subtitle">{{ section.settings.subheading | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="dk-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="dk-description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    <div class="dk-occasion-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign card_title = block.settings.title | default: 'Occasion' -%}
          {%- assign card_desc = block.settings.description -%}
          {%- assign card_btn = block.settings.btn_text | default: 'Shop Now →' -%}
          {%- assign card_url = block.settings.link | default: routes.all_products_collection_url -%}

          <a href="{{ card_url }}" class="dk-occasion-card" {{ block.shopify_attributes }}>
            <div class="dk-occasion-card__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  alt="{{ card_title | escape }}"
                  class="dk-occasion-card__img"
                  loading="lazy"
                  width="900"
                  height="750"
                >
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}{%- assign fallback_img = 'dk-occ-diwali.jpg' -%}
                  {%- when 2 -%}{%- assign fallback_img = 'dk-occ-toran.jpg' -%}
                  {%- when 3 -%}{%- assign fallback_img = 'dk-occ-karwa.jpg' -%}
                  {%- when 4 -%}{%- assign fallback_img = 'dk-occ-her.jpg' -%}
                  {%- else -%}{%- assign fallback_img = 'dk-occ-diwali.jpg' -%}
                {%- endcase -%}
                <img
                  src="{{ fallback_img | asset_url }}"
                  alt="{{ card_title | escape }}"
                  class="dk-occasion-card__img"
                  loading="lazy"
                  width="900"
                  height="750"
                >
              {%- endif -%}
              <div class="dk-occasion-card__overlay"></div>
            </div>

            <div class="dk-occasion-card__content">
              <h3 class="dk-occasion-card__title">{{ card_title | escape }}</h3>
              {%- if card_desc != blank -%}
                <p class="dk-occasion-card__desc">{{ card_desc | escape }}</p>
              {%- endif -%}
              <span class="dk-occasion-card__btn">{{ card_btn | escape }}</span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- DEFAULT 4 FESTIVE OCCASION CARDS -->
        <a href="{{ routes.collections_url }}/diwali-decor" class="dk-occasion-card">
          <div class="dk-occasion-card__media">
            <img src="{{ 'dk-occ-diwali.jpg' | asset_url }}" alt="Diwali & Festive Home Decor" class="dk-occasion-card__img" loading="lazy" width="900" height="750">
            <div class="dk-occasion-card__overlay"></div>
          </div>
          <div class="dk-occasion-card__content">
            <h3 class="dk-occasion-card__title">DIWALI & FESTIVE DÉCOR</h3>
            <p class="dk-occasion-card__desc">Handmade urlis, diya holders & festive gifting hampers.</p>
            <span class="dk-occasion-card__btn">Shop Diwali Decor &rarr;</span>
          </div>
        </a>

        <a href="{{ routes.collections_url }}/bandhanwar" class="dk-occasion-card">
          <div class="dk-occasion-card__media">
            <img src="{{ 'dk-occ-toran.jpg' | asset_url }}" alt="Gates, Doors & Mandir Decor" class="dk-occasion-card__img" loading="lazy" width="900" height="750">
            <div class="dk-occasion-card__overlay"></div>
          </div>
          <div class="dk-occasion-card__content">
            <h3 class="dk-occasion-card__title">DOORS & MANDIR DÉCOR</h3>
            <p class="dk-occasion-card__desc">Auspicious Bandhanwars & ornate Latkans made with love.</p>
            <span class="dk-occasion-card__btn">Shop Torans & Latkans &rarr;</span>
          </div>
        </a>

        <a href="{{ routes.collections_url }}/karwa-chauth-special" class="dk-occasion-card">
          <div class="dk-occasion-card__media">
            <img src="{{ 'dk-occ-karwa.jpg' | asset_url }}" alt="Karwa Chauth Specials" class="dk-occasion-card__img" loading="lazy" width="900" height="750">
            <div class="dk-occasion-card__overlay"></div>
          </div>
          <div class="dk-occasion-card__content">
            <h3 class="dk-occasion-card__title">KARWA CHAUTH SPECIALS</h3>
            <p class="dk-occasion-card__desc">Exquisite handcrafted thali sets & sacred puja essentials.</p>
            <span class="dk-occasion-card__btn">Shop Karwa Chauth &rarr;</span>
          </div>
        </a>

        <a href="{{ routes.collections_url }}/for-her-accessories" class="dk-occasion-card">
          <div class="dk-occasion-card__media">
            <img src="{{ 'dk-occ-her.jpg' | asset_url }}" alt="Thoughtful Gifts for Her" class="dk-occasion-card__img" loading="lazy" width="900" height="750">
            <div class="dk-occasion-card__overlay"></div>
          </div>
          <div class="dk-occasion-card__content">
            <h3 class="dk-occasion-card__title">GIFTS FOR HER</h3>
            <p class="dk-occasion-card__desc">Artisanal hair accessories, earrings, potlis & more.</p>
            <span class="dk-occasion-card__btn">Shop Gifts for Her &rarr;</span>
          </div>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .dk-occasion-container {
    max-width: 1380px;
    margin: 0 auto;
    width: 100%;
    padding: 0 clamp(16px, 2.5vw, 32px);
    box-sizing: border-box;
  }
  .dk-occasion-sec .dk-section-header {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .dk-occasion-sec .dk-subtitle {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--dk-color-gold, #B89A62);
    display: block;
    margin-bottom: 4px;
  }
  .dk-occasion-sec .dk-heading {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(1.85rem, 3.2vw, 2.6rem);
    font-weight: 700;
    color: var(--dk-color-text, #252525);
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .dk-occasion-sec .dk-description {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: clamp(0.9rem, 1.15vw, 1.05rem);
    color: var(--dk-color-text-muted, #555555);
    margin: 6px auto 0 auto;
    max-width: 650px;
    line-height: 1.45;
  }
  .dk-occasion-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    width: 100%;
    box-sizing: border-box;
  }
  .dk-occasion-card {
    display: flex;
    flex-direction: column;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    background-color: var(--dk-color-white, #FFFFFF);
    border: 1px solid rgba(100, 26, 40, 0.12);
    box-shadow: 0 4px 18px rgba(100, 26, 40, 0.05);
    transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  .dk-occasion-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 14px 32px rgba(100, 26, 40, 0.14);
    border-color: rgba(184, 154, 98, 0.5);
  }
  .dk-occasion-card__media {
    position: relative;
    aspect-ratio: 1.15 / 1;
    width: 100%;
    overflow: hidden;
    background-color: #F9F5EE;
  }
  .dk-occasion-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transition: transform 0.65s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  .dk-occasion-card:hover .dk-occasion-card__img {
    transform: scale(1.05);
  }
  .dk-occasion-card__overlay {
    display: none;
  }
  .dk-occasion-card__content {
    position: relative;
    padding: 16px 16px 18px 16px;
    background-color: #FFFFFF;
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
    border-top: 1px solid rgba(184, 149, 82, 0.15);
  }
  .dk-occasion-card__title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(1rem, 1.15vw, 1.18rem);
    font-weight: 700;
    color: var(--dk-color-primary, #641A28);
    letter-spacing: 0.3px;
    margin: 0 0 6px 0;
    line-height: 1.25;
  }
  .dk-occasion-card__desc {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.82rem;
    color: #555555;
    margin: 0 0 12px 0;
    line-height: 1.4;
    font-weight: 400;
  }
  .dk-occasion-card__btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--dk-color-gold, #B89A62);
    transition: all 0.3s ease;
  }
  .dk-occasion-card:hover .dk-occasion-card__btn {
    color: var(--dk-color-primary, #641A28);
    transform: translateX(4px);
  }


  @media (max-width: 1100px) {
    .dk-occasion-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 580px) {
    .dk-occasion-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "DELISHA Shop by Occasion",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "RAKHI 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rakhi & Lumba, Curated by Delisha Karigari"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F2E5DD"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "occasion_tile",
      "name": "Occasion Tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Occasion Title",
          "default": "FOR BHAI"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short Description",
          "default": "Handcrafted Rakhis made with love."
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Label",
          "default": "Shop Rakhis →"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Occasion Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Tile Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DELISHA Shop by Occasion",
      "blocks": [
        { "type": "occasion_tile", "settings": { "title": "FOR BHAI", "description": "Handcrafted Rakhis made with love.", "btn_text": "Shop Rakhis →" } },
        { "type": "occasion_tile", "settings": { "title": "FOR BHABHI", "description": "Beautiful Lumbas for her special celebration.", "btn_text": "Shop Lumbas →" } },
        { "type": "occasion_tile", "settings": { "title": "FOR THE FAMILY", "description": "Thoughtful Rakhi sets made for gifting.", "btn_text": "Shop Rakhi Combos →" } }
      ]
    }
  ]
}
{% endschema %}
