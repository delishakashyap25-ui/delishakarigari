<script>
  function toggleDkMobileMenu() {
    const drawer = document.getElementById('dkMobileDrawer');
    const overlay = document.getElementById('dkMobileOverlay');
    const toggleBtn = document.getElementById('dkMobileToggle');
    if (!drawer || !overlay) return;

    const isActive = drawer.classList.contains('is-open');
    if (isActive) {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      document.body.classList.remove('overflow-hidden');
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
    } else {
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');
      document.body.classList.add('overflow-hidden');
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
    }
  }

  function toggleDkAccordion(btn) {
    const row = btn.closest('.dk-mobile-menu__row') || btn.closest('.dk-mobile-submenu__row');
    if (!row) return;
    const parentLi = row.parentElement;
    const subMenu = parentLi.querySelector('.dk-mobile-submenu, .dk-mobile-grandchild-menu');
    if (!subMenu) return;

    const isOpen = subMenu.style.display === 'block';
    if (isOpen) {
      subMenu.style.display = 'none';
      btn.classList.remove('is-open');
    } else {
      subMenu.style.display = 'block';
      btn.classList.add('is-open');
    }
  }

  /* DELIVERY LOCATION MODAL HANDLERS */
  function openDkLocationModal() {
    const modal = document.getElementById('dkLocationModal');
    if (modal) {
      modal.classList.add('is-active');
      document.body.classList.add('overflow-hidden');
      setTimeout(function() {
        const input = document.getElementById('dkPincodeInput');
        if (input) input.focus();
      }, 150);
    }
  }

  function closeDkLocationModal() {
    const modal = document.getElementById('dkLocationModal');
    if (modal) {
      modal.classList.remove('is-active');
      document.body.classList.remove('overflow-hidden');
    }
  }

  function dkSelectCity(cityName, pin) {
    const input = document.getElementById('dkPincodeInput');
    if (input) input.value = pin;
    dkApplyDeliveryLocation(cityName, pin);
  }

  function dkCheckPincode() {
    const input = document.getElementById('dkPincodeInput');
    const feedback = document.getElementById('dkPincodeFeedback');
    if (!input || !feedback) return;

    const pin = input.value.trim();
    if (!pin || pin.length !== 6 || !/^\d{6}$/.test(pin)) {
      feedback.className = 'dk-location-feedback dk-location-feedback--error';
      feedback.innerHTML = '⚠️ Please enter a valid 6-digit Indian PIN code.';
      feedback.style.display = 'block';
      return;
    }

    dkApplyDeliveryLocation(pin, pin);
  }

  function dkApplyDeliveryLocation(locationLabel, pin) {
    const feedback = document.getElementById('dkPincodeFeedback');
    const btnText = document.getElementById('dkLocationBtnText');
    const mobileCity = document.getElementById('dkMobileLocationCity');
    const mobilePin = document.getElementById('dkMobileLocationPin');

    if (feedback) {
      feedback.className = 'dk-location-feedback dk-location-feedback--success';
      feedback.innerHTML = '✓ <strong>Delivery available to ' + locationLabel + '!</strong><br>Express dispatch in 2–4 business days with free shipping.';
      feedback.style.display = 'block';
    }

    if (btnText) {
      btnText.textContent = 'Deliver to ' + locationLabel;
    }
    if (mobileCity) {
      mobileCity.textContent = locationLabel;
    }
    if (mobilePin) {
      mobilePin.textContent = (pin && pin !== locationLabel) ? pin : '';
      mobilePin.style.display = (pin && pin !== locationLabel) ? 'inline' : 'none';
    }

    try {
      localStorage.setItem('dk_user_delivery_pin', pin);
      localStorage.setItem('dk_user_delivery_label', locationLabel);
    } catch(e) {}

    setTimeout(function() {
      closeDkLocationModal();
    }, 1200);
  }

  // Restore saved delivery location on page load
  document.addEventListener('DOMContentLoaded', function() {
    try {
      const savedLabel = localStorage.getItem('dk_user_delivery_label') || 'Bengaluru';
      const savedPin = localStorage.getItem('dk_user_delivery_pin') || '560001';
      const btnText = document.getElementById('dkLocationBtnText');
      const mobileCity = document.getElementById('dkMobileLocationCity');
      const mobilePin = document.getElementById('dkMobileLocationPin');

      if (btnText) {
        btnText.textContent = 'Deliver to ' + savedLabel;
      }
      if (mobileCity) {
        mobileCity.textContent = savedLabel;
      }
      if (mobilePin) {
        mobilePin.textContent = (savedPin && savedPin !== savedLabel) ? savedPin : '';
        mobilePin.style.display = (savedPin && savedPin !== savedLabel) ? 'inline' : 'none';
      }
    } catch(e) {}
  });

  // Rotating Announcement Bar Slider (One by One)
  (function initAnnouncementSlider() {
    function startSlider() {
      const slider = document.getElementById('dkAnnouncementSlider');
      if (!slider) return;
      const slides = slider.querySelectorAll('.dk-announcement-slide');
      if (slides.length <= 1) return;

      let current = 0;
      setInterval(function() {
        const prev = current;
        current = (current + 1) % slides.length;

        slides[prev].classList.remove('is-active');
        slides[prev].classList.add('is-exiting');

        setTimeout(function() {
          slides[prev].classList.remove('is-exiting');
        }, 500);

        slides[current].classList.add('is-active');
      }, 3200);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startSlider);
    } else {
      startSlider();
  })();

  // Compact Transition on Scroll (Ratnaya-Style Persistent Sticky Header)
  (function initStickyHeader() {
    function startSticky() {
      const header = document.getElementById('dkHeader');
      if (!header) return;
      let ticking = false;

      function updateStickyState() {
        const top = window.pageYOffset || document.documentElement.scrollTop || 0;
        if (top > 40) {
          header.classList.add('dk-header--scrolled');
        } else {
          header.classList.remove('dk-header--scrolled');
        }
        ticking = false;
      }

      window.addEventListener('scroll', function() {
        if (!ticking) {
          window.requestAnimationFrame(updateStickyState);
          ticking = true;
        }
      }, { passive: true });

      updateStickyState();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startSticky);
    } else {
      startSticky();
    }
  })();
</script>

