<div id="hero--{{ section.id }}" class="elinor-hero-banner-section"
  aria-label="{{ section.settings.accessibility_label | default: 'Hero Banner' }}">
  <div class="elinor-hero-slider-container" data-autoplay="{{ section.settings.enable_autoplay }}"
    data-speed="{{ section.settings.autoplay_speed | default: 5 | times: 1000 }}">

    <div class="elinor-hero-slides-wrapper">
      {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
      <div class="elinor-hero-slide {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}
        data-index="{{ forloop.index0 }}">
        <div class="elinor-hero-bg">
          {%- if block.settings.image != blank or block.settings.image_mobile != blank or section.settings.image !=
          blank or section.settings.image_mobile != blank -%}
          <picture class="elinor-hero-picture">
            {%- if block.settings.image_mobile != blank -%}
            <source media="(max-width: 768px)" srcset="{{ block.settings.image_mobile | image_url: width: 1200 }}">
            {%- elsif section.settings.image_mobile != blank -%}
            <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">
            {%- endif -%}

            {%- if block.settings.image != blank -%}
            {{
            block.settings.image
            | image_url: width: 3840
            | image_tag:
            width: block.settings.image.width,
            sizes: '100vw',
            widths: '375, 550, 750, 1100, 1500, 2000, 3000, 3840',
            fetchpriority: 'high',
            class: 'elinor-hero-img'
            }}
            {%- elsif section.settings.image != blank -%}
            {{
            section.settings.image
            | image_url: width: 3840
            | image_tag:
            width: section.settings.image.width,
            sizes: '100vw',
            widths: '375, 550, 750, 1100, 1500, 2000, 3000, 3840',
            fetchpriority: 'high',
            class: 'elinor-hero-img'
            }}
            {%- elsif block.settings.image_mobile != blank -%}
            <img src="{{ block.settings.image_mobile | image_url: width: 1200 }}" class="elinor-hero-img" alt="Hero Mobile Image" loading="lazy" width="1200" height="800">
                  {%- else -%}
            <img src="{{ section.settings.image_mobile | image_url: width: 1200 }}" class="elinor-hero-img" alt="Hero Mobile Image" loading="lazy" width="1200" height="800">
                  {%- endif -%}
          </picture>
          {%- else -%}
          <div class="elinor-hero-placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
          {%- endif -%}

          {%- if section.settings.show_overlay -%}
          <div class="elinor-hero-overlay"
            style="background-color: {{ section.settings.overlay_color | default: '#000000' }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
          </div>
          {%- endif -%}
        </div>

        <div class="elinor-hero-content-wrapper" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;">
          <div class="elinor-hero-content-box" style="position: absolute; top: {{ block.settings.btn_pos_y }}%; left: {{ block.settings.btn_pos_x }}%; transform: translate(-50%, -50%); pointer-events: auto; text-align: center;">
            {%- if block.settings.subtitle != blank -%}
            <div class="elinor-hero-subtitle">
              {{ block.settings.subtitle }}
            </div>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
            <h1 class="elinor-hero-heading">
              {{ block.settings.heading }}
            </h1>
            {%- endif -%}

            {%- if block.settings.badge_text != blank -%}
            <div class="elinor-hero-badge">
              {{ block.settings.badge_text }}
            </div>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link | default: '#' }}" class="elinor-hero-btn">
              {{ block.settings.button_label }}
            </a>
            {%- endif -%}
          </div>
        </div>
      </div>
      {%- endfor -%}
      {%- else -%}
      <!-- Fallback Single Slide -->
      <div class="elinor-hero-slide active" data-index="0">
        <div class="elinor-hero-bg">
          {%- if section.settings.image != blank or section.settings.image_mobile != blank -%}
          <picture class="elinor-hero-picture">
            {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">
            {%- endif -%}

            {%- if section.settings.image != blank -%}
            {{
            section.settings.image
            | image_url: width: 3840
            | image_tag:
            width: section.settings.image.width,
            sizes: '100vw',
            widths: '375, 550, 750, 1100, 1500, 2000, 3000, 3840',
            fetchpriority: 'high',
            class: 'elinor-hero-img'
            }}
            {%- else -%}
            <img src="{{ section.settings.image_mobile | image_url: width: 1200 }}" class="elinor-hero-img" alt="Hero Mobile Image" loading="lazy" width="1200" height="800">
                {%- endif -%}
          </picture>
          {%- else -%}
          <div class="elinor-hero-placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
          {%- endif -%}

          {%- if section.settings.show_overlay -%}
          <div class="elinor-hero-overlay"
            style="background-color: {{ section.settings.overlay_color | default: '#000000' }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
          </div>
          {%- endif -%}
        </div>

        <div class="elinor-hero-content-wrapper" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;">
          <div class="elinor-hero-content-box" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: auto; text-align: center;">
            {%- if section.settings.subtitle != blank -%}
            <div class="elinor-hero-subtitle">
              {{ section.settings.subtitle }}
            </div>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
            <h1 class="elinor-hero-heading">
              {{ section.settings.heading }}
            </h1>
            {%- endif -%}

            {%- if section.settings.badge_text != blank -%}
            <div class="elinor-hero-badge">
              {{ section.settings.badge_text }}
            </div>
            {%- endif -%}

            {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link | default: '#' }}" class="elinor-hero-btn">
              {{ section.settings.button_label }}
            </a>
            {%- endif -%}
          </div>
        </div>
      </div>
      {%- endif -%}
    </div>

    {%- assign total_slides = section.blocks.size -%}
    {%- if total_slides > 1 -%}
    {%- if section.settings.show_arrows -%}
    <button type="button" class="elinor-hero-arrow prev" aria-label="Previous slide">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
    <button type="button" class="elinor-hero-arrow next" aria-label="Next slide">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
    {%- endif -%}

    {%- if section.settings.show_dots -%}
    <div class="elinor-hero-dots">
      {%- for block in section.blocks -%}
      <button type="button" class="elinor-hero-dot {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
    {%- endif -%}
    {%- endif -%}

  </div>
</div>
<!-- DELISHA RAKHI MARQUEE -->
<div class="delisha-rakhi-strip">
  <div class="delisha-rakhi-track" id="delishaRakhiTrack">

    <div class="delisha-rakhi-content">
