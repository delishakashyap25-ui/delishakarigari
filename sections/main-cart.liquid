{%- comment -%} Fonts loaded globally in theme.liquid {%- endcomment -%}

<div class="cart-page-section padding-{{ section.id }}"
  style="background-color: {{ section.settings.bg_color | default: '#fdfaf5' }}; min-height: 70vh;">
  <div class="cart-page-container">

    <!-- Breadcrumb -->
    <nav class="cart-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="sep">›</span>
      <span class="current">Your Shopping Cart</span>
    </nav>

    <!-- Page Title Header -->
    <div class="cart-header">
      <h1 class="cart-title">
        Your Cart
        {% if cart.item_count > 0 %}
        <span class="cart-count-badge">({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span>
        {% endif %}
      </h1>
    </div>

    {% if cart.item_count == 0 %}
    <!-- EMPTY CART STATE -->
    <div class="cart-empty-wrapper">
      <div class="cart-empty-icon">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#d8a85e" stroke-width="1.5">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </div>
      <h2 class="cart-empty-title">Your cart is currently empty</h2>
      <p class="cart-empty-text">Explore our handcrafted jewellery and festive collections to find something special.
      </p>
      <a href="{{ routes.collections_url }}" class="btn-shop-now">
        EXPLORE COLLECTIONS
      </a>
    </div>

    {% else %}

    <!-- CART CONTENT WITH ITEMS -->
    <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" class="cart-form-layout">

      <!-- LEFT COLUMN: LINE ITEMS LIST -->
      <div class="cart-items-column">
        <div class="cart-items-header desktop-only">
          <span class="col-product">PRODUCT</span>
          <span class="col-price">PRICE</span>
          <span class="col-qty">QUANTITY</span>
          <span class="col-total">TOTAL</span>
        </div>

        <div class="cart-items-list">
          {% for item in cart.items %}
          <div class="cart-item-card" data-key="{{ item.key }}">

            <!-- Product Image -->
            <div class="cart-item-image">
              <a href="{{ item.url }}">
                {% if item.image %}
                <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" loading="lazy" width="300" height="300">
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
              </a>
            </div>

            <!-- Product Info -->
            <div class="cart-item-info">
              <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title }}</a>

              {% unless item.product.has_only_default_variant %}
              <div class="cart-item-variant">{{ item.variant.title }}</div>
              {% endunless %}

              {% if item.selling_plan_allocation %}
              <div class="cart-item-plan">{{ item.selling_plan_allocation.selling_plan.name }}</div>
              {% endif %}

              <div class="cart-item-unit-price">
                {% if item.original_price != item.final_price %}
                <s class="original-price">{{ item.original_price | money }}</s>
                <span class="discounted-price">{{ item.final_price | money }}</span>
                {% else %}
                <span>{{ item.final_price | money }}</span>
                {% endif %}
              </div>
            </div>

            <!-- Quantity Controls -->
            <div class="cart-item-qty">
              <div class="qty-selector">
                <button type="button" class="qty-btn qty-minus" data-key="{{ item.key }}" aria-label="Decrease quantity">-</button>
                <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" class="qty-input" data-key="{{ item.key }}" aria-label="Item quantity">
                <button type="button" class="qty-btn qty-plus" data-key="{{ item.key }}" aria-label="Increase quantity">+</button>
              </div>
            </div>

            <!-- Line Item Price -->
            <div class="cart-item-total">
              {% if item.original_line_price != item.final_line_price %}
              <s class="original-price">{{ item.original_line_price | money }}</s>
              <span class="line-total">{{ item.final_line_price | money }}</span>
              {% else %}
              <span class="line-total">{{ item.final_line_price | money }}</span>
              {% endif %}
            </div>

            <!-- Remove Item -->
            <div class="cart-item-remove">
              <a href="{{ item.url_to_remove }}" class="btn-remove-item" title="Remove item"
                aria-label="Remove {{ item.title | escape }}">
                &times;
              </a>
            </div>

          </div>
          {% endfor %}
        </div>

        <!-- Continue Shopping Link -->
        <div class="cart-actions-bar">
          <a href="{{ routes.collections_url }}" class="btn-continue-link">
            ← Continue Shopping
          </a>
          <button type="submit" name="update" class="btn-update-cart">
              Update Cart
            </button>
        </div>
      </div>

      <!-- RIGHT COLUMN: ORDER SUMMARY CARD -->
      <div class="cart-summary-column">
        <div class="summary-card">
          <h2 class="summary-title">Order Summary</h2>

          <div class="summary-row">
            <span>Subtotal</span>
            <span class="summary-value subtotal-price">{{ cart.total_price | money }}</span>
          </div>

          {% if cart.total_discounts > 0 %}
          <div class="summary-row discount-row">
            <span>Total Discounts</span>
            <span class="summary-value discount-value">-{{ cart.total_discounts | money }}</span>
          </div>
          {% endif %}

          <div class="summary-shipping-note">
            <span class="badge-free-shipping">✦ Free Shipping Sitewide</span>
            <p class="taxes-note">Taxes and shipping calculated at checkout.</p>
          </div>

          <div class="summary-actions">
            <a href="/checkout" class="btn-checkout">
              PROCEED TO CHECKOUT 🔒
            </a>
          </div>

          <div class="trust-guarantees">
            <div class="trust-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
              <span>100% Handcrafted</span>
            </div>
            <div class="trust-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
              <span>Encrypted Secure Checkout</span>
            </div>
            <div class="trust-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="3" width="15" height="13" />
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
                <circle cx="5.5" cy="18.5" r="2.5" />
                <circle cx="18.5" cy="18.5" r="2.5" />
              </svg>
              <span>Fast & Safe Delivery</span>
            </div>
          </div>

        </div>
      </div>

    </form>

    {% endif %}

  </div>
</div>

<style>
  /* =========================================
   DELISHA KARIGARI PREMIUM CART PAGE STYLES
   ========================================= */

  .cart-page-section {
    font-family: var(--font-body, 'Poppins', sans-serif);
    padding: 40px 0 80px 0;
    color: #111111;
  }

  .cart-page-container {
    width: 90%;
    max-width: 1280px;
    margin: 0 auto;
  }

  /* Breadcrumb */
  .cart-breadcrumb {
    font-size: 13px;
    color: #666666;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cart-breadcrumb a {
    color: #333333;
    text-decoration: none;
    font-weight: 500;
  }

  .cart-breadcrumb a:hover {
    color: #d8a85e;
  }

  .cart-breadcrumb .sep {
    opacity: 0.5;
  }

  /* Page Header */
  .cart-header {
    margin-bottom: 35px;
    border-bottom: 1px solid #ebdcd0;
    padding-bottom: 15px;
  }

  .cart-title {
    font-family: var(--font-heading, 'Playfair Display', serif);
    font-size: 36px;
    font-weight: 700;
    color: #111111;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cart-count-badge {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    font-weight: 500;
    color: #777777;
  }

  /* Empty State */
  .cart-empty-wrapper {
    background: #ffffff;
    border: 1px solid #ebdcd0;
    border-radius: 16px;
    padding: 80px 20px;
    text-align: center;
    max-width: 600px;
    margin: 40px auto;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .cart-empty-icon {
    margin-bottom: 20px;
  }

  .cart-empty-title {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 600;
    margin: 0 0 10px 0;
    color: #111111;
  }

  .cart-empty-text {
    font-size: 15px;
    color: #666666;
    margin: 0 0 30px 0;
  }

  .btn-shop-now {
    display: inline-block;
    background: #4a1525;
    color: #ffffff;
    padding: 14px 36px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-decoration: none;
    transition: background 0.3s ease, transform 0.2s ease;
  }

  .btn-shop-now:hover {
    background: #d8a85e;
    transform: translateY(-2px);
  }

  /* Layout Grid */
  .cart-form-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 40px;
    align-items: start;
  }

  /* Left Column: Items Header */
  .cart-items-header {
    display: grid;
    grid-template-columns: 3fr 1fr 1.5fr 1fr 40px;
    gap: 15px;
    padding: 12px 20px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #777777;
    border-bottom: 1px solid #ebdcd0;
    text-transform: uppercase;
  }

  .col-total {
    text-align: right;
  }

  /* Items List */
  .cart-items-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 15px;
  }

  .cart-item-card {
    background: #ffffff;
    border: 1px solid #ebdcd0;
    border-radius: 12px;
    padding: 20px;
    display: grid;
    grid-template-columns: 100px 2fr 1.5fr 1fr 40px;
    align-items: center;
    gap: 20px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    transition: box-shadow 0.3s ease;
  }

  .cart-item-card:hover {
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.07);
  }

  .cart-item-image img {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }

  .cart-item-title {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    font-weight: 600;
    color: #111111;
    text-decoration: none;
    line-height: 1.3;
    display: block;
    transition: color 0.2s ease;
  }

  .cart-item-title:hover {
    color: #d8a85e;
  }

  .cart-item-variant {
    font-size: 13px;
    color: #777777;
    margin-top: 4px;
  }

  .cart-item-unit-price {
    font-size: 14px;
    font-weight: 500;
    color: #555555;
    margin-top: 6px;
  }

  .cart-item-unit-price .original-price {
    color: #999999;
    margin-right: 6px;
    font-size: 13px;
  }

  /* Quantity Selector */
  .qty-selector {
    display: inline-flex;
    align-items: center;
    border: 1px solid #dddddd;
    border-radius: 6px;
    background: #fdfdfd;
    overflow: hidden;
  }

  .qty-btn {
    background: transparent;
    border: none;
    width: 34px;
    height: 36px;
    font-size: 16px;
    font-weight: 600;
    color: #333333;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .qty-btn:hover {
    background: #f0f0f0;
  }

  .qty-input {
    width: 40px;
    height: 36px;
    border: none;
    text-align: center;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    color: #111111;
    outline: none;
    -webkit-appearance: textfield;
    -moz-appearance: textfield;
  }

  .qty-input::-webkit-outer-spin-button,
  .qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-item-total {
    font-size: 16px;
    font-weight: 700;
    color: #111111;
    text-align: right;
  }

  .btn-remove-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #999999;
    text-decoration: none;
    font-size: 22px;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .btn-remove-item:hover {
    color: #c5221f;
    background: #fce8e6;
  }

  /* Actions Bar below items */
  .cart-actions-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 25px;
  }

  .btn-continue-link {
    color: #4a1525;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .btn-continue-link:hover {
    color: #d8a85e;
  }

  .btn-update-cart {
    background: #f0e6dd;
    color: #4a1525;
    border: 1px solid #ebdcd0;
    padding: 10px 22px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .btn-update-cart:hover {
    background: #ebdcd0;
  }

  /* Right Column: Summary Card */
  .summary-card {
    background: #ffffff;
    border: 1px solid #ebdcd0;
    border-radius: 16px;
    padding: 30px 25px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
    position: sticky;
    top: 100px;
  }

  .summary-title {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 600;
    color: #111111;
    margin: 0 0 20px 0;
    border-bottom: 1px solid #f0f0f0;
    padding-bottom: 15px;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 15px;
    color: #444444;
    margin-bottom: 14px;
  }

  .subtotal-price {
    font-size: 22px;
    font-weight: 700;
    color: #111111;
  }

  .discount-row {
    color: #137333;
  }

  .summary-shipping-note {
    background: #fdf8f3;
    border: 1px dashed #d8a85e;
    border-radius: 8px;
    padding: 12px 15px;
    margin: 20px 0;
    text-align: center;
  }

  .badge-free-shipping {
    font-size: 12px;
    font-weight: 700;
    color: #4a1525;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    display: block;
    margin-bottom: 4px;
  }

  .taxes-note {
    font-size: 12px;
    color: #777777;
    margin: 0;
  }

  .summary-actions {
    margin-top: 25px;
  }

  .btn-checkout {
    display: block;
    width: 100%;
    background: #4a1525;
    color: #ffffff;
    border: none;
    padding: 16px;
    border-radius: 8px;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.2px;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    box-sizing: border-box;
    transition: background 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
    box-shadow: 0 6px 20px rgba(74, 21, 37, 0.25);
  }

  .btn-checkout:hover {
    background: #330b17;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(74, 21, 37, 0.35);
  }

  /* Trust Guarantees */
  .trust-guarantees {
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px solid #f0f0f0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: #555555;
    font-weight: 500;
  }

  .trust-item svg {
    color: #d8a85e;
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 991px) {
    .cart-form-layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .cart-item-card {
      grid-template-columns: 80px 1fr 40px;
      grid-template-areas:
        "img info remove"
        "img qty total";
      gap: 12px;
    }

    .cart-item-image {
      grid-area: img;
    }

    .cart-item-info {
      grid-area: info;
    }

    .cart-item-remove {
      grid-area: remove;
      justify-self: end;
    }

    .cart-item-qty {
      grid-area: qty;
    }

    .cart-item-total {
      grid-area: total;
      justify-self: end;
    }

    .cart-item-image img {
      width: 80px;
      height: 80px;
    }

    .desktop-only {
      display: none !important;
    }

    .summary-card {
      position: static;
    }
  }
</style>

<script>
  (function() {
    function initCartPage() {
      // Plus & Minus Quantity Controls
      document.querySelectorAll('.qty-btn').forEach(btn => {
        btn.onclick = function() {
          const key = this.getAttribute('data-key');
          const input = document.getElementById('updates_' + key);
          if (!input) return;
          
          let val = parseInt(input.value, 10) || 0;
          if (this.classList.contains('qty-plus')) {
            val += 1;
          } else if (this.classList.contains('qty-minus')) {
            val = Math.max(0, val - 1);
          }
          input.value = val;
          
          // Submit form automatically to update cart values
          const form = document.getElementById('CartPageForm');
          if (form) form.submit();
        };
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCartPage);
    } else {
      initCartPage();
    }
  })();
</script>

{% schema %}
{
"name": "Main Cart",
"settings": [
{
"type": "color",
"id": "bg_color",
"label": "Background Color",
"default": "#fdfaf5"
}
]
}
{% endschema %}