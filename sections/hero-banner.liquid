}

}
</style>
<style>
  .elinor-hero-banner-section {
    position: relative;
    width: 100%;
  }

  .elinor-hero-slider-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #1a1a1a;
    {% if section.settings.height_mode == 'cover' %}
      height: 75vh;
      min-height: 450px;
    {% elsif section.settings.height_mode == 'adapt' %}
      height: auto;
      aspect-ratio: 16 / 9;
    {% else %}
      height: {{ section.settings.desktop_height | default: 625 }}px;
      min-height: {{ section.settings.desktop_height | default: 625 }}px;
    {% endif %}
  }

  .elinor-hero-slides-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: inherit;
  }

  .elinor-hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease-in-out, visibility 0.8s ease-in-out;
    display: flex;
    align-items: center;
    z-index: 1;
  }

  .elinor-hero-slide.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  .elinor-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .elinor-hero-picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .elinor-hero-img {
    width: 100%;
    height: 100%;

    object-fit: {
        {
        section.settings.image_fit | default: 'cover'
      }
    }

    ;
    object-position: center;
  }

  .elinor-hero-placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .elinor-hero-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  .elinor-hero-content-wrapper {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 40px 60px;
    box-sizing: border-box;
    display: flex;
  }

  .elinor-hero-content-wrapper.align-left {
    justify-content: flex-start;
  }

  .elinor-hero-content-wrapper.align-left .elinor-hero-content-box {
    align-items: flex-start;
    text-align: left;
  }

  .elinor-hero-content-wrapper.align-center {
    justify-content: center;
  }

  .elinor-hero-content-wrapper.align-center .elinor-hero-content-box {
    align-items: center;
    text-align: center;
  }

  .elinor-hero-content-wrapper.align-right {
    justify-content: flex-end;
  }

  .elinor-hero-content-wrapper.align-right .elinor-hero-content-box {
    align-items: flex-end;
    text-align: right;
  }

  .elinor-hero-content-box {
    max-width: 580px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Subtitle */
  .elinor-hero-subtitle {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 34px;
    font-weight: 400;
    color: #ffffff;
    line-height: 1.2;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  /* Heading */
  .elinor-hero-heading {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 52px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.1;
    margin: 0;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  /* Offer Badge */
  .elinor-hero-badge {
    background-color: #fbf0e8;
    color: #4a1525;
    padding: 12px 32px;
    border-radius: 4px;
    font-family: 'Poppins', sans-serif;
    font-size: 30px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
    margin-top: 10px;
    display: inline-block;
  }

  .elinor-hero-badge em,
  .elinor-hero-badge i {
    font-style: italic;
    font-weight: 800;
  }

  /* Button */
  .elinor-hero-btn {
    display: inline-block;
    padding: 14px 40px;
    background-color: #4a1525;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    margin-top: 10px;
    transition: all 0.3s ease;
  }

  .elinor-hero-btn:hover {
    background-color: #2c0b15;
    transform: translateY(-2px);
  }

  /* Slider Navigation Controls */
  .elinor-hero-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(0, 0, 0, 0.4);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    backdrop-filter: blur(4px);
  }

  .elinor-hero-arrow:hover {
    background: rgba(74, 21, 37, 0.9);
    border-color: #ffffff;
  }

  .elinor-hero-arrow.prev {
    left: 20px;
  }

  .elinor-hero-arrow.next {
    right: 20px;
  }

  .elinor-hero-dots {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .elinor-hero-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .elinor-hero-dot.active,
  .elinor-hero-dot:hover {
    background: #ffffff;
    width: 28px;
    border-radius: 6px;
  }

  @media (max-width: 991px) {
    .elinor-hero-slider-container {
      {% if section.settings.mobile_height_mode == 'cover' %}
        height: 60vh;
        min-height: 380px;
      {% elsif section.settings.mobile_height_mode == 'adapt' %}
        height: auto;
        aspect-ratio: 3 / 4;
      {% else %}
        height: {{ section.settings.mobile_height | default: 480 }}px;
        min-height: {{ section.settings.mobile_height | default: 480 }}px;
      {% endif %}
    }

    .elinor-hero-content-wrapper {
      padding: 30px 20px;
      justify-content: center !important;
      align-items: flex-start;
      padding-top: 50px;
    }

    .elinor-hero-content-box {
      align-items: center !important;
      text-align: center !important;
    }

    .elinor-hero-subtitle {
      font-size: 22px;
    }

    .elinor-hero-heading {
      font-size: 32px;
    }

    .elinor-hero-badge {
      font-size: 18px;
      padding: 8px 18px;
    }

    .elinor-hero-arrow {
      width: 36px;
      height: 36px;
    }
  }

  @media (max-width: 576px) {
    .elinor-hero-subtitle {
      font-size: 20px;
    }

    .elinor-hero-heading {
      font-size: 28px;
    }

    .elinor-hero-badge {
      font-size: 16px;
      padding: 6px 14px;
    }

    .elinor-hero-btn {
      padding: 10px 28px;
      font-size: 12px;
      letter-spacing: 1px;
    }

    .elinor-hero-arrow.prev {
      left: 10px;
    }

    .elinor-hero-arrow.next {
      right: 10px;
    }
  }
</style>

<script>
  (function() {
    function initHeroSlider() {
      var container = document.querySelector('#hero--{{ section.id }} .elinor-hero-slider-container');
      if (!container) return;
      
      var slides = container.querySelectorAll('.elinor-hero-slide');
      var dots = container.querySelectorAll('.elinor-hero-dot');
      var prevBtn = container.querySelector('.elinor-hero-arrow.prev');
      var nextBtn = container.querySelector('.elinor-hero-arrow.next');
      if (slides.length <= 1) return;
      
      var currentIndex = 0;
      var timer = null;
      var autoplay = container.getAttribute('data-autoplay') === 'true';
      var speed = parseInt(container.getAttribute('data-speed'), 10) || 5000;
      
      function goToSlide(index) {
        if (index < 0) index = slides.length - 1;
        if (index >= slides.length) index = 0;
        
        for (var i = 0; i < slides.length; i++) {
          if (i === index) {
            slides[i].classList.add('active');
          } else {
            slides[i].classList.remove('active');
          }
        }
        
        for (var j = 0; j < dots.length; j++) {
          if (j === index) {
            dots[j].classList.add('active');
          } else {
            dots[j].classList.remove('active');
          }
        }
        
        currentIndex = index;
      }
      
      function nextSlide() {
        goToSlide(currentIndex + 1);
      }
      
      function prevSlide() {
        goToSlide(currentIndex - 1);
      }
      
      function startAutoplay() {
        if (!autoplay) return;
        stopAutoplay();
        timer = setInterval(nextSlide, speed);
      }
      
      function stopAutoplay() {
        if (timer) clearInterval(timer);
      }
      
      if (nextBtn) {
        nextBtn.onclick = function() {
          nextSlide();
          startAutoplay();
        };
      }
      if (prevBtn) {
        prevBtn.onclick = function() {
          prevSlide();
          startAutoplay();
        };
      }
      
      dots.forEach(function(dot) {
        dot.onclick = function() {
          var idx = parseInt(this.getAttribute('data-slide'), 10);
          goToSlide(idx);
          startAutoplay();
        };
      });
      
      container.onmouseenter = stopAutoplay;
      container.onmouseleave = startAutoplay;
      
      var touchStartX = 0;
      var touchEndX = 0;
      container.ontouchstart = function(e) {
        touchStartX = e.changedTouches[0].screenX;
      };
      container.ontouchend = function(e) {
        touchEndX = e.changedTouches[0].screenX;
        if (touchStartX - touchEndX > 40) {
          nextSlide();
          startAutoplay();
        } else if (touchEndX - touchStartX > 40) {
          prevSlide();
          startAutoplay();
        }
      };
      
      startAutoplay();

      // Theme Customizer live editor block selection listener
      if (window.Shopify && Shopify.designMode) {
        document.addEventListener('shopify:block:select', function(event) {
          if (event.detail.sectionId === '{{ section.id }}') {
            stopAutoplay();
            var targetBlock = container.querySelector('[data-shopify-editor-block*="' + event.detail.blockId + '"]');
            if (targetBlock && targetBlock.getAttribute('data-index')) {
              var idx = parseInt(targetBlock.getAttribute('data-index'), 10);
              goToSlide(idx);
            }
          }
        });
        document.addEventListener('shopify:block:deselect', function(event) {
          if (event.detail.sectionId === '{{ section.id }}') {
            startAutoplay();
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSlider);
    } else {
      initHeroSlider();
    }
  })();
</script>
<script>
  (function () {

  function initDelishaRakhiMarquee() {

    var track = document.getElementById('delishaRakhiTrack');

    if (!track) return;

    var original = track.querySelector('.delisha-rakhi-content');

    if (!original) return;

    /*
      Remove previously generated copies.
    */
    track.querySelectorAll('.delisha-rakhi-clone').forEach(function (clone) {
      clone.remove();
    });

    /*
      Get the exact width of one complete group.
    */
    var groupWidth = original.getBoundingClientRect().width;

    /*
      Fill the track with enough copies to cover
      the entire browser width plus extra space.
    */
    var screenWidth = window.innerWidth;

    var copiesNeeded = Math.ceil(screenWidth / groupWidth) + 3;

    for (var i = 0; i < copiesNeeded; i++) {

      var clone = original.cloneNode(true);

      clone.classList.add('delisha-rakhi-clone');

      clone.setAttribute('aria-hidden', 'true');

      track.appendChild(clone);
    }

    /*
      Animation position.
    */
    var position = 0;

    /*
      Speed in pixels per second.
    */
    var speed = 45;

    var lastTime = performance.now();

    function animate(currentTime) {

      var deltaTime = (currentTime - lastTime) / 1000;

      lastTime = currentTime;

      position -= speed * deltaTime;

      /*
        When exactly one complete group
        has moved away, reset by exactly
        one group width.
      */
      if (Math.abs(position) >= groupWidth) {

        position += groupWidth;

      }

      track.style.transform =
        'translate3d(' + position + 'px, 0, 0)';

      requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);
  }


  /*
    Start after page loads.
  */
  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initDelishaRakhiMarquee
    );

  } else {

    initDelishaRakhiMarquee();

  }


  /*
    Recalculate on browser resize.
  */
  window.addEventListener('resize', function () {

    clearTimeout(window.delishaMarqueeResizeTimer);

    window.delishaMarqueeResizeTimer = setTimeout(
      initDelishaRakhiMarquee,
      250
    );

  });

})();
</script>
