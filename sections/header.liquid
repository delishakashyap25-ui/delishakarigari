{%- assign menu_handle = section.settings.menu | default: 'main-menu' -%}
{%- assign menu_links = linklists[menu_handle].links -%}

<header
  class="dk-header dk-header--sticky"
  id="dkHeader"
  data-section-id="{{ section.id }}"
  role="banner"
>
  {%- comment -%} =====================================================
    TOP ANNOUNCEMENT BAR (BRAND TONE WINE / BURGUNDY ROTATING ONE BY ONE)
  ==================================================== {%- endcomment -%}
  <div class="dk-header__announcement" id="dkAnnouncementBar">
    <div class="dk-header__announcement-slider" id="dkAnnouncementSlider">
      <a href="{{ section.settings.announcement_link | default: routes.all_products_collection_url }}" class="dk-announcement-slide is-active" data-index="0">
        <span class="dk-announcement-star">✦</span>
        <span class="dk-announcement-text">FREE SHIPPING SITEWIDE</span>
        <span class="dk-announcement-star">✦</span>
      </a>
      <a href="{{ section.settings.announcement_link | default: routes.all_products_collection_url }}" class="dk-announcement-slide" data-index="1">
        <span class="dk-announcement-star">✦</span>
        <span class="dk-announcement-text">HANDCRAFTED WITH LOVE</span>
        <span class="dk-announcement-star">✦</span>
      </a>
      <a href="{{ section.settings.announcement_link | default: routes.all_products_collection_url }}" class="dk-announcement-slide" data-index="2">
        <span class="dk-announcement-star">✦</span>
        <span class="dk-announcement-text">EXPRESS DISPATCH ACROSS INDIA</span>
        <span class="dk-announcement-star">✦</span>
      </a>
      <a href="{{ section.settings.announcement_link | default: routes.all_products_collection_url }}" class="dk-announcement-slide" data-index="3">
        <span class="dk-announcement-star">✦</span>
        <span class="dk-announcement-text">CUSTOMISATION OF PRODUCTS AVAILABLE</span>
        <span class="dk-announcement-star">✦</span>
      </a>
    </div>
  </div>

  {%- comment -%} =====================================================
    TOP HEADER ROW: LOCATION (LEFT) | LOGO (CENTER) | ACTIONS (RIGHT)
  ==================================================== {%- endcomment -%}
  <div class="dk-header__top">
    <div class="dk-header__top-container">
      
      <!-- LEFT AREA (MOBILE MENU TOGGLE + WHERE TO DELIVER LOCATION BUTTON) -->
      <div class="dk-header__left">
        <button
          type="button"
          class="dk-header__toggle"
          id="dkMobileToggle"
          onclick="toggleDkMobileMenu()"
          aria-label="Open Navigation Menu"
          aria-expanded="false"
          aria-controls="dkMobileDrawer"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <!-- WHERE TO DELIVER BUTTON -->
        {%- if section.settings.show_delivery_location != false -%}
          <button
            type="button"
            class="dk-location-btn"
            id="dkLocationBtn"
            onclick="openDkLocationModal()"
            aria-label="{{ section.settings.delivery_location_text | default: 'Where to deliver?' | escape }}"
          >
            <span class="dk-location-btn__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </span>
            <span class="dk-location-btn__text" id="dkLocationBtnText">{{ section.settings.delivery_location_text | default: 'Where to deliver?' }}</span>
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" class="dk-location-btn__chevron">
              <path d="M1 1L5 5L9 1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}
      </div>

      <!-- BRAND LOGO / WORDMARK -->
      <div class="dk-header__logo">
        <a href="{{ routes.root_url }}" class="dk-header__logo-link">
          {%- if section.settings.logo_image != blank -%}
            {%- assign logo_alt = section.settings.logo_image.alt | default: shop.name | escape -%}
            <img
              src="{{ section.settings.logo_image | image_url: width: 600 }}"
              alt="{{ logo_alt }}"
              class="dk-header__logo-img"
              width="{{ section.settings.logo_width | default: 260 }}"
              height="60"
              style="max-width: {{ section.settings.logo_width | default: 260 }}px; height: auto;"
              loading="eager"
            >
          {%- else -%}
            <img
              src="{{ 'dk-logo.png' | asset_url }}"
              alt="{{ shop.name | default: 'DELISHA KARIGARI' | escape }}"
              class="dk-header__logo-img"
              width="{{ section.settings.logo_width | default: 260 }}"
              height="60"
              style="max-width: {{ section.settings.logo_width | default: 260 }}px; height: auto;"
              loading="eager"
            >
          {%- endif -%}
        </a>
      </div>

      <!-- HEADER ACTION ICONS (SEARCH / ACCOUNT / WISHLIST / CART) -->
      <div class="dk-header__actions">
        <button
          type="button"
          class="dk-header__icon-btn dk-header__icon-search"
          aria-label="Search"
          onclick="if(typeof openSearchModal === 'function') { openSearchModal(); } else { window.location.href='{{ routes.search_url }}'; }"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="20" y1="20" x2="16" y2="16"></line>
          </svg>
        </button>

        {%- assign account_url = routes.account_url -%}
        {%- assign login_url = routes.account_login_url -%}
        <a
          href="{% if customer != blank %}{{ account_url }}{% else %}{{ login_url }}{% endif %}"
          class="dk-header__icon-btn dk-header__icon-account"
          aria-label="Account"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4"></circle>
            <path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path>
          </svg>
        </a>

        <a
          href="#"
          class="dk-header__icon-btn dk-header__icon-wishlist"
          id="HeaderWishlistIcon"
          aria-label="Wishlist"
          onclick="if(typeof window.openWishlist === 'function') { window.openWishlist(); return false; }"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span class="wishlist-count" id="WishlistCount">0</span>
        </a>

        <a
          href="{{ routes.cart_url }}"
          class="dk-header__icon-btn dk-header__icon-cart"
          id="HeaderCartIcon"
          aria-label="Cart"
          onclick="if(typeof ShopifyCart !== 'undefined' && typeof ShopifyCart.openDrawer === 'function') { ShopifyCart.openDrawer(); return false; }"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="cart-count" id="HeaderCartCount">{{ cart.item_count | default: 0 }}</span>
        </a>
      </div>

    </div>
  </div>

  {%- comment -%} =====================================================
    MOBILE PRECISION DELIVERY LOCATION BAR (MINIMAL, ELEGANT & PRECISE ON MOBILE/IOS)
  ==================================================== {%- endcomment -%}
  {%- if section.settings.show_delivery_location != false -%}
    <div
      class="dk-header__mobile-location"
      id="dkMobileLocationBar"
      onclick="openDkLocationModal()"
      role="button"
      tabindex="0"
      aria-label="Delivery location: Check delivery details"
    >
      <div class="dk-mobile-location-inner">
        <span class="dk-mobile-location-icon">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </span>
        <span class="dk-mobile-location-text">
          <span class="dk-mobile-location-muted">Deliver to:</span>
          <strong class="dk-mobile-location-city" id="dkMobileLocationCity">Select Location</strong>
          <span class="dk-mobile-location-pin" id="dkMobileLocationPin" style="display: none;"></span>
        </span>
        <span class="dk-mobile-location-cta">
          Check
          <svg width="8" height="5" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M1 1L5 5L9 1" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} =====================================================
    DESKTOP CATEGORY NAVIGATION ROW (CLEAN EDITORIAL OFF-WHITE BAR - PHOTO 4)
  ==================================================== {%- endcomment -%}
  <nav class="dk-header__nav" aria-label="Main Navigation">
    <div class="container dk-header__nav-container">
        <!-- 1. ALL COLLECTIONS -->
        <li class="dk-header__menu-item">
          <a href="{{ routes.all_products_collection_url }}" class="dk-header__menu-link {% if request.path == routes.all_products_collection_url %}is-active{% endif %}">
            ALL COLLECTIONS
          </a>
        </li>

        <!-- 2. BANDHANWAR -->
        <li class="dk-header__menu-item">
          <a href="{{ routes.collections_url }}/bandhanwar" class="dk-header__menu-link {% if request.path contains 'bandhanwar' %}is-active{% endif %}">
            BANDHANWAR
          </a>
        </li>

        <!-- 3. LATKANS -->
        <li class="dk-header__menu-item">
          <a href="{{ routes.collections_url }}/latkan" class="dk-header__menu-link {% if request.path contains 'latkan' %}is-active{% endif %}">
            LATKANS
          </a>
        </li>

        <!-- 4. KARWA CHAUTH -->
        <li class="dk-header__menu-item">
          <a href="{{ routes.collections_url }}/karwa-chauth-special" class="dk-header__menu-link {% if request.path contains 'karwa' %}is-active{% endif %}">
            KARWA CHAUTH
          </a>
        </li>

        <!-- 5. DIWALI DÉCOR -->
        <li class="dk-header__menu-item">
          <a href="{{ routes.collections_url }}/diwali-decor" class="dk-header__menu-link {% if request.path contains 'diwali' %}is-active{% endif %}">
            DIWALI DÉCOR
          </a>
        </li>

        <!-- 6. GIFTING -->
        <li class="dk-header__menu-item">
          <a href="{{ routes.collections_url }}/for-her-accessories" class="dk-header__menu-link {% if request.path contains 'gifting' or request.path contains 'for-her' %}is-active{% endif %}">
            GIFTING
          </a>
        </li>

        <!-- 7. UNDER @199 (HIGHLIGHTED) -->
        <li class="dk-header__menu-item">
          <a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=199" class="dk-header__menu-link dk-header__menu-link--highlight {% if request.path contains '199' %}is-active{% endif %}">
            UNDER @199
          </a>
        </li>

        <!-- 8. POTLIS -->
        <li class="dk-header__menu-item">
          <a href="{{ routes.collections_url }}/handmade-potli" class="dk-header__menu-link {% if request.path contains 'potli' %}is-active{% endif %}">
            POTLIS
          </a>
        </li>
      </ul>
    </div>
  </nav>


  {%- comment -%} =====================================================
    MOBILE SLIDE-OUT DRAWER NAVIGATION
  ==================================================== {%- endcomment -%}
  <div class="dk-mobile-drawer" id="dkMobileDrawer" aria-hidden="true" role="dialog" aria-label="Mobile Navigation">
    <div class="dk-mobile-drawer__header">
      <img
        src="{{ 'dk-logo.png' | asset_url }}"
        alt="{{ shop.name | default: 'DELISHA KARIGARI' | escape }}"
        class="dk-header__logo-img"
        width="{{ section.settings.mobile_logo_width | default: 160 }}"
        height="50"
        style="max-width: {{ section.settings.mobile_logo_width | default: 160 }}px; height: auto;"
        loading="eager"
      >
      <button
        type="button"
        class="dk-mobile-drawer__close"
        onclick="toggleDkMobileMenu()"
        aria-label="Close Navigation Menu"
      >
        &times;
      </button>
    </div>

    <!-- MOBILE SEARCH BAR INTEGRATION -->
    <div class="dk-mobile-drawer__search">
      <form action="{{ routes.search_url }}" method="get" role="search" class="dk-mobile-search-form">
        <input type="hidden" name="type" value="product">
        <input
          type="search"
          name="q"
          placeholder="Search Diwali Decor, Bandhanwars, Gifts..."
          class="dk-mobile-search-input"
          aria-label="Search Store"
        >
        <button type="submit" class="dk-mobile-search-btn" aria-label="Submit Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="20" y1="20" x2="16" y2="16"></line>
          </svg>
        </button>
      </form>
    </div>

    <div class="dk-mobile-drawer__body">
      <ul class="dk-mobile-menu" role="list">
        <!-- 1. ALL COLLECTIONS -->
        <li class="dk-mobile-menu__item">
          <div class="dk-mobile-menu__row">
            <a href="{{ routes.all_products_collection_url }}" class="dk-mobile-menu__link">
              ALL COLLECTIONS
            </a>
          </div>
        </li>

        <!-- 2. BANDHANWAR -->
        <li class="dk-mobile-menu__item">
          <div class="dk-mobile-menu__row">
            <a href="{{ routes.collections_url }}/bandhanwar" class="dk-mobile-menu__link">
              BANDHANWAR
            </a>
          </div>
        </li>

        <!-- 3. LATKANS -->
        <li class="dk-mobile-menu__item">
          <div class="dk-mobile-menu__row">
            <a href="{{ routes.collections_url }}/latkan" class="dk-mobile-menu__link">
              LATKANS
            </a>
          </div>
        </li>

        <!-- 4. KARWA CHAUTH -->
        <li class="dk-mobile-menu__item">
          <div class="dk-mobile-menu__row">
            <a href="{{ routes.collections_url }}/karwa-chauth-special" class="dk-mobile-menu__link">
              KARWA CHAUTH
            </a>
          </div>
        </li>

        <!-- 5. DIWALI DÉCOR -->
        <li class="dk-mobile-menu__item">
          <div class="dk-mobile-menu__row">
            <a href="{{ routes.collections_url }}/diwali-decor" class="dk-mobile-menu__link">
              DIWALI DÉCOR
            </a>
          </div>
        </li>

        <!-- 6. GIFTING -->
        <li class="dk-mobile-menu__item">
          <div class="dk-mobile-menu__row">
            <a href="{{ routes.collections_url }}/for-her-accessories" class="dk-mobile-menu__link">
              GIFTING
            </a>
          </div>
        </li>

        <!-- 7. UNDER @199 (HIGHLIGHTED) -->
        <li class="dk-mobile-menu__item">
          <div class="dk-mobile-menu__row">
            <a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=199" class="dk-mobile-menu__link dk-mobile-menu__link--highlight">
              UNDER @199 <span class="dk-menu-badge" style="background: #9E743A; color: #fff; font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; margin-left: 6px;">OFFER</span>
            </a>
          </div>
        </li>

        <!-- 8. POTLIS -->
        <li class="dk-mobile-menu__item">
          <div class="dk-mobile-menu__row">
            <a href="{{ routes.collections_url }}/handmade-potli" class="dk-mobile-menu__link">
              POTLIS
            </a>
          </div>
        </li>
      </ul>

      <!-- QUICK LOCATION TRIGGER IN MOBILE DRAWER -->
      <div class="dk-mobile-drawer__location" style="padding: 16px 20px; border-top: 1px solid #ECE2D5; margin-top: 14px; background: #FAF7F2;">
        <button
          type="button"
          class="dk-mobile-drawer__location-btn"
          onclick="toggleDkMobileMenu(); setTimeout(function(){ if (typeof openDkLocationModal === 'function') openDkLocationModal(); }, 200);"
          style="display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 11px 16px; background: #FFFFFF; border: 1.5px solid #E2D4C8; border-radius: 8px; font-family: var(--dk-font-body, 'Poppins', sans-serif); font-size: 0.84rem; color: #2D2522; cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.04);"
        >
          <span style="display: flex; align-items: center; gap: 9px; font-weight: 500;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--dk-color-primary, #641A28)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Check Delivery Location</span>
          </span>
          <span style="color: var(--dk-color-primary, #641A28); font-weight: 600; font-size: 0.8rem;">Check &rarr;</span>
        </button>
      </div>
    </div>
  </div>

  <div class="dk-mobile-overlay" id="dkMobileOverlay" onclick="toggleDkMobileMenu()"></div>
</header>

<script>
  function toggleDkMobileMenu() {
    const drawer = document.getElementById('dkMobileDrawer');
    const overlay = document.getElementById('dkMobileOverlay');
    const toggleBtn = document.getElementById('dkMobileToggle');
    if (!drawer || !overlay) return;

    const isActive = drawer.classList.contains('is-open');
    if (isActive) {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      document.body.classList.remove('overflow-hidden');
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
    } else {
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');
      document.body.classList.add('overflow-hidden');
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
    }
  }

  function toggleDkAccordion(btn) {
    const row = btn.closest('.dk-mobile-menu__row') || btn.closest('.dk-mobile-submenu__row');
    if (!row) return;
    const parentLi = row.parentElement;
    const subMenu = parentLi.querySelector('.dk-mobile-submenu, .dk-mobile-grandchild-menu');
    if (!subMenu) return;

    const isOpen = subMenu.style.display === 'block';
    if (isOpen) {
      subMenu.style.display = 'none';
      btn.classList.remove('is-open');
    } else {
      subMenu.style.display = 'block';
      btn.classList.add('is-open');
    }
  }

  // Rotating Announcement Bar Slider (One by One)
  (function initAnnouncementSlider() {
    function startSlider() {
      const slider = document.getElementById('dkAnnouncementSlider');
      if (!slider) return;
      const slides = slider.querySelectorAll('.dk-announcement-slide');
      if (slides.length <= 1) return;

      let current = 0;
      setInterval(function() {
        const prev = current;
        current = (current + 1) % slides.length;

        slides[prev].classList.remove('is-active');
        slides[prev].classList.add('is-exiting');

        setTimeout(function() {
          slides[prev].classList.remove('is-exiting');
        }, 500);

        slides[current].classList.add('is-active');
      }, 3200);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startSlider);
    } else {
      startSlider();
    }
  })();

  // Expose global methods for inline HTML onclick handlers
  window.toggleDkMobileMenu = toggleDkMobileMenu;
  window.toggleDkAccordion = toggleDkAccordion;

  // Compact Transition on Scroll (Ratnaya-Style Persistent Sticky Header)
  (function initStickyHeader() {
    function startSticky() {
      const header = document.getElementById('dkHeader');
      if (!header) return;
      let ticking = false;

      function updateStickyState() {
        const top = window.pageYOffset || document.documentElement.scrollTop || 0;
        if (top > 40) {
          header.classList.add('dk-header--scrolled');
        } else {
          header.classList.remove('dk-header--scrolled');
        }
        ticking = false;
      }

      window.addEventListener('scroll', function() {
        if (!ticking) {
          window.requestAnimationFrame(updateStickyState);
          ticking = true;
        }
      }, { passive: true });

      updateStickyState();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startSticky);
    } else {
      startSticky();
    }
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Bar Link",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 140,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Desktop Logo Width",
      "default": 260
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "min": 100,
      "max": 260,
      "step": 10,
      "unit": "px",
      "label": "Mobile Logo Width",
      "default": 160
    },
    {
      "type": "header",
      "content": "Delivery Location (Pincode Checker)"
    },
    {
      "type": "checkbox",
      "id": "show_delivery_location",
      "label": "Show 'Where to deliver?' Button",
      "default": true,
      "info": "Allows customers to enter their 6-digit Indian PIN code to check instant delivery speed & express dispatch."
    },
    {
      "type": "text",
      "id": "delivery_location_text",
      "label": "Location Button Label",
      "default": "Where to deliver?"
    }
  ]
}
{% endschema %}