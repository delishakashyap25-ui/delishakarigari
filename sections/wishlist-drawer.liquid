<div class="wishlist-overlay" id="WishlistOverlay"></div>
<div class="wishlist-drawer" id="WishlistDrawer" aria-hidden="true">
  <div class="wishlist-drawer-header">
    <h3>Your Wishlist</h3>
    <button class="wishlist-close" id="WishlistClose" aria-label="Close wishlist">&times;</button>
  </div>

  <div class="wishlist-drawer-body" id="WishlistItems">
    <!-- Wishlist items will be rendered here by JS -->
    <div class="wishlist-empty">
      <p class="wishlist-empty-title">Your wishlist is empty</p>
      <p class="wishlist-empty-subtitle">Save your favorite handcrafted décor and gifts here to revisit anytime.</p>
      <a href="{{ routes.all_products_collection_url }}" class="wishlist-continue-btn">
        CONTINUE SHOPPING
      </a>
    </div>
    <div class="wishlist-loading" style="display: none; text-align: center; padding: 30px 20px;">
      <p style="color: #75656A; font-size: 14px;">Loading saved pieces...</p>
    </div>
  </div>
</div>

<style>
  .wishlist-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.45);
    z-index: 100000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .wishlist-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .wishlist-drawer {
    position: fixed;
    top: 0;
    right: -420px;
    width: 420px;
    max-width: 92vw;
    height: 100vh;
    background: #FDFAF6;
    z-index: 100001;
    transition: right 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    display: flex;
    flex-direction: column;
    box-shadow: -6px 0 25px rgba(0, 0, 0, 0.12);
  }

  .wishlist-drawer.active {
    right: 0;
  }

  .wishlist-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 24px;
    min-height: 76px;
    border-bottom: 1px solid #EADFD7;
    background: #FDFAF6;
  }

  .wishlist-drawer-header h3 {
    margin: 0;
    font-size: 22px;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    color: var(--dk-dark-burgundy, #4A111C);
  }

  .wishlist-close {
    background: none;
    border: none;
    font-size: 30px;
    cursor: pointer;
    line-height: 1;
    color: var(--dk-dark-burgundy, #4A111C);
    padding: 4px;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .wishlist-close:hover {
    transform: scale(1.15);
    color: var(--dk-burgundy, #641A28);
  }

  .wishlist-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 22px;
  }

  .wishlist-item {
    display: flex;
    gap: 16px;
    margin-bottom: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid #EADFD7;
    transition: opacity 0.2s ease;
  }

  .wishlist-item-img {
    width: 84px;
    height: 105px;
    object-fit: cover;
    border-radius: 3px;
    border: 1px solid #ECE3D9;
    background: #F4EDE4;
  }

  .wishlist-item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .wishlist-item-title {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    color: var(--dk-charcoal, #211A18);
    margin-bottom: 6px;
    display: block;
    transition: color 0.2s ease;
  }

  .wishlist-item-title:hover {
    color: var(--dk-burgundy, #641A28);
  }

  .wishlist-item-price {
    color: var(--dk-burgundy, #641A28);
    font-weight: 700;
    font-size: 14px;
  }

  .wishlist-item-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    gap: 10px;
  }

  .wishlist-remove {
    background: none;
    border: none;
    color: #8C7B80;
    text-decoration: underline;
    cursor: pointer;
    font-size: 12px;
    padding: 0;
    transition: color 0.2s ease;
  }

  .wishlist-remove:hover {
    color: var(--dk-burgundy, #641A28);
  }

  .wishlist-add-to-cart {
    background: var(--dk-burgundy, #641A28);
    color: #ffffff;
    border: 1px solid var(--dk-burgundy, #641A28);
    padding: 7px 14px;
    font-size: 11px;
    letter-spacing: 0.04em;
    cursor: pointer;
    border-radius: 3px;
    text-transform: uppercase;
    font-weight: 700;
    transition: all 0.2s ease;
  }

  .wishlist-add-to-cart:hover {
    background: var(--dk-dark-burgundy, #4A111C);
    border-color: var(--dk-gold, #B89A62);
  }

  .wishlist-empty {
    text-align: center;
    padding: 60px 20px;
  }

  .wishlist-empty-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 18px;
    font-weight: 600;
    color: var(--dk-charcoal, #211A18);
    margin: 0 0 8px;
  }

  .wishlist-empty-subtitle {
    font-size: 13px;
    color: #75656A;
    line-height: 1.6;
    margin: 0 0 24px;
  }

  .wishlist-continue-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 26px;
    background: var(--dk-burgundy, #641A28);
    color: #ffffff !important;
    border: 1px solid var(--dk-gold, #B89A62);
    border-radius: 3px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .wishlist-continue-btn:hover {
    background: var(--dk-dark-burgundy, #4A111C);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(100, 26, 40, 0.25);
  }
</style>

{% schema %}
{
"name": "Wishlist Drawer",
"settings": [],
"presets": [
{
"name": "Wishlist Drawer"
}
]
}
{% endschema %}