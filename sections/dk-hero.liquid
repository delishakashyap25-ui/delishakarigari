{%- liquid
  assign eyebrow = section.settings.eyebrow | default: '✦ KARWA CHAUTH SPECIAL • HANDMADE WITH LOVE ✦'
  assign heading = section.settings.heading | default: 'Celebrations Feel More Beautiful.'
  assign subheading = section.settings.subheading | default: 'From handcrafted Karwa Chauth thalis and bespoke chhalnis to thoughtful gifts — discover pieces made to elevate your most cherished moments.'
  assign primary_btn_text = section.settings.primary_btn_text | default: 'EXPLORE KARWA CHAUTH →'
  assign primary_url = section.settings.primary_btn_link
  if primary_url == blank
    assign primary_url = routes.collections_url | append: '/karwa-chauth-special'
  endif
  assign secondary_btn_text = section.settings.secondary_btn_text | default: 'EXPLORE GIFTING'
  assign secondary_url = section.settings.secondary_btn_link
  if secondary_url == blank
    assign secondary_url = routes.collections_url | append: '/for-her-accessories'
  endif
  assign total_blocks = section.blocks.size
-%}

<section
  id="dk-hero-{{ section.id }}"
  class="dk-hero-section"
  style="--dk-hero-desktop-h: {{ section.settings.desktop_height | default: 80 }}vh; --dk-hero-mobile-h: {{ section.settings.mobile_height | default: 72 }}vh;"
  {% if total_blocks > 1 or total_blocks == 0 %}
    data-autoplay="{{ section.settings.autoplay | default: 'true' }}"
    data-interval="{{ section.settings.autoplay_speed | default: 7500 }}"
  {% endif %}
>
  <div class="dk-hero-container" id="dkHeroSlider-{{ section.id }}">
    
    {%- if total_blocks > 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign b_eyebrow = block.settings.eyebrow | default: eyebrow
          assign b_heading = block.settings.heading | default: heading
          assign b_subheading = block.settings.subheading | default: subheading
          assign b_pri_text = block.settings.primary_btn_text | default: primary_btn_text
          assign b_pri_url = block.settings.primary_btn_link | default: primary_url
          assign b_sec_text = block.settings.secondary_btn_text | default: secondary_btn_text
          assign b_sec_url = block.settings.secondary_btn_link | default: secondary_url
        -%}
        <div class="dk-hero-slide {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="dk-hero__media">
            <picture class="dk-hero__picture">
              {%- if block.settings.image_mobile != blank -%}
                <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | image_url: width: 800 }}">
              {%- else -%}
                <source media="(max-width: 767px)" srcset="{{ 'dk-hero-diwali-mobile.jpg' | asset_url }}">
              {%- endif -%}

              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1920 }}"
                  alt="{{ b_heading | escape }} — Delisha Karigari"
                  class="dk-hero__img"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                  width="1920"
                  height="1080"
                >
              {%- else -%}
                <img
                  src="{{ 'dk-hero-diwali.jpg' | asset_url }}"
                  alt="{{ b_heading | escape }} — Delisha Karigari"
                  class="dk-hero__img"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                  width="1376"
                  height="768"
                >
              {%- endif -%}
            </picture>
            <div class="dk-hero__overlay"></div>
          </div>

          <div class="dk-hero__content-container">
            <div class="dk-hero__content">
              {%- if b_eyebrow != blank -%}
                <span class="dk-hero__eyebrow">{{ b_eyebrow }}</span>
              {%- endif -%}
              {%- if b_heading != blank -%}
                <h1 class="dk-hero__title">{{ b_heading | replace: 'Make Your Home Feel Like Diwali.', 'Make Your Home<br class="dk-hero__br"> Feel Like Diwali.' }}</h1>
              {%- endif -%}
              {%- if b_subheading != blank -%}
                <p class="dk-hero__subtitle">{{ b_subheading }}</p>
              {%- endif -%}
              <div class="dk-hero__actions">
                {%- if b_pri_text != blank and b_pri_url != blank -%}
                  <a href="{{ b_pri_url }}" class="dk-hero__btn-primary">
                    {{ b_pri_text }}
                  </a>
                {%- endif -%}
                {%- if b_sec_text != blank and b_sec_url != blank -%}
                  <a href="{{ b_sec_url }}" class="dk-hero__btn-secondary">
                    {{ b_sec_text }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}

    {%- else -%}
      <!-- SLIDE 1: KARWA CHAUTH & GIFTING SPECIAL -->
      <div class="dk-hero-slide active dk-hero-slide--editorial dk-hero-slide--kc" data-slide="0">
        <div class="dk-hero__media">
          <picture class="dk-hero__picture">
            <source media="(max-width: 767px)" srcset="{{ 'dk-hero-karwa-chauth-mobile.jpg' | asset_url }}">
            <img
              src="{{ 'dk-hero-karwa-chauth.jpg' | asset_url }}"
              alt="Karwa Chauth Celebrations — Delisha Karigari"
              class="dk-hero__img dk-hero__img--editorial"
              loading="eager"
              fetchpriority="high"
              width="1920"
              height="1080"
            >
          </picture>
          <div class="dk-hero__overlay dk-hero__overlay--editorial dk-hero__overlay--kc"></div>
        </div>

        <div class="dk-hero__content-container dk-hero__content-container--editorial">
          <div class="dk-hero__content dk-hero__content--editorial">
            <span class="dk-hero__eyebrow">✦ KARWA CHAUTH SPECIAL • HANDMADE WITH LOVE ✦</span>
            <h1 class="dk-hero__title">Celebrations Feel<br class="dk-hero__br"> <em>More Beautiful.</em></h1>
            <p class="dk-hero__subtitle">From handcrafted Karwa Chauth thalis and bespoke chhalnis to thoughtful gifts — discover pieces made to elevate your most cherished moments.</p>
            <div class="dk-hero__actions">
              <a href="{{ routes.collections_url }}/karwa-chauth-special" class="dk-hero__btn-primary">
                EXPLORE KARWA CHAUTH &rarr;
              </a>
              <a href="{{ routes.collections_url }}/for-her-accessories" class="dk-hero__btn-secondary">
                EXPLORE GIFTING
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- SLIDE 2: HANDMADE BANDHANWAR & ENTRANCE TORANS -->
      <div class="dk-hero-slide dk-hero-slide--editorial dk-hero-slide--bw" data-slide="1">
        <div class="dk-hero__media">
          <picture class="dk-hero__picture">
            <source media="(max-width: 767px)" srcset="{{ 'dk-hero-bandhanwar-mobile.jpg' | asset_url }}">
            <img
              src="{{ 'dk-hero-bandhanwar.jpg' | asset_url }}"
              alt="Handcrafted Peacock Bandhanwars & Door Torans — Delisha Karigari"
              class="dk-hero__img dk-hero__img--editorial"
              loading="lazy"
              width="1920"
              height="1080"
            >
          </picture>
          <div class="dk-hero__overlay dk-hero__overlay--editorial dk-hero__overlay--bw"></div>
        </div>

        <div class="dk-hero__content-container dk-hero__content-container--editorial">
          <div class="dk-hero__content dk-hero__content--editorial">
            <span class="dk-hero__eyebrow">✦ HANDCRAFTED HERITAGE • BESPOKE ENTRANCES ✦</span>
            <h2 class="dk-hero__title">Welcome Blessings,<br class="dk-hero__br"> <em>Handcrafted with Love.</em></h2>
            <p class="dk-hero__subtitle">Authentic peacock bandhanwars &amp; artisanal torans, handcrafted to bless your doorway.</p>
            <div class="dk-hero__actions">
              <a href="{{ routes.collections_url }}/bandhanwar" class="dk-hero__btn-primary">
                EXPLORE BANDHANWARS &rarr;
              </a>
              <a href="{{ routes.collections_url }}/latkan" class="dk-hero__btn-secondary">
                EXPLORE DOOR LATKANS
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- SLIDE 3: BESPOKE FESTIVE GIFTING & LUXURY HAMPERS -->
      <div class="dk-hero-slide dk-hero-slide--editorial dk-hero-slide--gifting" data-slide="2">
        <div class="dk-hero__media">
          <picture class="dk-hero__picture">
            <source media="(max-width: 767px)" srcset="{{ 'dk-banner-gifting-mobile.jpg' | asset_url }}">
            <img
              src="{{ 'dk-banner-gifting.jpg' | asset_url }}"
              alt="The Art of Gifting, Handcrafted with Heart — Delisha Karigari"
              class="dk-hero__img dk-hero__img--editorial"
              loading="lazy"
              width="1920"
              height="1080"
            >
          </picture>
          <div class="dk-hero__overlay dk-hero__overlay--editorial dk-hero__overlay--gifting"></div>
        </div>

        <div class="dk-hero__content-container dk-hero__content-container--editorial">
          <div class="dk-hero__content dk-hero__content--editorial">
            <span class="dk-hero__eyebrow">✦ THOUGHTFUL CELEBRATIONS • BESPOKE GIFTING ✦</span>
            <h2 class="dk-hero__title">The Art of Gifting,<br class="dk-hero__br"> <em>Handcrafted with Heart.</em></h2>
            <p class="dk-hero__subtitle">From royal festive hampers and embellished potlis to sacred keepsakes — discover gifts designed to make every bond feel treasured.</p>
            <div class="dk-hero__actions">
              <a href="{{ routes.collections_url }}/for-her-accessories" class="dk-hero__btn-primary">
                EXPLORE GIFTING COLLECTION &rarr;
              </a>
              <a href="{{ routes.collections_url }}/for-her-accessories" class="dk-hero__btn-secondary">
                EXPLORE HAMPERS & POTLIS
              </a>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if total_blocks > 1 or total_blocks == 0 -%}
      <!-- NAVIGATION ARROWS -->
      <button type="button" class="dk-hero-arrow dk-hero-arrow--prev" aria-label="Previous Slide" onclick="dkHeroPrevSlide('{{ section.id }}')">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button type="button" class="dk-hero-arrow dk-hero-arrow--next" aria-label="Next Slide" onclick="dkHeroNextSlide('{{ section.id }}')">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>

      <!-- DOT INDICATORS -->
      <div class="dk-hero-dots" role="tablist" aria-label="Hero Slides">
        {%- if total_blocks > 0 -%}
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="dk-hero-dot {% if forloop.first %}active{% endif %}"
              role="tab"
              aria-label="Slide {{ forloop.index }}"
              onclick="dkHeroGoToSlide('{{ section.id }}', {{ forloop.index0 }})"
            ></button>
          {%- endfor -%}
        {%- else -%}
          <button
            type="button"
            class="dk-hero-dot active"
            role="tab"
            aria-label="Slide 1 - Karwa Chauth & Gifting"
            onclick="dkHeroGoToSlide('{{ section.id }}', 0)"
          ></button>
          <button
            type="button"
            class="dk-hero-dot"
            role="tab"
            aria-label="Slide 2 - Handcrafted Bandhanwars"
            onclick="dkHeroGoToSlide('{{ section.id }}', 1)"
          ></button>
          <button
            type="button"
            class="dk-hero-dot"
            role="tab"
            aria-label="Slide 3 - Bespoke Festive Gifting"
            onclick="dkHeroGoToSlide('{{ section.id }}', 2)"
          ></button>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .dk-hero-section {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: {{ section.settings.bg_color | default: '#211A18' }};
  }
  .dk-hero-container {
    position: relative;
    width: 100%;
    height: clamp(500px, 44vw, 595px);
    min-height: 480px;
    max-height: 610px;
    overflow: hidden;
  }
  /* FLAGSHIP EDITORIAL HERO STYLES (PHOTO + LIVE TYPOGRAPHY) */
  .dk-hero-slide--editorial {
    align-items: center !important;
    justify-content: flex-start !important;
  }
  .dk-hero-slide--editorial .dk-hero__img--editorial {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dk-hero-slide--kc .dk-hero__img--editorial {
    object-position: 80% 40%;
  }
  .dk-hero-slide--bw .dk-hero__img--editorial {
    object-position: 70% 32%;
  }
  .dk-hero-slide--gifting .dk-hero__img--editorial {
    object-position: center 36%;
  }
  .dk-hero__overlay--editorial {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .dk-hero__overlay--kc {
    background: linear-gradient(
      90deg,
      rgba(24, 8, 14, 0.86) 0%,
      rgba(24, 8, 14, 0.70) 34%,
      rgba(24, 8, 14, 0.22) 58%,
      rgba(24, 8, 14, 0.0) 75%
    ) !important;
  }
  .dk-hero__overlay--bw {
    background: linear-gradient(
      90deg,
      rgba(20, 12, 8, 0.88) 0%,
      rgba(20, 12, 8, 0.72) 34%,
      rgba(20, 12, 8, 0.24) 58%,
      rgba(20, 12, 8, 0.0) 75%
    ) !important;
  }
  .dk-hero__overlay--gifting {
    background: linear-gradient(
      90deg,
      rgba(24, 8, 14, 0.86) 0%,
      rgba(24, 8, 14, 0.70) 34%,
      rgba(24, 8, 14, 0.22) 58%,
      rgba(24, 8, 14, 0.0) 75%
    ) !important;
  }
  .dk-hero__content-container--editorial {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: clamp(1rem, 2.5vw, 2.2rem) clamp(20px, 3.5vw, 50px) !important;
    padding-left: clamp(72px, 6.2vw, 95px) !important;
    box-sizing: border-box;
    display: flex !important;
    justify-content: flex-start !important;
  }
  .dk-hero__content--editorial {
    max-width: clamp(480px, 45vw, 600px) !important;
    text-align: left !important;
    margin: 0 !important;
    color: #F8F3EB;
  }
  .dk-hero__content--editorial .dk-hero__eyebrow {
    color: #E9D8C5;
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 2.2px;
    margin: 0 0 0.65rem !important;
    text-align: left !important;
    display: inline-block;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }
  .dk-hero__content--editorial .dk-hero__title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(1.85rem, 3.1vw, 2.75rem);
    font-weight: 600;
    line-height: 1.15;
    color: #FFFFFF;
    margin: 0 0 0.8rem !important;
    text-align: left !important;
    letter-spacing: -0.2px;
    text-shadow: 0 3px 18px rgba(0, 0, 0, 0.5);
  }
  .dk-hero__content--editorial .dk-hero__title em {
    font-style: italic;
    font-weight: 400;
    color: #F8EAD4;
  }
  .dk-hero__content--editorial .dk-hero__subtitle {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: clamp(0.85rem, 1.02vw, 0.96rem);
    line-height: 1.55;
    color: rgba(248, 243, 235, 0.95);
    max-width: 520px !important;
    margin: 0 0 1.4rem !important;
    text-align: left !important;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }
  .dk-hero__content--editorial .dk-hero__actions {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    margin: 0 !important;
    gap: 14px;
    flex-wrap: wrap;
  }
  .dk-hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease-in-out, visibility 0.8s ease-in-out;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    z-index: 1;
  }
  .dk-hero-slide.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }
  .dk-hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .dk-hero__picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .dk-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    transform: scale(1.01);
    transition: transform 7.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .dk-hero-slide.active .dk-hero__img {
    transform: scale(1.04);
  }
  .dk-hero__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(15, 6, 8, 0.28) 0%,
      rgba(15, 6, 8, 0.08) 28%,
      rgba(20, 8, 12, 0.45) 58%,
      rgba(74, 17, 28, 0.82) 88%,
      rgba(50, 11, 18, 0.94) 100%
    );
  }
  .dk-hero__content-container {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem clamp(2.2rem, 3.8vw, 3.6rem);
    box-sizing: border-box;
    display: flex;
    justify-content: center;
  }
  .dk-hero__content {
    max-width: 820px;
    text-align: center;
    color: #F8F3EB;
  }
  .dk-hero__eyebrow {
    display: inline-block;
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #E9D8C5;
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.65);
  }
  .dk-hero__title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(2.1rem, 4vw, 3.6rem);
    font-weight: 600;
    line-height: 1.18;
    color: #FFFFFF;
    margin: 0 0 0.9rem;
    letter-spacing: -0.3px;
    text-shadow: 0 3px 20px rgba(0, 0, 0, 0.75);
  }
  .dk-hero__br {
    display: none;
  }
  .dk-hero__subtitle {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: clamp(0.92rem, 1.25vw, 1.12rem);
    line-height: 1.65;
    color: #F8F3EB;
    max-width: 650px;
    margin: 0 auto 1.85rem;
    opacity: 0.95;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
  }
  .dk-hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .dk-hero__btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #641A28 0%, #4A111C 100%);
    color: #FFFFFF !important;
    border: 1.5px solid #B89A62;
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    padding: 13px 32px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 2px 8px rgba(100, 26, 40, 0.5);
    transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
    position: relative;
    overflow: hidden;
  }
  .dk-hero__btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.22), transparent);
    transform: skewX(-25deg);
    transition: left 0.75s ease;
  }
  .dk-hero__btn-primary:hover {
    background: linear-gradient(135deg, #7A2232 0%, #5E1624 100%);
    border-color: #D4AF37;
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5), 0 4px 14px rgba(184, 154, 98, 0.5);
  }
  .dk-hero__btn-primary:hover::before {
    left: 150%;
  }
  .dk-hero__btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(33, 26, 24, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #F8F3EB !important;
    border: 1.5px solid rgba(233, 216, 197, 0.65);
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    padding: 13px 32px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  .dk-hero__btn-secondary:hover {
    background: rgba(100, 26, 40, 0.85);
    border-color: #B89A62;
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  /* ARROWS */
  .dk-hero-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(248, 243, 235, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4A111C;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
  }
  .dk-hero-arrow:hover {
    background: #FFFFFF;
    color: #641A28;
    transform: translateY(-50%) scale(1.08);
  }
  .dk-hero-arrow--prev { left: 24px; }
  .dk-hero-arrow--next { right: 24px; }

  /* DOTS */
  .dk-hero-dots {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .dk-hero-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.45);
    border: 1.5px solid rgba(255, 255, 255, 0.85);
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }
  .dk-hero-dot.active {
    background: #B89A62;
    border-color: #B89A62;
