<section
  id="dk-image-banner-{{ section.id }}"
  class="dk-image-banner-sec"
  style="background-color: {{ section.settings.bg_color | default: '#F9F5EE' }}; padding: {{ section.settings.padding_top | default: 20 }}px 0 {{ section.settings.padding_bottom | default: 20 }}px 0;"
>
  <div class="container {% if section.settings.full_width %}dk-image-banner-full{% endif %}">
    <div class="dk-image-banner-wrap">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="dk-image-banner-link" aria-label="Delisha Karigari Trust & Gifting Promise">
      {%- endif -%}

      <picture class="dk-image-banner-picture">
        {%- if section.settings.mobile_image != blank -%}
          <source media="(max-width: 768px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">
        {%- else -%}
          <source media="(max-width: 768px)" srcset="{{ 'banner-mobile.png' | asset_url }}">
        {%- endif -%}

        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 3000 }}"
            alt="{{ section.settings.image.alt | default: 'Delisha Karigari - Handcrafted with Love, Thoughtful Gifting, Pan India Delivery' | escape }}"
            class="dk-image-banner-img"
            loading="lazy"
            width="3000"
            height="420"
          >
        {%- else -%}
          <img
            src="{{ 'banner.png' | asset_url }}"
            alt="Delisha Karigari - Handcrafted with Love, Thoughtful Gifting, Pan India Delivery"
            class="dk-image-banner-img"
            loading="lazy"
            width="1717"
            height="226"
          >
        {%- endif -%}
      </picture>

      {%- if section.settings.link != blank -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .dk-image-banner-sec {
    width: 100%;
    overflow: hidden;
  }
  .dk-image-banner-full {
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
  }
  .dk-image-banner-wrap {
    width: 100%;
    margin: 0 auto;
    overflow: hidden;
    display: flex;
    justify-content: center;
  }
  .dk-image-banner-link {
    display: block;
    width: 100%;
    text-decoration: none;
  }
  .dk-image-banner-picture {
    display: block;
    width: 100%;
  }
  .dk-image-banner-img {
    width: 100%;
    max-width: 1300px;
    height: auto;
    display: block;
    margin: 0 auto;
    object-fit: contain;
  }
  @media (max-width: 768px) {
    .dk-image-banner-sec {
      padding-top: 14px !important;
      padding-bottom: 12px !important;
    }
    .dk-image-banner-wrap {
      padding: 0 12px;
      box-sizing: border-box;
    }
    .dk-image-banner-img {
      max-width: 480px;
      border-radius: 8px;
    }
  }
</style>

{% schema %}
{
  "name": "DELISHA Feature Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom Banner Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Custom Banner Image (Mobile)"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Banner",
      "default": false
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#F9F5EE"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "DELISHA Feature Banner"
    }
  ]
}
{% endschema %}
