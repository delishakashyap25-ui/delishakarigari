<section class="delisha-grid" style="background: {{ section.settings.bg_color }}; {% if section.settings.bg_image != blank %}background-image:url({{ section.settings.bg_image | image_url }});{% endif %}">
  <div class="grid-wrapper">
    {% for block in section.blocks %}
      <div class="grid-item size-{{ block.settings.card_size }}" {{ block.shopify_attributes }}>
        
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.heading | escape }}" loading="lazy" width="1000" height="800">
        {% else %}
          {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}

        <div class="overlay" style="background: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity }};"></div>

        <div class="content pos-{{ block.settings.content_position }}">
          {% if block.settings.heading != blank %}
            <h2>{{ block.settings.heading }}</h2>
          {% endif %}
          
          {% if block.settings.text != blank %}
            <p>{{ block.settings.text }}</p>
          {% endif %}

          <div class="btn-group">
            {% if block.settings.btn1_label != blank %}
              <a href="{{ block.settings.btn1_link | default: '#' }}" class="btn style-{{ block.settings.btn1_style }}">
                {{ block.settings.btn1_label }}
              </a>
            {% endif %}
            
            {% if block.settings.btn2_label != blank %}
              <a href="{{ block.settings.btn2_link | default: '#' }}" class="btn style-{{ block.settings.btn2_style }}">
                {{ block.settings.btn2_label }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
.delisha-grid {
  padding: 60px 0;
  background-size: cover;
  background-position: center;
}

.grid-wrapper {
  width: 85%;
  max-width: 1400px;
  margin: auto;
  display: grid;
  grid-template-columns: 1.2fr 1fr 1.2fr;
  grid-auto-rows: minmax(250px, auto);
  gap: 25px;
}

/* ITEMS */
.grid-item {
  position: relative;
  overflow: hidden;
  border-radius: 20px;
  min-height: 250px;
}

.grid-item img, .grid-item svg.placeholder-svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  transition: transform 0.5s ease;
}

.grid-item:hover img {
  transform: scale(1.05);
}

/* Dynamic Sizes */
.size-tall {
  grid-row: span 2;
  min-height: 525px; /* roughly 250 + 250 + 25 gap */
}
.size-standard {
  grid-row: span 1;
}
.size-wide {
  grid-column: span 2;
}

/* Explicit Mosaic Layout for first 4 blocks */
@media(min-width: 769px) {
  .grid-item:nth-child(1) { grid-column: 1; grid-row: 1 / 3; }
  .grid-item:nth-child(2) { grid-column: 2; grid-row: 1; }
  .grid-item:nth-child(3) { grid-column: 2; grid-row: 2; }
  .grid-item:nth-child(4) { grid-column: 3; grid-row: 1 / 3; }
}

/* OVERLAY */
.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* CONTENT */
.content {
  position: absolute;
  z-index: 2;
  color: #fff;
  width: 90%;
}

.pos-bottom-left {
  bottom: 30px;
  left: 30px;
}

.pos-center {
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  width: 80%;
}

.content h2 {
  font-size: 28px;
  margin-bottom: 10px;
  font-family: var(--font-heading, serif);
  margin-top: 0;
}

.pos-center h2 {
  font-size: 22px;
}

.content p {
  font-size: 14px;
  margin-bottom: 20px;
  opacity: 0.9;
  line-height: 1.5;
}

.btn-group {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.pos-center .btn-group {
  justify-content: center;
}

/* BUTTONS */
.btn {
  display: inline-block;
  padding: 12px 24px;
  text-decoration: none;
  border-radius: 6px;
  font-weight: 500;
  transition: all 0.3s;
  text-align: center;
  font-family: var(--font-body, sans-serif);
}

.btn.style-gold {
  background: #d4a75d;
  color: #000;
}
.btn.style-gold:hover {
  background: #b08d51;
  color: #fff;
}

.btn.style-dark {
  background: #2c1d12;
  color: #fff;
}
.btn.style-dark:hover {
  background: #000;
}

.btn.style-outline {
  border: 1px solid #fff;
  background: transparent;
  color: #fff;
}
.btn.style-outline:hover {
  background: #fff;
  color: #000;
}

/* MOBILE */
@media(max-width: 992px) {
  .grid-wrapper {
    grid-template-columns: 1fr 1fr;
  }
}

@media(max-width: 768px) {
  .grid-wrapper {
    grid-template-columns: 1fr;
    width: 90%;
  }
  .size-tall, .size-wide {
    grid-row: span 1;
    grid-column: span 1;
    min-height: 350px;
  }
  .pos-bottom-left {
    bottom: 20px;
    left: 20px;
  }
}
</style>

{% schema %}
{
  "name": "Delisha Grid Collection",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Section BG Color" },
    { "type": "image_picker", "id": "bg_image", "label": "Section BG Image" },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.3
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Block",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "card_size",
          "label": "Card Size",
          "options": [
            { "value": "standard", "label": "Standard (1x1)" },
            { "value": "tall", "label": "Tall (1x2)" },
            { "value": "wide", "label": "Wide (2x1)" }
          ],
          "default": "standard",
          "info": "Tall takes 2 rows, Standard takes 1 row."
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content Position",
          "options": [
            { "value": "bottom-left", "label": "Bottom Left" },
            { "value": "center", "label": "Center" }
          ],
          "default": "bottom-left"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Collection Title" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "header", "content": "Button 1" },
        { "type": "text", "id": "btn1_label", "label": "Label", "default": "Explore" },
        { "type": "url", "id": "btn1_link", "label": "Link" },
        {
          "type": "select",
          "id": "btn1_style",
          "label": "Style",
          "options": [
            { "value": "gold", "label": "Gold" },
            { "value": "dark", "label": "Dark" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "gold"
        },
        { "type": "header", "content": "Button 2 (Optional)" },
        { "type": "text", "id": "btn2_label", "label": "Label" },
        { "type": "url", "id": "btn2_link", "label": "Link" },
        {
          "type": "select",
          "id": "btn2_style",
          "label": "Style",
          "options": [
            { "value": "gold", "label": "Gold" },
            { "value": "dark", "label": "Dark" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "outline"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Delisha Grid Collection",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "card_size": "tall",
            "content_position": "bottom-left",
            "heading": "Spiritual Collection",
            "text": "Decor featuring sacred motifs, god idols & traditional symbols.",
            "btn1_label": "Explore Divine",
            "btn1_style": "gold"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "card_size": "standard",
            "content_position": "center",
            "heading": "Festive Bandhanwar",
            "btn1_label": "Explore",
            "btn1_style": "gold"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "card_size": "standard",
            "content_position": "center",
            "heading": "Minimal Bandhanwar",
            "btn1_label": "Explore",
            "btn1_style": "gold"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "card_size": "tall",
            "content_position": "bottom-left",
            "heading": "Custom Bandhanwar",
            "text": "Get your custom bandhanwar designed by our expert karigars.",
            "btn1_label": "Request Custom",
            "btn1_style": "dark",
            "btn2_label": "WhatsApp Us",
            "btn2_style": "outline"
          }
        }
      ]
    }
  ]
}
{% endschema %}