<div
  class="product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="related-products-section padding-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
      <div class="rp-container">
        {% if section.settings.heading != blank %}
          <h2 class="rp-heading" style="text-align: {{ section.settings.heading_align }}; color: {{ section.settings.text_color }};">{{ section.settings.heading }}</h2>
        {% endif %}
        
        <div class="rp-grid columns-{{ section.settings.columns_desktop }}">
          {%- for recommendation in recommendations.products -%}
            <div class="rp-item">
              {% render 'product-card', product: recommendation %}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (function() {
    const handleIntersection = (entries, observer) => {
      if (!entries[0].isIntersecting) return;
      observer.unobserve(productRecommendationsSection);

      const url = productRecommendationsSection.dataset.url;

      fetch(url)
        .then(response => response.text())
        .then(text => {
          const html = document.createElement('div');
          html.innerHTML = text;
          const recommendations = html.querySelector('.product-recommendations');

          if (recommendations && recommendations.innerHTML.trim().length > 0) {
            productRecommendationsSection.innerHTML = recommendations.innerHTML;
          }
        })
        .catch(e => {
          console.error('Related Products Fetch Error:', e);
        });
    };

    const productRecommendationsSection = document.querySelector('.product-recommendations');
    if (productRecommendationsSection) {
      const observer = new IntersectionObserver(handleIntersection, {rootMargin: '0px 0px 400px 0px'});
      observer.observe(productRecommendationsSection);
    }
  })();
</script>

<style>
.related-products-section {
  font-family: var(--font-body, sans-serif);
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  border-top: 1px solid #eee;
  margin-top: 50px;
}
.rp-container {
  width: 90%;
  max-width: 1400px;
  margin: 0 auto;
}
.rp-heading {
  font-family: var(--font-heading, serif);
  font-size: 36px;
  font-weight: 600;
  margin: 0 0 40px 0;
  letter-spacing: 1px;
}
.rp-grid {
  display: grid;
  gap: 30px;
}
.rp-grid.columns-2 { grid-template-columns: repeat(2, 1fr); }
.rp-grid.columns-3 { grid-template-columns: repeat(3, 1fr); }
.rp-grid.columns-4 { grid-template-columns: repeat(4, 1fr); }

@media(max-width: 992px) {
  .rp-grid {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 20px !important;
  }
}
@media(max-width: 768px) {
  .rp-heading { 
    font-size: 24px; 
    margin-bottom: 25px;
  }
  .rp-grid {
    gap: 15px !important;
  }
}
</style>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Columns on Desktop"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 60,
      "label": "Padding Top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 60,
      "label": "Padding Bottom"
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}
