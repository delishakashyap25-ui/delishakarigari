<footer class="delisha-footer">

  <!-- Subtle Heritage Background -->
  <div class="delisha-footer-pattern" aria-hidden="true">
    <span>✦</span>
    <span>◇</span>
    <span>✦</span>
    <span>◇</span>
    <span>✦</span>
    <span>◇</span>
    <span>✦</span>
    <span>◇</span>
  </div>

  <div class="delisha-footer-container">

    <div class="delisha-footer-main">

      <!-- BRAND -->
      <div class="delisha-footer-brand">

        <div class="delisha-footer-logo">
          <a href="{{ routes.root_url }}">
            <img
              src="{{ 'dk-logo.png' | asset_url }}"
              alt="DELISHA KARIGARI"
              style="max-width: 200px; height: auto;"
              loading="lazy"
              width="200"
              height="60"
            >
          </a>
        </div>

        <p class="delisha-footer-tagline">
          Handmade Celebrations. Thoughtful Gifting. Beautifully Yours.
        </p>

        <p class="delisha-footer-description">
          Delisha Karigari is a handmade and personalised gifting brand built around the simple idea that every celebration deserves something made with love. Thoughtfully designed festive décor, thalis, torans and bespoke gifts crafted with warmth and Indian heritage.
        </p>

        <!-- NEWSLETTER -->
        <div class="delisha-newsletter">

          <p class="delisha-newsletter-title">
            Stay connected with Delisha Karigari
          </p>

          {% form 'customer', class: 'delisha-newsletter-form' %}

          <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >

          <div class="delisha-newsletter-input">

            <input
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="Enter your email"
                autocomplete="email"
                required
              >

            <button
                type="submit"
                aria-label="Subscribe"
              >
                →
              </button>

          </div>

          {% if form.posted_successfully? %}
          <p class="delisha-newsletter-success">
            Thank you for joining us.
          </p>
          {% endif %}

          {% endform %}

        </div>

        <!-- SOCIAL -->
        <div class="delisha-social">

          <a href="{{ section.settings.social_instagram_link | default: 'https://www.instagram.com/delishakarigari/' }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            Instagram
          </a>

        <a href="mailto:delishakarigari@gmail.com" class="delisha-email">
          Mail
        </a>

          <a href="{{ section.settings.social_facebook_link | default: 'https://www.facebook.com/profile.php?id=61578229348792' }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            Facebook
          </a>

        </div>

      </div>


      <!-- SHOP -->
      <div class="delisha-footer-column">

        <h3>SHOP</h3>

        <a href="{{ routes.all_products_collection_url }}">
          All Collections
        </a>

        <a href="{{ routes.collections_url }}/navratri-decor">
          The Navratri Edit
        </a>

        <a href="{{ routes.collections_url }}/karwa-chauth-special">
          Karwa Chauth Specials
        </a>

        <a href="{{ routes.collections_url }}/diwali-decor">
          Diwali Décor
        </a>

        <a href="{{ routes.collections_url }}/bandhanwar">
          Bandhanwars &amp; Torans
        </a>

        <a href="{{ routes.collections_url }}/latkan">
          Door Latkans
        </a>

        <a href="{{ routes.collections_url }}/for-her-accessories">
          Gifts for Her
        </a>

        <a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=199">
          Under ₹199
        </a>

      </div>


      <!-- SUPPORT -->
      <div class="delisha-footer-column">

        <h3>SUPPORT</h3>

        <a href="/pages/contact">
          Contact Us
        </a>

        <a href="/pages/faqs">
          FAQs
        </a>

        <a href="/policies/shipping-policy">
          Shipping & Delivery
        </a>

        <a href="/policies/refund-policy">
          Returns & Refunds
        </a>

        <a href="/pages/shipping-policy">
          Track Your Order
        </a>

      </div>


      <!-- CONTACT & CRAFT BASE -->
      <div class="delisha-footer-column delisha-contact-column">

        <h3>CONNECT WITH US</h3>

        <p>
          Handcrafted with devotion in Delhi.<br>
          Sent with love to celebrations across India.
        </p>

        <div class="delisha-footer-map-card">
          <div class="delisha-footer-map-frame">
            <iframe
              src="https://maps.google.com/maps?q=28.688103,77.129776&hl=en&z=14&output=embed"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Delisha Karigari Delhi Craft Base Map"
            ></iframe>
            <div class="delisha-footer-map-badge">
              <span class="delisha-footer-map-badge-dot"></span>
              <span>Delhi Craft Base</span>
            </div>
          </div>
          <div class="delisha-footer-map-meta">
            <div class="delisha-footer-map-loc">
              <strong>DELISHA KARIGARI</strong>
              <span>New Delhi, India</span>
            </div>
            <a
              href="https://maps.app.goo.gl/mfP6h2cxUP7iuDdH7"
              target="_blank"
              rel="noopener noreferrer"
              class="delisha-footer-map-dir"
              aria-label="Open Delisha Karigari on Google Maps"
            >
              <span>Get Directions</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        </div>

      </div>

    </div>


    <!-- FOOTER BOTTOM -->

    <div class="delisha-footer-bottom">

      <p>
        © 2026 DELISHA KARIGARI. HANDCRAFTED WITH LOVE IN INDIA.
      </p>

      <div class="delisha-legal">

        <a href="/policies/privacy-policy">
          Privacy Policy
        </a>

        <span>·</span>

        <a href="/policies/terms-of-service">
          Terms & Conditions
        </a>

      </div>

      <a href="#" class="delisha-back-top" id="delishaBackTop" aria-label="Back to top">
        ↑
      </a>

    </div>

  </div>

</footer>


<style>
  /* =========================================================
   DELISHA KARIGARI FOOTER
   ========================================================= */

  .delisha-footer {

    position: relative;

    width: 100%;

    background: #F7F1EA;

    color: #35151F;

    overflow: hidden;

    border-top: 1px solid #E7DCD4;

  }


  /* =========================================================
   BACKGROUND HERITAGE PATTERN
   ========================================================= */

  .delisha-footer-pattern {

    position: absolute;

    inset: 0;

    pointer-events: none;

    overflow: hidden;

    opacity: 0.055;

  }

  .delisha-footer-pattern span {

    position: absolute;

    font-family: serif;

    font-size: 150px;

    color: #64142D;

    font-weight: 400;

  }

  .delisha-footer-pattern span:nth-child(1) {
    top: -50px;
    left: 4%;
  }

  .delisha-footer-pattern span:nth-child(2) {
    top: 20%;
    left: 28%;
    font-size: 90px;
  }

  .delisha-footer-pattern span:nth-child(3) {
    bottom: -60px;
    left: 48%;
  }

  .delisha-footer-pattern span:nth-child(4) {
    top: 10%;
    right: 28%;
    font-size: 100px;
  }

  .delisha-footer-pattern span:nth-child(5) {
    bottom: -70px;
    right: 5%;
  }

  .delisha-footer-pattern span:nth-child(6) {
    top: 45%;
    right: 15%;
    font-size: 70px;
  }

  .delisha-footer-pattern span:nth-child(7) {
    top: 60%;
    left: 12%;
    font-size: 80px;
  }

  .delisha-footer-pattern span:nth-child(8) {
    bottom: 5%;
    left: 35%;
    font-size: 65px;
  }


  /* =========================================================
   CONTAINER
   ========================================================= */

  .delisha-footer-container {

    position: relative;

    z-index: 2;

    max-width: 1320px;

    margin: 0 auto;

    padding: 65px 50px 0;

  }


  /* =========================================================
   MAIN FOOTER
   ========================================================= */

  .delisha-footer-main {

    display: grid;

    grid-template-columns:
      2.2fr 1fr 1fr 1.25fr;

    gap: 60px;

    padding-bottom: 55px;

  }


  /* =========================================================
   BRAND
   ========================================================= */

  .delisha-footer-brand {

    max-width: 440px;

  }

  .delisha-footer-logo {

    font-family: Georgia, serif;

    font-size: 35px;

    font-weight: 700;

    letter-spacing: -1px;

    color: #35151F;

    margin-bottom: 10px;

  }

  .delisha-footer-logo span {

    font-size: 18px;

    margin: 0 4px;

    color: #64142D;

  }

  .delisha-footer-tagline {

    font-size: 14px;

    font-weight: 600;

    letter-spacing: 0.3px;

    color: #64142D;

    margin: 0 0 12px;

  }

  .delisha-footer-description {

    max-width: 390px;

    font-size: 14px;

    line-height: 1.7;

    color: #75656A;

    margin: 0 0 25px;

  }


  /* =========================================================
   NEWSLETTER
   ========================================================= */

  .delisha-newsletter-title {

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 1.3px;

    text-transform: uppercase;

    margin: 0 0 10px;

    color: #35151F;

  }

  .delisha-newsletter-input {

    width: 100%;

    max-width: 390px;

    height: 48px;

    display: flex;

    align-items: center;

    border: 1px solid #D8C9C0;

    border-radius: 4px;

    background: rgba(255, 255, 255, 0.55);

  }

  .delisha-newsletter-input input {

    flex: 1;

    min-width: 0;

    border: none;

    outline: none;

    background: transparent;

    padding: 0 15px;

    font-size: 13px;

    color: #35151F;

  }

  .delisha-newsletter-input input::placeholder {

    color: #9B8B8F;

  }

  .delisha-newsletter-input button {

    width: 48px;

    height: 48px;

    border: none;

    background: #64142D;

    color: #ffffff;

    font-size: 20px;

    cursor: pointer;

    transition: 0.3s ease;

  }

  .delisha-newsletter-input button:hover {

    background: #35151F;

  }

  .delisha-newsletter-success {

    font-size: 12px;

    color: #64142D;

    margin-top: 8px;

  }


  /* =========================================================
   SOCIAL
   ========================================================= */

  .delisha-social {

    display: flex;

    gap: 18px;

    margin-top: 22px;

  }

  .delisha-social a {

    font-size: 11px;

    font-weight: 600;

    letter-spacing: 0.8px;

    text-transform: uppercase;

    color: #35151F;

    text-decoration: none;

    border-bottom: 1px solid #CDBBB1;

    padding-bottom: 3px;

    transition: 0.3s ease;

  }

  .delisha-social a:hover {

    color: #64142D;

    border-color: #64142D;

  }


  /* =========================================================
   FOOTER COLUMNS
   ========================================================= */

  .delisha-footer-column {

    display: flex;

    flex-direction: column;

    align-items: flex-start;

  }

  .delisha-footer-column h3 {

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 1.5px;

    color: #64142D;

    margin: 4px 0 20px;

  }

  .delisha-footer-column a {

    font-size: 14px;

    line-height: 1.5;

    color: #75656A;

    text-decoration: none;

    margin-bottom: 11px;

    transition: 0.3s ease;

  }

  .delisha-footer-column a:hover {

    color: #64142D;

    transform: translateX(2px);

  }


  /* =========================================================
   CONTACT & MAP WIDGET
   ========================================================= */

  .delisha-contact-column p {

    max-width: 270px;

    color: #75656A;

    font-size: 13px;

    line-height: 1.65;

    margin: 0 0 12px;

  }

  .delisha-footer-map-card {

    width: 100%;

    max-width: 270px;

    background: #FFFFFF;

    border: 1px solid #E1D4CC;

    border-radius: 8px;

    overflow: hidden;

    box-shadow: 0 4px 14px rgba(100, 20, 45, 0.05);

    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;

    margin-top: 2px;

  }

  .delisha-footer-map-card:hover {

    border-color: #B89A62;

    box-shadow: 0 6px 20px rgba(100, 20, 45, 0.1);

    transform: translateY(-2px);

  }

  .delisha-footer-map-frame {

    position: relative;

    width: 100%;

    height: 110px;

    overflow: hidden;

    background: #EFE8E1;

  }

  .delisha-footer-map-frame iframe {

    width: 100%;

    height: 100%;

    border: 0;

    filter: saturate(0.9) contrast(1.02);

    display: block;

  }

  .delisha-footer-map-badge {

    position: absolute;

    top: 8px;

    left: 8px;

    z-index: 2;

    display: inline-flex;

    align-items: center;

    gap: 5px;

    background: rgba(255, 255, 255, 0.94);

    backdrop-filter: blur(4px);

    padding: 3px 8px;

    border-radius: 20px;

    font-size: 10px;

    font-weight: 600;

    color: #64142D;

    letter-spacing: 0.3px;

    border: 1px solid rgba(184, 154, 98, 0.35);

    pointer-events: none;

    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);

  }

  .delisha-footer-map-badge-dot {

    width: 6px;

    height: 6px;

    border-radius: 50%;

    background: #2E7D32;

    display: inline-block;

  }

  .delisha-footer-map-meta {

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 8px 12px;

    background: #FAF6F0;

    border-top: 1px solid #EADBCE;

    gap: 8px;

  }

  .delisha-footer-map-loc {

    display: flex;

    flex-direction: column;

    text-align: left;

    min-width: 0;

  }

  .delisha-footer-map-loc strong {

    font-size: 10.5px;

    font-weight: 700;

    color: #35151F;

    letter-spacing: 0.5px;

    line-height: 1.2;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;

  }

  .delisha-footer-map-loc span {

    font-size: 9.5px;

    color: #75656A;

    line-height: 1.3;

  }

  .delisha-footer-map-dir {

    display: inline-flex;

    align-items: center;

    gap: 4px;

    font-size: 10.5px;

    font-weight: 600;

    color: #64142D;

    text-decoration: none;

    padding: 5px 9px;

    border-radius: 4px;

    background: rgba(100, 20, 45, 0.07);

    border: 1px solid rgba(100, 20, 45, 0.15);

    white-space: nowrap;

    flex-shrink: 0;

    transition: all 0.25s ease;

  }

  .delisha-footer-map-dir:hover {

    background: #64142D;

    color: #FFFFFF !important;

    border-color: #64142D;

    transform: none;

  }

  .delisha-footer-whatsapp {

    display: inline-flex !important;

    align-items: center;

    gap: 9px;

    background: #64142D;

    color: #ffffff !important;

    padding: 11px 17px;

    border-radius: 3px;

    font-size: 12px !important;

    font-weight: 600;

    margin-bottom: 14px !important;

    text-decoration: none;

  }

  .delisha-footer-whatsapp:hover {

    background: #35151F;

    color: #ffffff !important;

    transform: none !important;

  }

  .delisha-footer-whatsapp span {

    font-size: 11px;

  }

  .delisha-email {

    font-size: 12px !important;

  }


  /* =========================================================
   BOTTOM
   ========================================================= */

  .delisha-footer-bottom {

    min-height: 65px;

    border-top: 1px solid #E1D4CC;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    position: relative;

  }

  .delisha-footer-bottom p {

    margin: 0;

    font-size: 10px;

    letter-spacing: 1px;

    color: #75656A;

  }

  .delisha-legal {

    display: flex;

    align-items: center;

    gap: 10px;

  }

  .delisha-legal a {

    font-size: 10px;

    letter-spacing: 0.5px;

    color: #75656A;

    text-decoration: none;

  }

  .delisha-legal a:hover {

    color: #64142D;

  }

  .delisha-back-top {

    width: 34px;

    height: 34px;

    display: flex;

    align-items: center;

    justify-content: center;

    border: 1px solid #D8C9C0;

    border-radius: 50%;

    color: #64142D;

    text-decoration: none;

    font-size: 16px;

    transition: 0.3s ease;

  }

  .delisha-back-top:hover {

    background: #64142D;

    color: #ffffff;

    border-color: #64142D;

  }


  /* =========================================================
   TABLET
   ========================================================= */

  @media screen and (max-width: 1000px) {

    .delisha-footer-main {

      grid-template-columns: 1.5fr 1fr 1fr;

      gap: 40px;

    }

    .delisha-footer-brand {

      grid-column: 1 / -1;

      max-width: 600px;

    }

  }


  /* =========================================================
   MOBILE
   ========================================================= */

  @media screen and (max-width: 700px) {

    .delisha-footer-container {

      padding: 45px 22px 0;

    }

    .delisha-footer-main {

      grid-template-columns: 1fr 1fr;

      gap: 35px 25px;

      padding-bottom: 35px;

    }

    .delisha-footer-brand {

      grid-column: 1 / -1;

    }

    .delisha-contact-column {

      grid-column: 1 / -1;

      width: 100%;

      margin-top: 5px;

      padding-top: 18px;

      border-top: 1px dashed #E2D4CB;

    }

    .delisha-contact-column p {

      max-width: 100%;

    }

    .delisha-footer-map-card {

      max-width: 100%;

    }

    .delisha-footer-logo {

      font-size: 28px;

    }

    .delisha-footer-description {

      font-size: 13px;

    }

    .delisha-newsletter-input {

      max-width: 100%;

    }

    .delisha-footer-bottom {

      min-height: auto;

      padding: 18px 0;

      flex-wrap: wrap;

    }

    .delisha-footer-bottom p {

      width: 100%;

      line-height: 1.6;

    }

    .delisha-legal {

      order: 3;

      width: 100%;

    }

    .delisha-back-top {

      margin-left: auto;

    }

  }
</style>


<script>
  document.addEventListener('DOMContentLoaded', function() {

  var backTop = document.getElementById('delishaBackTop');

  if (backTop) {

    backTop.addEventListener('click', function(e) {

      e.preventDefault();

      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });

    });

  }

});

</script>


