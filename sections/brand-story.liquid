<section class="brand-story-sec" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;">
  
  {% if section.settings.bg_pattern != blank %}
    <div class="bs-pattern bs-pattern-left" style="background-image: url({{ section.settings.bg_pattern | image_url }});"></div>
    <div class="bs-pattern bs-pattern-right" style="background-image: url({{ section.settings.bg_pattern | image_url }});"></div>
  {% endif %}

  <div class="bs-container">
    
    <!-- LEFT IMAGE -->
    <div class="bs-image bs-image-left">
      {% if section.settings.image_left != blank %}
        <img src="{{ section.settings.image_left | image_url: width: 600 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="600" height="600">
      {% else %}
        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

    <!-- CENTER CONTENT -->
    <div class="bs-content">
      {% if section.settings.heading != blank %}
        <h2 class="bs-heading" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.top_tags != blank %}
        <div class="bs-tags">
          {% assign t_tags = section.settings.top_tags | split: ',' %}
          {% for tag in t_tags %}
            <span class="bs-tag">{{ tag | strip }}</span>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <h3 class="bs-subheading" style="color: {{ section.settings.subheading_color }};">{{ section.settings.subheading }}</h3>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="bs-text" style="color: {{ section.settings.text_color }};">{{ section.settings.text }}</p>
      {% endif %}

      {% if section.settings.bottom_tags != blank %}
        <div class="bs-tags bottom-tags">
          {% assign b_tags = section.settings.bottom_tags | split: ',' %}
          {% for tag in b_tags %}
            <span class="bs-tag">{{ tag | strip }}</span>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.btn_label != blank %}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="bs-btn" style="background-color: {{ section.settings.btn_bg_color }}; color: {{ section.settings.btn_text_color }};">
          {{ section.settings.btn_label }}
        </a>
      {% endif %}
    </div>

    <!-- RIGHT IMAGE -->
    <div class="bs-image bs-image-right">
      {% if section.settings.image_right != blank %}
        <img src="{{ section.settings.image_right | image_url: width: 600 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="600" height="600">
      {% else %}
        {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

  </div>
</section>

<style>
.brand-story-sec {
  position: relative;
  overflow: hidden;
  font-family: var(--font-body, sans-serif);
}

/* Background Mandala Patterns */
.bs-pattern {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 500px;
  height: 500px;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  opacity: 0.05;
  z-index: 0;
  pointer-events: none;
}
.bs-pattern-left {
  left: -150px;
}
.bs-pattern-right {
  right: -150px;
}

/* Main Container */
.bs-container {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 95%;
  max-width: 1600px;
  margin: 0 auto;
  gap: 40px;
}

/* Images */
.bs-image {
  flex: 0 0 22%;
  max-width: 350px;
  aspect-ratio: 3 / 4;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0,0,0,0.25);
  transition: transform 0.5s ease;
}
.bs-image:hover {
  transform: translateY(-10px);
}
.bs-image img, .bs-image svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.placeholder-svg {
  background-color: #f0f0f0;
}

/* Center Content */
.bs-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 20px;
}

.bs-heading {
  font-family: var(--font-heading, serif);
  font-size: 46px;
  font-weight: 600;
  letter-spacing: 5px;
  text-transform: uppercase;
  margin: 0 0 35px 0;
  line-height: 1.2;
}

.bs-tags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 30px;
}
.bottom-tags {
  margin-top: 10px;
  margin-bottom: 40px;
}
.bs-tag {
  background: #fdfaf5;
  color: #333;
  padding: 8px 22px;
  border-radius: 30px;
  font-size: 13px;
  font-weight: 500;
  box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

.bs-subheading {
  font-family: var(--font-heading, serif);
  font-size: 24px;
  font-weight: 600;
  margin: 0 0 20px 0;
}

.bs-text {
  font-size: 15px;
  line-height: 1.6;
  max-width: 600px;
  margin: 0 0 20px 0;
  opacity: 0.9;
}

.bs-btn {
  display: inline-block;
  padding: 14px 40px;
  border-radius: 6px;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}
.bs-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  opacity: 0.9;
}

/* Responsive */
@media(max-width: 1200px) {
  .bs-heading { font-size: 36px; }
  .bs-image { flex: 0 0 28%; }
}

@media(max-width: 992px) {
  .bs-container {
    flex-direction: column;
    gap: 50px;
  }
  .bs-content {
    order: -1; /* Content on top for mobile */
  }
  .bs-image {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 4 / 5;
  }
  .bs-image-right {
    display: none; /* Hide right image on small screens to save space, or keep it */
  }
}

@media(max-width: 768px) {
  .bs-heading { font-size: 28px; letter-spacing: 2px; }
  .bs-subheading { font-size: 20px; }
  .bs-tag { padding: 6px 16px; font-size: 12px; }
}
</style>

{% schema %}
{
  "name": "Brand Story Layout",
  "settings": [
    {
      "type": "header",
      "content": "Section Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#6c655b"
    },
    {
      "type": "image_picker",
      "id": "bg_pattern",
      "label": "Background Mandala Pattern"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left Image"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "Right Image"
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "DELISHA KARIGARI"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#d8a85e"
    },
    {
      "type": "text",
      "id": "top_tags",
      "label": "Top Tags (Comma separated)",
      "default": "Handmade, Premium Material, Made in India, Customizable"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Experience the beauty of Indian craftsmanship."
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#2b221a"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph Text",
      "default": "Each decor piece is handmade and crafted with traditional detailing"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#8a96a0"
    },
    {
      "type": "text",
      "id": "bottom_tags",
      "label": "Bottom Tags (Comma separated)",
      "default": "Evil Eye Decor, Bandhanwar, Wall Hangings, Gifting Collection"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background",
      "default": "#cda46f"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 80,
      "label": "Padding Top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 80,
      "label": "Padding Bottom"
    }
  ],
  "presets": [
    {
      "name": "Brand Story Layout"
    }
  ]
}
{% endschema %}
