{%- liquid
  assign display_title = collection.title | default: 'All Collections'
  if collection.handle == 'all' or collection.handle == blank
    assign display_title = 'All Collections'
  endif
-%}

<div class="dk-collection-hero">
  <div class="dk-collection-hero__inner">
    {% if section.settings.show_breadcrumb %}
      <nav class="dk-collection-hero__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="sep">/</span>
        <a href="{{ routes.collections_url | default: '/collections' }}">Collections</a>
        <span class="sep">/</span>
        <span class="current">{{ display_title }}</span>
      </nav>
    {% endif %}

    <h1 class="dk-collection-hero__title-minimal">
      {{ display_title }}
    </h1>
  </div>
</div>

<style>
  .dk-collection-hero {
    position: relative;
    width: 100%;
    background-color: #FAF7F2;
    border-bottom: 1px solid #ECE4D8;
    padding: 18px 16px 14px;
    box-sizing: border-box;
    text-align: center;
    overflow: hidden;
  }

  .dk-collection-hero__inner {
    position: relative;
    z-index: 2;
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .dk-collection-hero__title-minimal {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 600;
    line-height: 1.2;
    color: #211216;
    margin: 0;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .dk-collection-hero__breadcrumb {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.8px;
    color: #8C7B75;
    margin-bottom: 0.85rem;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .dk-collection-hero__breadcrumb a {
    color: #6A5B55;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .dk-collection-hero__breadcrumb a:hover {
    color: var(--dk-color-primary, #641A28);
  }

  .dk-collection-hero__breadcrumb .sep {
    color: #B5A8A3;
    font-size: 0.7rem;
  }

  .dk-collection-hero__breadcrumb .current {
    color: var(--dk-color-primary, #641A28);
    font-weight: 600;
  }

  .dk-collection-hero__eyebrow {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: #9E7D42;
    margin-bottom: 0.6rem;
    display: inline-block;
  }

  .dk-collection-hero__title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 600;
    line-height: 1.2;
    color: #211216;
    margin: 0 0 0.85rem;
    letter-spacing: -0.2px;
  }

  .dk-collection-hero__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--dk-color-primary, #641A28);
  }

  .dk-hero-title-br {
    display: block;
  }

  .dk-collection-hero__description {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: clamp(0.86rem, 1.05vw, 0.95rem);
    line-height: 1.65;
    color: #5A4E49;
    max-width: 660px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .dk-collection-hero {
      padding: 24px 16px 22px;
    }
    .dk-collection-hero__title {
      font-size: 1.65rem;
      line-height: 1.25;
    }
    .dk-hero-title-br {
      display: inline;
    }
    .dk-collection-hero__description {
      font-size: 0.82rem;
      line-height: 1.55;
    }
    .dk-collection-hero__eyebrow {
      font-size: 0.65rem;
      letter-spacing: 1.8px;
    }
  }
</style>

{% schema %}
{
  "name": "Collection Banner",
  "settings": [
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Fallback Title (if empty)",
      "default": "Collection"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show Collection Featured Image as Background",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Custom Banner Background Image"
    },
    {
      "type": "color",
      "id": "banner_bg_color",
      "label": "Background Color",
      "default": "#F9F5EE"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show Breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Collection Description",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Collection Banner"
    }
  ]
}
{% endschema %}