<section
  id="dk-product-carousel-{{ section.id }}"
  class="dk-carousel-sec"
  style="background-color: {{ section.settings.bg_color | default: '#F2E5DD' }}; padding: {{ section.settings.padding_top | default: 70 }}px 0 {{ section.settings.padding_bottom | default: 70 }}px 0;"
>
  <div class="container">
    <div class="dk-section-header dk-carousel-header flex justify-between align-center">
      <div>
        {%- if section.settings.subheading != blank -%}
          <span class="dk-subtitle">{{ section.settings.subheading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="dk-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>

      <div class="dk-carousel-nav desktop-only">
        <button
          type="button"
          class="dk-carousel-btn prev"
          aria-label="Previous Products"
          onclick="document.getElementById('dk-carousel-track-{{ section.id }}').scrollBy({left: -320, behavior: 'smooth'})"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button
          type="button"
          class="dk-carousel-btn next"
          aria-label="Next Products"
          onclick="document.getElementById('dk-carousel-track-{{ section.id }}').scrollBy({left: 320, behavior: 'smooth'})"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>

    {%- assign collection = collections[section.settings.collection] -%}
    {%- assign limit = section.settings.products_to_show | default: 8 -%}

    <div class="dk-carousel-wrapper">
      <div class="dk-carousel-track" id="dk-carousel-track-{{ section.id }}">
        {%- assign prod_list = collection.products -%}
        {%- if prod_list == blank or prod_list.size == 0 -%}
          {%- assign prod_list = collections.all.products -%}
        {%- endif -%}

        {%- if prod_list != blank and prod_list.size > 0 -%}
          {%- for product in prod_list limit: limit -%}
            <div class="dk-carousel-slide">
              {% render 'product-card', product: product %}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} REAL CATALOG SHOWCASE FALLBACK {%- endcomment -%}
          {%- assign fallback_titles = "Artisanal Peacock Brass Diya|Shubh Labh Toran Bandhanwar|Karwa Chauth Brass Puja Thali|Pearl & Mirror Door Latkan|Kundan Jhumka & Velvet Potli|Floral Floating Diya Urli|Personalised Festive Box|Bridal Pearl Hair Accessories" | split: "|" -%}
          {%- assign fallback_prices = "₹799.00|₹899.00|₹1,299.00|₹599.00|₹1,199.00|₹699.00|₹1,499.00|₹499.00" | split: "|" -%}
          {%- assign fallback_compares = "₹1,099.00|₹1,299.00|₹1,799.00|₹899.00|₹1,699.00|₹999.00|₹1,999.00|₹699.00" | split: "|" -%}
          {%- assign fallback_imgs = "dk-cat-diwali-decor.jpg|dk-cat-bandhanwar.jpg|dk-cat-karwa-chauth.jpg|dk-cat-latkan.jpg|dk-occ-her.jpg|dk-occ-diwali.jpg|dk-cat-festive.jpg|dk-cat-for-her.jpg" | split: "|" -%}
          
          {%- for i in (0..7) -%}
            {%- assign p_title = fallback_titles[i] -%}
            {%- assign p_price = fallback_prices[i] -%}
            {%- assign p_compare = fallback_compares[i] -%}
            {%- assign p_img = fallback_imgs[i] -%}

            <div class="dk-carousel-slide">
              <div class="dk-product-card">
                <div class="dk-product-card__media">
                  <a href="{{ routes.all_products_collection_url }}" class="dk-product-card__image-link" aria-label="{{ p_title | escape }}">
                    <img
                      src="{{ p_img | asset_url }}"
                      alt="{{ p_title | escape }}"
                      class="dk-product-card__img dk-product-card__img--primary"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  </a>
                  <div class="dk-product-card__badges">
                    <span class="dk-badge dk-badge--sale">TRENDING</span>
                  </div>
                  <button
                    type="button"
                    class="dk-product-card__wishlist-btn"
                    aria-label="Add {{ p_title | escape }} to wishlist"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                  </button>
                </div>
                <div class="dk-product-card__info">
                  <h3 class="dk-product-card__title">
                    <a href="{{ routes.all_products_collection_url }}">{{ p_title }}</a>
                  </h3>
                  <div class="dk-product-card__price">
                    <span class="dk-product-card__price-current dk-product-card__price--sale">{{ p_price }}</span>
                    <s class="dk-product-card__price-compare">{{ p_compare }}</s>
                  </div>
                  <a href="{{ routes.all_products_collection_url }}" class="dk-product-card__add-btn" style="display: block; text-decoration: none; text-align: center;">
                    View Product
                  </a>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .dk-carousel-header {
    margin-bottom: var(--dk-space-lg, 1.5rem);
  }
  .dk-carousel-nav {
    display: flex;
    gap: 8px;
  }
  .dk-carousel-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid var(--dk-color-primary, #641A28);
    background-color: transparent;
    color: var(--dk-color-primary, #641A28);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .dk-carousel-btn:hover {
    background-color: var(--dk-color-primary, #641A28);
    color: #FFFFFF;
  }
  .dk-carousel-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .dk-carousel-track {
    display: flex;
    gap: var(--dk-space-lg, 1.5rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 15px;
  }
  .dk-carousel-track::-webkit-scrollbar {
    display: none;
  }
  .dk-carousel-slide {
    flex: 0 0 calc(25% - (var(--dk-space-lg, 1.5rem) * 0.75));
    min-width: 250px;
    scroll-snap-align: start;
  }

  @media (max-width: 1024px) {
    .dk-carousel-slide {
      flex: 0 0 calc(33.333% - (var(--dk-space-md, 1rem) * 0.666));
    }
  }

  @media (max-width: 600px) {
    .dk-carousel-slide {
      flex: 0 0 calc(50% - (var(--dk-space-sm, 0.5rem) * 0.5));
      min-width: 160px;
    }
    .dk-carousel-track {
      gap: var(--dk-space-sm, 0.5rem);
    }
  }
</style>

{% schema %}
{
  "name": "DELISHA Product Carousel",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "JUST ARRIVED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 2,
      "label": "Products to Show",
      "default": 8
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F2E5DD"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "DELISHA Product Carousel"
    }
  ]
}
{% endschema %}
