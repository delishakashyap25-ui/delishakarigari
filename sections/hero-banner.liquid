line-height: 1;
text-transform: uppercase;
}

@media screen and (max-width: 768px) {

.delisha-rakhi-strip {
height: 36px;
}

.delisha-rakhi-content {
gap: 32px;
padding-right: 32px;
}

.delisha-rakhi-content span {
font-size: 9px;
