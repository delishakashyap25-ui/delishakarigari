<section
  id="dk-featured-products-{{ section.id }}"
  class="dk-featured-sec"
  style="background-color: {{ section.settings.bg_color | default: '#F9F5EE' }}; padding: {{ section.settings.padding_top | default: 40 }}px 0 {{ section.settings.padding_bottom | default: 50 }}px 0;"
>
  <div class="dk-featured-container">
    <div class="dk-section-header">
      {%- if section.settings.subheading != blank -%}
        <span class="dk-subtitle">{{ section.settings.subheading | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="dk-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="dk-description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    {%- assign collection = collections[section.settings.collection] -%}
    {%- assign limit = section.settings.products_to_show | default: 10 -%}

    <div class="dk-carousel-wrapper">
      <!-- LEFT ARROW -->
      <button
        type="button"
        class="dk-carousel-arrow dk-carousel-arrow--prev"
        aria-label="Previous Products"
        onclick="dkScrollProducts('{{ section.id }}', -330)"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <!-- TRACK -->
      <div class="dk-carousel-track dk-products-track" id="dk-products-track-{{ section.id }}">
        {%- assign prod_list = collection.products -%}
        {%- if prod_list == blank or prod_list.size == 0 -%}
          {%- assign prod_list = collections.all.products -%}
        {%- endif -%}

        {%- if prod_list != blank and prod_list.size > 0 -%}
          {%- for product in prod_list limit: limit -%}
            <div class="dk-carousel-slide">
              {% render 'product-card', product: product %}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} REAL CATALOG SHOWCASE FALLBACK {%- endcomment -%}
          {%- assign fb_titles = "Mayur Nazar Rakhi Trio|Shree Ganesh Rakhi Trio|Emerald Noor Pearl Lumba Set|Handmade Designer Rakhi Combo|Emerald Pearl Rakhi Lumba Set|Ruby Panna Pearl Lumba Set|Neelam Pearl Bhaiya Bhabhi Set|Shree Gajraj Pearl Rakhi Set" | split: "|" -%}
          {%- assign fb_prices = "₹215.00|₹245.00|₹245.00|₹225.00|₹239.00|₹239.00|₹245.00|₹255.00" | split: "|" -%}
          {%- assign fb_compares = "₹599.00|₹899.00|₹899.00|₹699.00|₹899.00|₹899.00|₹899.00|₹999.00" | split: "|" -%}
          {%- assign fb_imgs = "https://res.cloudinary.com/m5yixuhw/image/upload/v1785441060/029_2_dnfh5b.png|https://res.cloudinary.com/m5yixuhw/image/upload/v1785441061/032_1_i8susx.png|https://res.cloudinary.com/m5yixuhw/image/upload/v1785528491/033_2_ayal4g.png|https://res.cloudinary.com/m5yixuhw/image/upload/v1785441062/030_2_lusm4b.png|https://res.cloudinary.com/m5yixuhw/image/upload/v1785528491/035_2_t01kp7.png|https://res.cloudinary.com/m5yixuhw/image/upload/v1785528493/036_2_i5luyp.png|https://res.cloudinary.com/m5yixuhw/image/upload/v1785528493/037_2_ywd2ch.png|https://res.cloudinary.com/m5yixuhw/image/upload/v1785579167/043_2_mscblx.png" | split: "|" -%}
          {%- assign fb_handles = "mayur-nazar-rakhi-trio|shree-ganesh-rakhi-trio|emerald-noor-pearl-rakhi-lumba-set|handmade-designer-rakhi-combo-set-of-3|emerald-pearl-rakhi-lumba-set|ruby-panna-pearl-lumba-set|neelam-pearl-bhaiya-bhabhi-rakhi-lumba-set|shree-gajraj-pearl-rakhi-lumba-ring-set" | split: "|" -%}

          {%- for i in (0..7) -%}
            {%- assign p_title = fb_titles[i] -%}
            {%- assign p_price = fb_prices[i] -%}
            {%- assign p_compare = fb_compares[i] -%}
            {%- assign p_img = fb_imgs[i] -%}
            {%- assign p_handle = fb_handles[i] -%}

            <div class="dk-carousel-slide">
              <div class="dk-product-card" data-product-handle="{{ p_handle }}">
                <div class="dk-product-card__media">
                  <a href="/products/{{ p_handle }}" class="dk-product-card__image-link" aria-label="{{ p_title | escape }}">
                    <img
                      src="{{ p_img }}"
                      alt="{{ p_title | escape }}"
                      class="dk-product-card__img dk-product-card__img--primary"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  </a>
                  <div class="dk-product-card__badges">
                    <span class="dk-badge dk-badge--sale">BESTSELLER</span>
                  </div>
                  <button
                    type="button"
                    class="dk-product-card__wishlist-btn wishlist-btn"
                    aria-label="Add {{ p_title | escape }} to wishlist"
                    data-product-handle="{{ p_handle }}"
                    onclick="if(typeof window.toggleWishlist === 'function') { window.toggleWishlist('{{ p_handle }}'); }"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                  </button>
                </div>
                <div class="dk-product-card__info">
                  <h3 class="dk-product-card__title">
                    <a href="/products/{{ p_handle }}">{{ p_title }}</a>
                  </h3>
                  <div class="dk-product-card__price">
                    <span class="dk-product-card__price-current">{{ p_price }}</span>
                    <s class="dk-product-card__price-compare">{{ p_compare }}</s>
                  </div>
                  <form method="post" action="/cart/add" class="dk-product-card__form" onsubmit="event.preventDefault(); if(typeof window.dkAddToCart === 'function') { window.dkAddToCart('{{ p_title | escape }}', '{{ p_price }}', '{{ p_img }}'); } else { alert('Added ' + '{{ p_title | escape }}' + ' to bag!'); }">
                    <button type="submit" class="dk-product-card__add-btn" aria-label="Add {{ p_title | escape }} to cart">
                      <span>ADD TO BAG &rarr;</span>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <!-- RIGHT ARROW -->
      <button
        type="button"
        class="dk-carousel-arrow dk-carousel-arrow--next"
        aria-label="Next Products"
        onclick="dkScrollProducts('{{ section.id }}', 330)"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="text-center" style="margin-top: 2rem;">
        <a href="{{ routes.all_products_collection_url }}" class="dk-btn dk-btn-outline" style="padding: 12px 34px; font-size: 0.82rem; letter-spacing: 1.8px;">
          {{ section.settings.view_all_label | default: 'VIEW ALL FAVOURITES' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .dk-featured-sec {
    width: 100%;
    overflow: hidden;
  }
  .dk-featured-container {
    max-width: 1380px;
    margin: 0 auto;
    width: 100%;
    padding: 0 clamp(16px, 2.5vw, 32px);
    box-sizing: border-box;
  }

  /* TIGHTENED HEADER ON THE LEFT */
  .dk-featured-sec .dk-section-header {
    text-align: left;
    margin-bottom: 1.25rem;
  }
  .dk-featured-sec .dk-subtitle {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dk-color-gold, #B89A62);
    display: block;
    margin-bottom: 2px;
    line-height: 1.2;
    text-align: left;
  }
  .dk-featured-sec .dk-heading {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    font-weight: 700;
    color: var(--dk-color-text, #252525);
    margin: 0 0 2px 0;
    line-height: 1.15;
    text-align: left;
    letter-spacing: -0.01em;
  }
  .dk-featured-sec .dk-description {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.95rem;
    color: var(--dk-color-text-muted, #555555);
    margin: 2px 0 0 0;
    line-height: 1.35;
    text-align: left;
    max-width: 700px;
  }

  /* WRAPPER & SIDE ARROWS */
  .dk-carousel-wrapper {
    position: relative;
    width: 100%;
  }

  .dk-carousel-arrow {
    position: absolute;
    top: calc(50% - 24px);
    transform: translateY(-50%);
    z-index: 10;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1.5px solid var(--dk-color-primary, #641A28);
    color: var(--dk-color-primary, #641A28);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.18), 0 2px 8px rgba(100, 26, 40, 0.15);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  .dk-carousel-arrow:hover {
    background: var(--dk-color-primary, #641A28);
    border-color: #B89A62;
    color: #FFFFFF;
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 10px 28px rgba(100, 26, 40, 0.35);
  }
  .dk-carousel-arrow--prev {
    left: -20px;
  }
  .dk-carousel-arrow--next {
    right: -20px;
  }

  /* TRACK & SLIDES — EXPANDED TO FILL GUTTER SPACE */
  .dk-products-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 4px 20px 4px;
    user-select: none;
    width: 100%;
    box-sizing: border-box;
  }
  .dk-products-track::-webkit-scrollbar {
    display: none;
  }
  .dk-products-track .dk-carousel-slide {
    flex: 0 0 calc((100% - 60px) / 4);
    min-width: 290px;
    max-width: 325px;
    scroll-snap-align: start;
    display: flex;
  }

  /* CARD STYLING */
  .dk-featured-sec .dk-product-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background: #FFFFFF;
    border-radius: 8px;
    border: 1px solid rgba(100, 26, 40, 0.12);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-sizing: border-box;
  }
  .dk-featured-sec .dk-product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(100, 26, 40, 0.16);
    border-color: rgba(184, 154, 98, 0.5);
  }
  .dk-featured-sec .dk-product-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #FAF7F2;
  }
  .dk-featured-sec .dk-product-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .dk-featured-sec .dk-product-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transition: transform 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  .dk-featured-sec .dk-product-card:hover .dk-product-card__img {
    transform: scale(1.06);
  }
  .dk-featured-sec .dk-product-card__badges {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
  }
  .dk-featured-sec .dk-product-card__wishlist-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--dk-color-primary, #641A28);
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .dk-featured-sec .dk-product-card__wishlist-btn:hover {
    background: #FFFFFF;
    transform: scale(1.1);
  }
  .dk-featured-sec .dk-product-card__info {
    padding: 14px 16px 18px 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
    text-align: center;
    background: #FFFFFF;
    box-sizing: border-box;
  }
  .dk-featured-sec .dk-product-card__title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 6px 0;
  }
  .dk-featured-sec .dk-product-card__title a {
    color: #252525 !important;
    text-decoration: none !important;
    transition: color 0.25s ease;
  }
  .dk-featured-sec .dk-product-card__title a:hover {
    color: var(--dk-color-primary, #641A28) !important;
  }
  .dk-featured-sec .dk-product-card__price {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 12px;
  }
  .dk-featured-sec .dk-product-card__price-current {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--dk-color-primary, #641A28);
  }
  .dk-featured-sec .dk-product-card__price-compare {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.85rem;
    color: #888888;
    text-decoration: line-through;
  }
  .dk-featured-sec .dk-product-card__add-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 10px 18px;
    background: linear-gradient(135deg, #6E1F2A 0%, #541720 100%);
    color: #FFFFFF !important;
    text-decoration: none !important;
    border: 1.2px solid #B89552;
    border-radius: 4px;
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    box-shadow: 0 4px 12px rgba(110, 31, 42, 0.2);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-sizing: border-box;
  }
  .dk-featured-sec .dk-product-card__add-btn:hover {
    background: var(--dk-color-gold, #B89552);
    border-color: #FFFFFF;
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(184, 149, 82, 0.35);
  }

  @media (max-width: 1200px) {
    .dk-carousel-arrow--prev { left: 4px; }
    .dk-carousel-arrow--next { right: 4px; }
    .dk-products-track .dk-carousel-slide {
      flex: 0 0 280px;
      min-width: 280px;
    }
  }

  @media (max-width: 768px) {
    .dk-carousel-arrow {
      width: 38px;
      height: 38px;
    }
    .dk-products-track .dk-carousel-slide {
      flex: 0 0 240px;
      min-width: 240px;
    }
  }
</style>

<script>
  function dkScrollProducts(sectionId, distance) {
    var track = document.getElementById('dk-products-track-' + sectionId);
    if (track) {
      track.scrollBy({ left: distance, behavior: 'smooth' });
    }
  }

  (function() {
    function initAutoScroll() {
      var track = document.getElementById('dk-products-track-{{ section.id }}');
      if (!track) return;

      var isHovered = false;
      var scrollInterval;

      track.addEventListener('mouseenter', function() { isHovered = true; });
      track.addEventListener('mouseleave', function() { isHovered = false; });
      track.addEventListener('touchstart', function() { isHovered = true; }, { passive: true });
      track.addEventListener('touchend', function() {
        setTimeout(function() { isHovered = false; }, 2500);
      }, { passive: true });

      scrollInterval = setInterval(function() {
        if (!isHovered && track) {
          var step = 374;
          var maxScroll = track.scrollWidth - track.clientWidth;
          if (track.scrollLeft >= maxScroll - 15) {
            track.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            track.scrollBy({ left: step, behavior: 'smooth' });
          }
        }
      }, 3200);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAutoScroll);
    } else {
      initAutoScroll();
    }
  })();
</script>

{% schema %}
{
  "name": "DELISHA Bestsellers Grid",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "HANDCRAFTED TREASURES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Favourites"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Most cherished pieces handcrafted for your celebrations."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "label": "Products to Show",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "VIEW ALL FAVOURITES"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F5EE"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "DELISHA Bestsellers Grid"
    }
  ]
}
{% endschema %}

