{% if total_blocks > 1 or total_blocks == 0 %}
<script>
  (function() {
    const slider = document.getElementById('dkHeroSlider-{{ section.id }}');
    if (!slider) return;

    let currentSlide = 0;
    const slides = slider.querySelectorAll('.dk-hero-slide');
    const dots = slider.querySelectorAll('.dk-hero-dot');
    const totalSlides = slides.length;
    let slideTimer = null;

    function showSlide(index) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      currentSlide = index;

      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === currentSlide);
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === currentSlide);
      });
    }

    window.dkHeroNextSlide = function(sectionId) {
      showSlide(currentSlide + 1);
      resetAutoPlay();
    };

    window.dkHeroPrevSlide = function(sectionId) {
      showSlide(currentSlide - 1);
      resetAutoPlay();
    };

    window.dkHeroGoToSlide = function(sectionId, index) {
      showSlide(index);
      resetAutoPlay();
    };

    function startAutoPlay() {
      slideTimer = setInterval(() => {
        showSlide(currentSlide + 1);
      }, {{ section.settings.autoplay_speed | default: 7500 }});
    }

    function resetAutoPlay() {
      if (slideTimer) clearInterval(slideTimer);
      startAutoPlay();
    }

    startAutoPlay();

    try {
      const urlParams = new URLSearchParams(window.location.search);
      const initialSlide = parseInt(urlParams.get('slide'), 10);
      if (!isNaN(initialSlide) && initialSlide >= 0 && initialSlide < totalSlides) {
        showSlide(initialSlide);
      }
    } catch (e) {}

    slider.addEventListener('mouseenter', () => {
      if (slideTimer) clearInterval(slideTimer);
    });
    slider.addEventListener('mouseleave', () => {
      startAutoPlay();
    });

    let touchStartX = 0;
    let touchEndX = 0;
    slider.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    slider.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 50) {
        window.dkHeroNextSlide('{{ section.id }}');
      } else if (touchEndX - touchStartX > 50) {
        window.dkHeroPrevSlide('{{ section.id }}');
      }
    }, { passive: true });
  })();
</script>
{% endif %}

