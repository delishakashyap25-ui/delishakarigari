{%- assign menu_handle = section.settings.menu | default: 'main-menu' -%}
{%- assign menu_links = linklists[menu_handle].links -%}

<header
  class="dk-header dk-header--sticky"
  id="dkHeader"
  data-section-id="{{ section.id }}"
  role="banner"
>
  {%- comment -%} =====================================================
    TOP ANNOUNCEMENT BAR (BRAND TONE WINE / BURGUNDY ROTATING ONE BY ONE)
  ==================================================== {%- endcomment -%}
  <div class="dk-header__announcement" id="dkAnnouncementBar">
    <div class="dk-header__announcement-slider" id="dkAnnouncementSlider">
      <div class="dk-announcement-slide is-active" data-index="0">
        <span class="dk-announcement-star">✦</span>
        <span class="dk-announcement-text">FREE SHIPPING SITEWIDE</span>
        <span class="dk-announcement-star">✦</span>
      </div>
      <div class="dk-announcement-slide" data-index="1">
        <span class="dk-announcement-star">✦</span>
        <span class="dk-announcement-text">HANDCRAFTED WITH LOVE</span>
        <span class="dk-announcement-star">✦</span>
      </div>
      <div class="dk-announcement-slide" data-index="2">
        <span class="dk-announcement-star">✦</span>
        <span class="dk-announcement-text">EXPRESS DISPATCH ACROSS INDIA</span>
        <span class="dk-announcement-star">✦</span>
      </div>
      <div class="dk-announcement-slide" data-index="3">
        <span class="dk-announcement-star">✦</span>
        <span class="dk-announcement-text">CUSTOMISATION OF PRODUCTS AVAILABLE</span>
        <span class="dk-announcement-star">✦</span>
      </div>
    </div>
  </div>

  {%- comment -%} =====================================================
    TOP HEADER ROW: LOCATION (LEFT) | LOGO (CENTER) | ACTIONS (RIGHT)
  ==================================================== {%- endcomment -%}
  <div class="dk-header__top">
    <div class="dk-header__top-container">
      
      <!-- LEFT AREA (MOBILE MENU TOGGLE + WHERE TO DELIVER LOCATION BUTTON) -->
      <div class="dk-header__left">
        <button
          type="button"
          class="dk-header__toggle"
          id="dkMobileToggle"
          onclick="toggleDkMobileMenu()"
          aria-label="Open Navigation Menu"
          aria-expanded="false"
          aria-controls="dkMobileDrawer"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <!-- WHERE TO DELIVER BUTTON -->
        <button
          type="button"
          class="dk-location-btn"
          id="dkLocationBtn"
          onclick="openDkLocationModal()"
          aria-label="Where to deliver? Check delivery location"
        >
          <span class="dk-location-btn__icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </span>
          <span class="dk-location-btn__text" id="dkLocationBtnText">Where to deliver?</span>
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" class="dk-location-btn__chevron">
            <path d="M1 1L5 5L9 1" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <!-- BRAND LOGO / WORDMARK -->
      <div class="dk-header__logo">
        <a href="{{ routes.root_url }}" class="dk-header__logo-link">
          {%- if section.settings.logo_image != blank -%}
            {%- assign logo_alt = section.settings.logo_image.alt | default: shop.name | escape -%}
            <img
              src="{{ section.settings.logo_image | image_url: width: 600 }}"
              alt="{{ logo_alt }}"
              class="dk-header__logo-img"
              width="{{ section.settings.logo_width | default: 260 }}"
              height="60"
              style="max-width: {{ section.settings.logo_width | default: 260 }}px; height: auto;"
              loading="eager"
            >
          {%- else -%}
            <img
              src="{{ 'dk-logo.png' | asset_url }}"
              alt="{{ shop.name | default: 'DELISHA KARIGARI' | escape }}"
              class="dk-header__logo-img"
              width="{{ section.settings.logo_width | default: 260 }}"
              height="60"
              style="max-width: {{ section.settings.logo_width | default: 260 }}px; height: auto;"
              loading="eager"
            >
          {%- endif -%}
        </a>
      </div>

      <!-- HEADER ACTION ICONS (SEARCH / ACCOUNT / WISHLIST / CART) -->
      <div class="dk-header__actions">
        {%- if section.settings.show_search -%}
          <button
            type="button"
            class="dk-header__icon-btn dk-header__icon-search"
            aria-label="Search"
            onclick="if(typeof openSearchModal === 'function') { openSearchModal(); } else { window.location.href='{{ routes.search_url }}'; }"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="20" y1="20" x2="16" y2="16"></line>
            </svg>
          </button>
        {%- endif -%}

        {%- if section.settings.show_account -%}
          {%- assign account_url = routes.account_url -%}
          {%- assign login_url = routes.account_login_url -%}
          <a
            href="{% if customer != blank %}{{ account_url }}{% else %}{{ login_url }}{% endif %}"
            class="dk-header__icon-btn dk-header__icon-account"
            aria-label="Account"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="4"></circle>
              <path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.show_wishlist -%}
          <a
            href="#"
            class="dk-header__icon-btn dk-header__icon-wishlist"
            id="HeaderWishlistIcon"
            aria-label="Wishlist"
            onclick="if(typeof window.openWishlist === 'function') { window.openWishlist(); return false; }"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <span class="wishlist-count" id="WishlistCount">0</span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_cart -%}
          <a
            href="{{ routes.cart_url }}"
            class="dk-header__icon-btn dk-header__icon-cart"
            id="HeaderCartIcon"
            aria-label="Cart"
            onclick="if(typeof ShopifyCart !== 'undefined' && typeof ShopifyCart.openDrawer === 'function') { ShopifyCart.openDrawer(); return false; }"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span class="cart-count" id="HeaderCartCount">{{ cart.item_count | default: 0 }}</span>
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>

  {%- comment -%} =====================================================
    MOBILE PRECISION DELIVERY LOCATION BAR (MINIMAL, ELEGANT & PRECISE ON MOBILE/IOS)
  ==================================================== {%- endcomment -%}
  <div
    class="dk-header__mobile-location"
    id="dkMobileLocationBar"
    onclick="openDkLocationModal()"
    role="button"
    tabindex="0"
    aria-label="Delivery location: Check delivery details"
  >
    <div class="dk-mobile-location-inner">
      <span class="dk-mobile-location-icon">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
      </span>
      <span class="dk-mobile-location-text">
        <span class="dk-mobile-location-muted">Deliver to:</span>
        <strong class="dk-mobile-location-city" id="dkMobileLocationCity">Bengaluru</strong>
        <span class="dk-mobile-location-pin" id="dkMobileLocationPin">560001</span>
      </span>
      <span class="dk-mobile-location-cta">
        Change
        <svg width="8" height="5" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M1 1L5 5L9 1" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </div>

  {%- comment -%} =====================================================
    DESKTOP CATEGORY NAVIGATION ROW (CLEAN EDITORIAL OFF-WHITE BAR - PHOTO 4)
  ==================================================== {%- endcomment -%}
  <nav class="dk-header__nav" aria-label="Main Navigation">
    <div class="container dk-header__nav-container">
      <ul class="dk-header__menu" role="list">
        {%- if section.settings.use_custom_menu != false -%}
          <!-- 1. ALL COLLECTIONS -->
          <li class="dk-header__menu-item">
            <a href="{{ routes.all_products_collection_url }}" class="dk-header__menu-link {% if request.path == routes.all_products_collection_url %}is-active{% endif %}">
              ALL COLLECTIONS
            </a>
          </li>


          <!-- 3. BANDHANWAR -->
          <li class="dk-header__menu-item">
            <a href="{{ routes.collections_url }}/bandhanwar" class="dk-header__menu-link {% if request.path contains 'bandhanwar' %}is-active{% endif %}">
              BANDHANWAR
            </a>
          </li>

          <!-- 4. LATKANS -->
          <li class="dk-header__menu-item">
            <a href="{{ routes.collections_url }}/latkan" class="dk-header__menu-link {% if request.path contains 'latkan' %}is-active{% endif %}">
              LATKANS
            </a>
          </li>

          <!-- 5. GIFTING -->
          <li class="dk-header__menu-item">
            <a href="{{ routes.collections_url }}/for-her-accessories" class="dk-header__menu-link {% if request.path contains 'gifts' or request.path contains 'for-her-accessories' %}is-active{% endif %}">
              GIFTING
            </a>
          </li>

          <!-- 6. UNDER @199 (HIGHLIGHTED) -->
          <li class="dk-header__menu-item">
            <a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=199" class="dk-header__menu-link dk-header__menu-link--highlight {% if request.path contains 'under-199' %}is-active{% endif %}">
              UNDER @199
            </a>
          </li>

        {%- elsif menu_links != blank -%}
          {%- for link in menu_links -%}
            {%- assign has_dropdown = false -%}
            {%- if link.links != blank -%}
              {%- assign has_dropdown = true -%}
            {%- endif -%}

            {%- assign mega_block = blank -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'mega_menu' and block.settings.menu_item == link.title -%}
                {%- assign mega_block = block -%}
                {%- assign has_dropdown = true -%}
              {%- endif -%}
            {%- endfor -%}

            <li class="dk-header__menu-item {% if has_dropdown %}has-dropdown{% endif %}">
              <a
                href="{{ link.url }}"
                class="dk-header__menu-link {% if link.active %}is-active{% endif %}"
                {% if has_dropdown %}aria-expanded="false" aria-haspopup="true"{% endif %}
              >
                {{ link.title | escape }}
                {%- if has_dropdown -%}
                  <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" class="dk-header__menu-arrow">
                    <path d="M1 1L5 5L9 1" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}
              </a>

              {%- if has_dropdown -%}
                <div class="dk-header__dropdown">
                  {%- if link.links != blank or mega_block != blank -%}
                    {%- render 'mega-menu', link: link, mega_menu_block: mega_block -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="dk-header__menu-item"><a href="{{ routes.root_url }}" class="dk-header__menu-link">HOME</a></li>
          <li class="dk-header__menu-item"><a href="{{ routes.all_products_collection_url }}" class="dk-header__menu-link">SHOP ALL</a></li>
          <li class="dk-header__menu-item"><a href="{{ routes.collections_url }}/diwali-decor" class="dk-header__menu-link">DIWALI EDIT</a></li>
          <li class="dk-header__menu-item"><a href="{{ routes.collections_url }}/bandhanwar" class="dk-header__menu-link">BANDHANWAR</a></li>
          <li class="dk-header__menu-item"><a href="{{ routes.collections_url }}/karwa-chauth-special" class="dk-header__menu-link">KARWA CHAUTH</a></li>
          <li class="dk-header__menu-item"><a href="{{ routes.collections_url }}/gifts" class="dk-header__menu-link">GIFTS</a></li>
        {%- endif -%}
      </ul>
    </div>
  </nav>


  {%- comment -%} =====================================================
    MOBILE SLIDE-OUT DRAWER NAVIGATION
  ==================================================== {%- endcomment -%}
  <div class="dk-mobile-drawer" id="dkMobileDrawer" aria-hidden="true" role="dialog" aria-label="Mobile Navigation">
    <div class="dk-mobile-drawer__header">
      <img
        src="{{ 'dk-logo.png' | asset_url }}"
        alt="{{ shop.name | default: 'DELISHA KARIGARI' | escape }}"
        class="dk-header__logo-img"
        width="{{ section.settings.mobile_logo_width | default: 160 }}"
        height="50"
        style="max-width: {{ section.settings.mobile_logo_width | default: 160 }}px; height: auto;"
        loading="eager"
      >
      <button
        type="button"
        class="dk-mobile-drawer__close"
        onclick="toggleDkMobileMenu()"
        aria-label="Close Navigation Menu"
      >
        &times;
      </button>
    </div>

    <!-- MOBILE SEARCH BAR INTEGRATION -->
    <div class="dk-mobile-drawer__search">
      <form action="{{ routes.search_url }}" method="get" role="search" class="dk-mobile-search-form">
        <input type="hidden" name="type" value="product">
        <input
          type="search"
          name="q"
          placeholder="Search Diwali Decor, Bandhanwars, Gifts..."
          class="dk-mobile-search-input"
          aria-label="Search Store"
        >
        <button type="submit" class="dk-mobile-search-btn" aria-label="Submit Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="20" y1="20" x2="16" y2="16"></line>
          </svg>
        </button>
      </form>
    </div>

    <div class="dk-mobile-drawer__body">
      <ul class="dk-mobile-menu" role="list">
        {%- if section.settings.use_custom_menu != false -%}
          <!-- 1. ALL COLLECTIONS -->
          <li class="dk-mobile-menu__item">
            <div class="dk-mobile-menu__row">
              <a href="{{ routes.all_products_collection_url }}" class="dk-mobile-menu__link">
                ALL COLLECTIONS
              </a>
            </div>
          </li>


          <!-- 3. BANDHANWAR -->
          <li class="dk-mobile-menu__item">
            <div class="dk-mobile-menu__row">
              <a href="{{ routes.collections_url }}/bandhanwar" class="dk-mobile-menu__link">
                BANDHANWAR
              </a>
            </div>
          </li>

          <!-- 4. LATKANS -->
          <li class="dk-mobile-menu__item">
            <div class="dk-mobile-menu__row">
              <a href="{{ routes.collections_url }}/latkan" class="dk-mobile-menu__link">
                LATKANS
              </a>
            </div>
          </li>

          <!-- 5. GIFTING -->
          <li class="dk-mobile-menu__item">
            <div class="dk-mobile-menu__row">
              <a href="{{ routes.collections_url }}/for-her-accessories" class="dk-mobile-menu__link">
                GIFTING
              </a>
            </div>
          </li>

          <!-- 6. UNDER @199 (HIGHLIGHTED) -->
          <li class="dk-mobile-menu__item">
            <div class="dk-mobile-menu__row">
              <a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=199" class="dk-mobile-menu__link dk-mobile-menu__link--highlight">
                UNDER @199
              </a>
            </div>
          </li>

        {%- elsif menu_links != blank -%}
          {%- for link in menu_links -%}
            <li class="dk-mobile-menu__item {% if link.links != blank %}has-accordion{% endif %}">
              <div class="dk-mobile-menu__row">
                <a href="{{ link.url }}" class="dk-mobile-menu__link">
                  {{ link.title | escape }}
                </a>
                {%- if link.links != blank -%}
                  <button
                    type="button"
                    class="dk-mobile-menu__accordion-toggle"
                    aria-label="Toggle {{ link.title }} Submenu"
                    onclick="toggleDkAccordion(this)"
                  >
                    <svg width="12" height="8" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M1 1L5 5L9 1" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                {%- endif -%}
              </div>

              {%- if link.links != blank -%}
                <ul class="dk-mobile-submenu" role="list" style="display: none;">
                  {%- for childlink in link.links -%}
                    <li class="dk-mobile-submenu__item {% if childlink.links != blank %}has-nested{% endif %}">
                      <div class="dk-mobile-submenu__row">
                        <a href="{{ childlink.url }}" class="dk-mobile-submenu__link">
                          {{ childlink.title | escape }}
                        </a>
                        {%- if childlink.links != blank -%}
                          <button
                            type="button"
                            class="dk-mobile-menu__accordion-toggle"
                            aria-label="Toggle {{ childlink.title }} Submenu"
                            onclick="toggleDkAccordion(this)"
                          >
                            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8">
                              <path d="M1 1L5 5L9 1" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </button>
                        {%- endif -%}
                      </div>

                      {%- if childlink.links != blank -%}
                        <ul class="dk-mobile-grandchild-menu" role="list" style="display: none;">
                          {%- for grandchild in childlink.links -%}
                            <li>
                              <a href="{{ grandchild.url }}" class="dk-mobile-grandchild-link">
                                {{ grandchild.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="dk-mobile-menu__item"><a href="{{ routes.root_url }}" class="dk-mobile-menu__link">HOME</a></li>
          <li class="dk-mobile-menu__item"><a href="{{ routes.all_products_collection_url }}" class="dk-mobile-menu__link">SHOP ALL</a></li>
          <li class="dk-mobile-menu__item"><a href="{{ routes.collections_url }}" class="dk-mobile-menu__link">CATALOGUE</a></li>
          <li class="dk-mobile-menu__item"><a href="{{ routes.collections_url }}/under-199" class="dk-mobile-menu__link dk-menu-highlight">UNDER @199 <span class="dk-menu-badge">OFFER</span></a></li>
        {%- endif -%}
      </ul>
    </div>
  </div>

  <div class="dk-mobile-overlay" id="dkMobileOverlay" onclick="toggleDkMobileMenu()"></div>

  {%- comment -%} =====================================================
    DELIVERY LOCATION CHECKER MODAL
  ==================================================== {%- endcomment -%}
  <div class="dk-location-modal" id="dkLocationModal" aria-hidden="true" role="dialog" aria-label="Select Delivery Location">
    <div class="dk-location-modal__backdrop" onclick="closeDkLocationModal()"></div>
    <div class="dk-location-modal__dialog">
      <div class="dk-location-modal__header">
        <div class="dk-location-modal__title-wrap">
          <span class="dk-location-modal__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </span>
          <div>
            <h3 class="dk-location-modal__title">Where to deliver?</h3>
            <p class="dk-location-modal__subtitle">Check serviceability & delivery dates across India</p>
          </div>
        </div>
        <button type="button" class="dk-location-modal__close" onclick="closeDkLocationModal()" aria-label="Close modal">&times;</button>
      </div>

      <div class="dk-location-modal__body">
        <div class="dk-location-input-group">
          <div class="dk-location-input-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--dk-color-primary, #641A28)" stroke-width="2" class="dk-location-field-icon">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <input
              type="text"
              id="dkPincodeInput"
              class="dk-location-input"
              maxlength="6"
              inputmode="numeric"
              pattern="[0-9]{6}"
              placeholder="Enter 6-digit Pincode (e.g. 110001)"
              onkeydown="if(event.key === 'Enter') { event.preventDefault(); dkCheckPincode(); }"
            >
          </div>
          <button type="button" class="dk-location-check-btn" onclick="dkCheckPincode()">
            CHECK
          </button>
        </div>

        <div id="dkPincodeFeedback" class="dk-location-feedback" style="display: none;"></div>

        <div class="dk-location-quick-cities">
          <span class="dk-location-quick-label">Popular Deliverable Regions:</span>
          <div class="dk-location-city-chips">
            <button type="button" class="dk-city-chip" onclick="dkSelectCity('Delhi NCR', '110001')">📍 Delhi NCR</button>
            <button type="button" class="dk-city-chip" onclick="dkSelectCity('Mumbai', '400001')">📍 Mumbai</button>
            <button type="button" class="dk-city-chip" onclick="dkSelectCity('Bengaluru', '560001')">📍 Bengaluru</button>
            <button type="button" class="dk-city-chip" onclick="dkSelectCity('Kolkata', '700001')">📍 Kolkata</button>
            <button type="button" class="dk-city-chip" onclick="dkSelectCity('Hyderabad', '500001')">📍 Hyderabad</button>
            <button type="button" class="dk-city-chip" onclick="dkSelectCity('Chennai', '600001')">📍 Chennai</button>
            <button type="button" class="dk-city-chip" onclick="dkSelectCity('Pune', '411001')">📍 Pune</button>
            <button type="button" class="dk-city-chip" onclick="dkSelectCity('Jaipur', '302001')">📍 Jaipur</button>
          </div>
        </div>

        <div class="dk-location-features">
          <div class="dk-location-feature-item">
            <span class="dk-location-feature-dot">✦</span>
